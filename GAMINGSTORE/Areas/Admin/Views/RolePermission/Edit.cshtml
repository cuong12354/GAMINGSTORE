@model GAMINGSTORE.Areas.Admin.Controllers.RolePermissionEditModel

@{
    ViewData["Title"] = "Chỉnh sửa quyền role";
}

<div class="admin-page-header mb-4">
    <div>
        <h1 class="h3">@ViewData["Title"]</h1>
        <p class="text-muted">Chọn quyền cần gán cho role và lưu lại cấu hình.</p>
    </div>
</div>

<form asp-action="Edit" method="post" class="card shadow-sm border-0 p-4">
    <input asp-for="RoleId" type="hidden" />

    <div class="mb-4">
        <label class="form-label fw-bold">Role</label>
        <input class="form-control form-control-lg" value="@Model.RoleName" disabled />
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold">Quyền</label>
        <div class="row g-3">
            @for (int i = 0; i < Model.Permissions.Count; i++)
            {
                <div class="col-sm-6">
                    <div class="form-check form-switch bg-light rounded-3 p-3">
                        <input class="form-check-input" type="checkbox" id="permission_@i" name="SelectedPermissions" value="@Model.Permissions[i].Permission" @(Model.Permissions[i].Assigned ? "checked" : "") />
                        <label class="form-check-label fw-semibold" for="permission_@i">
                            @Model.Permissions[i].Description
                        </label>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-success btn-lg">Lưu thay đổi</button>
        <a asp-action="Index" asp-area="Admin" class="btn btn-outline-secondary btn-lg">Quay lại</a>
    </div>
</form>
