@using System.Linq
@model List<GAMINGSTORE.Areas.Admin.Controllers.RolePermissionOverviewModel>

@{
    ViewData["Title"] = "Quản lý quyền role";
}

<div class="admin-page-header mb-4">
    <div>
        <h1 class="h3">@ViewData["Title"]</h1>
        <p class="text-muted">Quản lý quyền truy cập cho mỗi role của hệ thống.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success rounded-3 shadow-sm">@TempData["Success"]</div>
}

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div>
                            <h2 class="h5 mb-1">@item.RoleName</h2>
                            <p class="text-muted mb-0">@item.PermissionCount quyền đã gán</p>
                        </div>
                        <span class="badge bg-primary align-self-start">@item.PermissionCount</span>
                    </div>

                    <div class="mb-3">
                        <strong>Quyền hiện có</strong>
                        <div class="small text-truncate" title="@string.Join(", ", item.Permissions)">
                            @if (item.Permissions.Any())
                            {
                                @string.Join(", ", item.Permissions.Take(5))@((item.Permissions.Count() > 5) ? "..." : "")
                            }
                            else
                            {
                                <span class="text-muted">Chưa có quyền nào</span>
                            }
                        </div>
                    </div>

                    <div class="mt-auto">
                        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Edit", "RolePermission", new { area = "Admin", id = item.RoleId })">
                            Chỉnh sửa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
