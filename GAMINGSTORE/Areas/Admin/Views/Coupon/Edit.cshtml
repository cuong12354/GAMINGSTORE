@using GAMINGSTORE.Models
@model Coupon

@{
    ViewData["Title"] = "Chỉnh Sửa Mã Giảm Giá";
}

<style>
    .form-container {
        padding: 30px;
        max-width: 600px;
        margin: 0 auto;
    }
    .form-header {
        margin-bottom: 30px;
    }
    .form-header h1 {
        font-size: 28px;
        font-weight: 900;
        color: #1f2937;
        margin: 0 0 10px 0;
    }
    .form-header p {
        color: #6b7280;
        margin: 0;
    }
    .form-group {
        margin-bottom: 24px;
    }
    .form-label {
        display: block;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 8px;
        font-size: 14px;
    }
    .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit;
        transition: all 0.2s;
    }
    .form-control:focus {
        outline: none;
        border-color: #d92e2e;
        box-shadow: 0 0 0 3px rgba(217, 46, 46, 0.1);
    }
    .form-control:disabled {
        background: #f3f4f6;
        cursor: not-allowed;
    }
    .form-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }
    .form-check input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #d92e2e;
    }
    .form-check label {
        cursor: pointer;
        font-weight: 500;
        margin: 0;
    }
    .form-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }
    .section-title {
        font-weight: 900;
        color: #1f2937;
        margin: 0 0 16px 0;
        font-size: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f0f0;
    }
    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .textarea {
        resize: vertical;
        min-height: 100px;
    }
    .help-text {
        display: block;
        font-size: 12px;
        color: #6b7280;
        margin-top: 4px;
    }
    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: space-between;
        margin-top: 30px;
    }
    .btn-primary {
        background: linear-gradient(135deg, #d92e2e 0%, #b82222 100%);
        color: white;
        padding: 12px 32px;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
    }
    .btn-primary:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 12px rgba(217, 46, 46, 0.3);
    }
    .btn-secondary {
        background: white;
        border: 1px solid #e5e7eb;
        color: #1f2937;
        padding: 12px 32px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }
    .btn-secondary:hover {
        border-color: #d92e2e;
        color: #d92e2e;
    }
    .btn-delete {
        background: #fee;
        border: 1px solid #fca5a5;
        color: #dc2626;
        padding: 12px 32px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.2s;
    }
    .btn-delete:hover {
        background: #fca5a5;
        border-color: #dc2626;
    }
    .input-addon {
        display: flex;
        align-items: center;
        gap: 0;
    }
    .input-addon .form-control {
        flex: 1;
        border-radius: 8px 0 0 8px;
        margin-bottom: 0;
    }
    .addon-unit {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-left: none;
        border-radius: 0 8px 8px 0;
        font-weight: 700;
        color: #6b7280;
        font-size: 13px;
    }
    .info-box {
        background: #fef3c7;
        border: 1px solid #fbbf24;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 16px;
        color: #78350f;
        font-size: 13px;
    }
    .usage-stats {
        background: #dbeafe;
        border: 1px solid #93c5fd;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 16px;
        color: #1e40af;
        font-size: 13px;
    }
</style>

<div class="form-container">
    <div class="form-header">
        <h1>✏️ Chỉnh Sửa Mã Giảm Giá</h1>
        <p>Cập nhật thông tin cho mã: <strong>@Model.Code</strong></p>
    </div>

    <form method="post" action="@Url.Action("Edit", "Coupon", new { area = "Admin", id = Model.Id })">
        <input type="hidden" asp-for="Id" />

        <!-- Basic Information -->
        <div class="form-section">
            <h3 class="section-title">💳 Thông Tin Cơ Bản</h3>

            <div class="form-group">
                <label class="form-label">Mã Coupon</label>
                <input type="text" asp-for="Code" class="form-control" disabled>
                <span class="help-text">Mã không thể chỉnh sửa sau khi tạo</span>
            </div>

            <div class="form-group">
                <label class="form-label">Mô Tả</label>
                <textarea asp-for="Description" class="form-control textarea" placeholder="Ví dụ: Giảm 50% toàn bộ sản phẩm trong mùa hè"></textarea>
                <span class="help-text">Mô tả ngắn về mã giảm giá (tùy chọn)</span>
            </div>
        </div>

        <!-- Usage Statistics -->
        @{
            var usagePercentage = Model.MaxUsageCount > 0 ? (Model.CurrentUsageCount * 100 / Model.MaxUsageCount) : 0;
        }
        <div class="form-section">
            <div class="usage-stats">
                📊 <strong>Lượt sử dụng:</strong> @Model.CurrentUsageCount / @Model.MaxUsageCount lần
                <div style="margin-top: 8px; background: white; height: 8px; border-radius: 4px; overflow: hidden;">
                    <div style="height: 100%; background: linear-gradient(90deg, #d92e2e 0%, #b82222 100%); width: @usagePercentage%;"></div>
                </div>
            </div>
        </div>

        <!-- Discount Configuration -->
        <div class="form-section">
            <h3 class="section-title">💰 Cấu Hình Giảm Giá</h3>

            <div class="info-box">
                ℹ️ Loại giảm giá: @(Model.DiscountPercent > 0 ? "Theo phần trăm (" + Model.DiscountPercent + "%)" : (Model.DiscountAmount > 0 ? "Số tiền cố định (" + Model.DiscountAmount.ToString("C") + ")" : "Chưa cấu hình"))
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input type="radio" id="discountPercent" name="discountType" value="percent" 
                           @(Model.DiscountPercent > 0 ? "checked" : "") onchange="toggleDiscountType()">
                    <label for="discountPercent">Giảm Theo Phần Trăm (%)</label>
                </div>
                <div style="padding-left: 26px;">
                    <input type="number" asp-for="DiscountPercent" class="form-control" 
                           placeholder="Ví dụ: 50" min="1" max="100">
                    <span class="help-text">Nhập số phần trăm (1-100%)</span>
                </div>
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input type="radio" id="discountAmount" name="discountType" value="amount" 
                           @(Model.DiscountAmount > 0 ? "checked" : "") onchange="toggleDiscountType()">
                    <label for="discountAmount">Giảm Số Tiền Cố Định</label>
                </div>
                <div style="padding-left: 26px;">
                    <input type="number" asp-for="DiscountAmount" class="form-control" 
                           placeholder="Ví dụ: 100000" min="1000" step="1000">
                    <span class="help-text">Nhập số tiền VNĐ</span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Giá Trị Đơn Hàng Tối Thiểu</label>
                <div class="input-addon">
                    <input type="number" asp-for="MinimumOrderValue" class="form-control" 
                           placeholder="Ví dụ: 500000" min="0" step="10000">
                    <div class="addon-unit">VNĐ</div>
                </div>
                <span class="help-text">Giá trị đơn hàng tối thiểu để dùng mã này (0 = không yêu cầu)</span>
            </div>
        </div>

        <!-- Usage Limits -->
        <div class="form-section">
            <h3 class="section-title">🎟️ Giới Hạn Sử Dụng</h3>

            <div class="form-group">
                <label class="form-label">Tổng Số Lần Sử Dụng Tối Đa</label>
                <input type="number" asp-for="MaxUsageCount" class="form-control" 
                       placeholder="Ví dụ: 100" min="1">
                <span class="help-text">Tổng lần có thể dùng mã này</span>
            </div>
        </div>

        <!-- Date Range -->
        <div class="form-section">
            <h3 class="section-title">📅 Thời Gian Hiệu Lực</h3>

            <div class="two-col">
                <div class="form-group">
                    <label class="form-label">Ngày Bắt Đầu</label>
                    <input type="datetime-local" asp-for="StartDate" class="form-control">
                    <span class="help-text">Ngày mã bắt đầu hoạt động</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Ngày Kết Thúc</label>
                    <input type="datetime-local" asp-for="ExpiryDate" class="form-control">
                    <span class="help-text">Ngày mã hết hiệu lực</span>
                </div>
            </div>
        </div>

        <!-- Status -->
        <div class="form-section">
            <h3 class="section-title">✅ Trạng Thái</h3>

            <div class="form-check">
                <input type="checkbox" id="isActive" asp-for="IsActive">
                <label for="isActive">Kích Hoạt Mã Này</label>
            </div>
            <span class="help-text">Nếu chưa tích, mã sẽ ở trạng thái vô hiệu</span>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <div style="display: flex; gap: 12px;">
                <a href="@Url.Action("Index", "Coupon", new { area = "Admin" })" class="btn-secondary">
                    ← Hủy
                </a>
                <button type="submit" class="btn-primary">
                    ✅ Lưu Thay Đổi
                </button>
            </div>
            <form method="post" action="@Url.Action("Delete", "Coupon", new { area = "Admin" })" style="display: inline;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-delete" onclick="return confirm('Xác nhận xóa mã: @Model.Code?')">
                    🗑️ Xóa Mã
                </button>
            </form>
        </div>
    </form>
</div>

<script>
    function toggleDiscountType() {
        // Enable/disable based on radio selection
        const percentRadio = document.getElementById('discountPercent');
        // Just for UI update - form will handle validation
    }
</script>
