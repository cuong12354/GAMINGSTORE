@{
    ViewData["Title"] = "Chi Tiết Hội Viên";
    var user = ViewBag.User as GAMINGSTORE.Models.ApplicationUser;
    var loyaltyPoints = ViewBag.LoyaltyPoints as List<GAMINGSTORE.Models.LoyaltyPoint>;
    var currentTier = ViewBag.CurrentTier as GAMINGSTORE.Models.MemberTier;
    var orders = ViewBag.Orders as List<GAMINGSTORE.Models.Order>;
}

<style>
    .details-container {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .details-header {
        background: linear-gradient(135deg, #d92e2e 0%, #b82222 100%);
        color: white;
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 30px;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 24px;
        align-items: center;
    }

    .member-avatar-large {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 700;
    }

    .member-info h1 {
        margin: 0 0 8px 0;
        font-size: 28px;
        font-weight: 950;
    }

    .member-info p {
        margin: 4px 0;
        opacity: 0.9;
        font-size: 14px;
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px;
    }

    .card-title {
        font-size: 18px;
        font-weight: 900;
        color: #1f2937;
        margin: 0 0 20px 0;
        padding-bottom: 16px;
        border-bottom: 2px solid #f0f0f0;
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .stat-row:last-child {
        border-bottom: none;
    }

    .stat-label {
        color: #6b7280;
        font-weight: 700;
        font-size: 13px;
    }

    .stat-value {
        color: #1f2937;
        font-weight: 950;
        font-size: 16px;
    }

    .tier-display {
        background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
        color: #333;
        padding: 16px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 16px;
    }

    .tier-icon {
        font-size: 32px;
        margin-bottom: 8px;
    }

    .tier-name {
        font-size: 18px;
        font-weight: 950;
    }

    .tier-discount {
        font-size: 12px;
        opacity: 0.8;
        margin-top: 4px;
    }

    .points-progress {
        margin-bottom: 16px;
    }

    .progress-bar {
        width: 100%;
        height: 8px;
        background: #e5e7eb;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #d92e2e, #ff6b4a);
        border-radius: 4px;
    }

    .progress-text {
        font-size: 12px;
        color: #6b7280;
        font-weight: 700;
    }

    .adjust-form {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        margin-top: 16px;
    }

    .form-group {
        margin-bottom: 12px;
    }

    .form-group:last-child {
        margin-bottom: 0;
    }

    .form-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .form-input {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        font-size: 14px;
    }

    .form-input:focus {
        outline: none;
        border-color: #d92e2e;
        box-shadow: 0 0 0 3px rgba(217, 46, 46, 0.1);
    }

    .btn {
        padding: 10px 16px;
        border-radius: 8px;
        border: none;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-primary {
        background: #d92e2e;
        color: white;
    }

    .btn-primary:hover {
        background: #b82222;
    }

    .btn-secondary {
        background: #f3f4f6;
        color: #1f2937;
        border: 1px solid #e5e7eb;
    }

    .btn-secondary:hover {
        background: #e5e7eb;
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    table thead {
        background: #f3f4f6;
    }

    table th {
        padding: 12px;
        text-align: left;
        font-weight: 700;
        color: #1f2937;
        border-bottom: 2px solid #e5e7eb;
    }

    table td {
        padding: 12px;
        border-bottom: 1px solid #e5e7eb;
        color: #4b5563;
    }

    table tbody tr:hover {
        background: #f9fafb;
    }

    .transaction-type {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .type-purchase { background: #dcfce7; color: #166534; }
    .type-redemption { background: #fee2e2; color: #991b1b; }
    .type-bonus { background: #fef3c7; color: #92400e; }
    .type-adjustment { background: #e0e7ff; color: #3730a3; }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #9ca3af;
    }

    @@media (max-width: 768px) {
        .details-container {
            padding: 16px;
        }

        .details-header {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .two-col {
            grid-template-columns: 1fr;
        }

        .member-avatar-large {
            width: 80px;
            height: 80px;
            font-size: 36px;
        }
    }
</style>

<div class="details-container">
    <!-- Header -->
    <div class="details-header">
        <div class="member-avatar-large">@user?.FullName?.First()</div>
        <div class="member-info">
            <h1>@user?.FullName</h1>
            <p>📧 @user?.Email</p>
            <p>📱 @user?.PhoneNumber</p>
            <p>📅 Tham gia: @user?.CreatedDate.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="two-col">
        <!-- Left Column: Loyalty Info -->
        <div>
            <!-- Current Tier -->
            <div class="card">
                <h3 class="card-title">🏅 Hạng Thành Viên Hiện Tại</h3>
                @if (currentTier != null)
                {
                    <div class="tier-display">
                        <div class="tier-icon">
                            @{
                                var tierIcon = currentTier.Color?.ToLower() switch
                                {
                                    "platinum" => "💎",
                                    "gold" => "🥇",
                                    "silver" => "🥈",
                                    _ => "🥉"
                                };
                            }
                            @tierIcon
                        </div>
                        <div class="tier-name">@currentTier.Name</div>
                        <div class="tier-discount">Giảm giá: @currentTier.DiscountPercentage%</div>
                    </div>
                }

                <!-- Points Progress -->
                <div class="points-progress">
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(Math.Min((ViewBag.TotalPoints ?? 0) / 150, 100))%"></div>
                    </div>
                    <div class="progress-text">
                        @(ViewBag.TotalPoints ?? 0) / 15000 điểm
                    </div>
                </div>

                <!-- Adjust Points Form -->
                <div class="adjust-form">
                    <h4 style="margin: 0 0 12px 0; font-size: 14px; font-weight: 900; color: #1f2937;">Điều Chỉnh Điểm</h4>
                    <div class="form-group">
                        <label class="form-label">Số Điểm</label>
                        <input type="number" id="adjustPoints" class="form-input" placeholder="Nhập số điểm (âm để trừ)">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Lý Do</label>
                        <input type="text" id="adjustReason" class="form-input" placeholder="Nhập lý do điều chỉnh">
                    </div>
                    <button class="btn btn-primary" style="width: 100%; margin-top: 12px;" onclick="adjustPoints('@user?.Id')">
                        Cập Nhật Điểm
                    </button>
                </div>
            </div>

            <!-- Statistics -->
            <div class="card" style="margin-top: 20px;">
                <h3 class="card-title">📊 Thống Kê</h3>
                <div class="stat-row">
                    <span class="stat-label">Tổng Đơn Hàng</span>
                    <span class="stat-value">@(ViewBag.TotalOrders ?? 0)</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Tổng Chi Tiêu</span>
                    <span class="stat-value">@((ViewBag.TotalSpent ?? 0m).ToString("C0", new System.Globalization.CultureInfo("vi-VN")))</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">Điểm Hiện Tại</span>
                    <span class="stat-value">@(ViewBag.TotalPoints ?? 0)</span>
                </div>
            </div>
        </div>

        <!-- Right Column: History & Orders -->
        <div>
            <!-- Recent Orders -->
            <div class="card">
                <h3 class="card-title">📦 Đơn Hàng Gần Đây</h3>
                @if (orders != null && orders.Count > 0)
                {
                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>Mã Đơn</th>
                                    <th>Ngày</th>
                                    <th>Tổng Tiền</th>
                                    <th>Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in orders.Take(5))
                                {
                                    <tr>
                                        <td><strong>#@order.Id</strong></td>
                                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                        <td>@order.TotalPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
                                        <td>
                                            <span style="padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; background: #dcfce7; color: #166534;">
                                                @order.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div style="font-size: 32px; margin-bottom: 8px;">📭</div>
                        <div>Chưa có đơn hàng</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Loyalty Points History -->
    <div class="card" style="margin-bottom: 30px;">
        <h3 class="card-title">💰 Lịch Sử Điểm Thưởng</h3>
        @if (loyaltyPoints != null && loyaltyPoints.Count > 0)
        {
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Loại Giao Dịch</th>
                            <th>Điểm</th>
                            <th>Mô Tả</th>
                            <th>Hạn Sử Dụng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in loyaltyPoints.OrderByDescending(p => p.CreatedDate))
                        {
                            var typeClass = point.TransactionType?.ToLower() switch
                            {
                                "purchase" => "type-purchase",
                                "redemption" => "type-redemption",
                                "bonus" => "type-bonus",
                                "adjustment" => "type-adjustment",
                                _ => "type-purchase"
                            };

                            <tr>
                                <td>@point.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="transaction-type @typeClass">@point.TransactionType</span>
                                </td>
                                <td><strong>@point.Points</strong></td>
                                <td>@point.Description</td>
                                <td>
                                    @if (point.ExpiryDate.HasValue)
                                    {
                                        @point.ExpiryDate.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span style="color: #6b7280;">Không hạn</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div style="font-size: 32px; margin-bottom: 8px;">📭</div>
                <div>Chưa có lịch sử điểm thưởng</div>
            </div>
        }
    </div>

    <!-- Action Buttons -->
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="@Url.Action("Members", "Loyalty", new { area = "Admin" })" class="btn btn-secondary">
            ← Quay Lại Danh Sách Hội Viên
        </a>
        <a href="@Url.Action("Tiers", "Loyalty", new { area = "Admin" })" class="btn btn-secondary">
            ← Quay Lại Hạng Thành Viên
        </a>
        <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="btn btn-secondary">
            ← Quay Lại Dashboard
        </a>
    </div>
</div>

<script>
    async function adjustPoints(userId) {
        const points = parseInt(document.getElementById('adjustPoints').value);
        const reason = document.getElementById('adjustReason').value;

        if (isNaN(points)) {
            alert('Vui lòng nhập số điểm hợp lệ');
            return;
        }

        if (!reason.trim()) {
            alert('Vui lòng nhập lý do điều chỉnh');
            return;
        }

        try {
            const response = await fetch('@Url.Action("AdjustPoints", "Loyalty", new { area = "Admin" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `userId=${userId}&points=${points}&reason=${encodeURIComponent(reason)}`
            });

            const result = await response.json();
            if (result.success) {
                alert('✅ ' + result.message);
                location.reload();
            } else {
                alert('❌ ' + result.message);
            }
        } catch (error) {
            alert('Lỗi: ' + error.message);
        }
    }
</script>

