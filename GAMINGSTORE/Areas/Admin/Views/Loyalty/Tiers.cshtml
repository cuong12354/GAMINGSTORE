@model List<GAMINGSTORE.Models.MemberTier>

@{
    ViewData["Title"] = "Quản Lý Hạng Thành Viên";
}

<style>
    .loyalty-container {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .loyalty-header {
        margin-bottom: 30px;
    }

    .loyalty-header h1 {
        font-size: 28px;
        font-weight: 900;
        color: #1f2937;
        margin: 0;
    }

    .tiers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .tier-card {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .tier-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--tier-color), rgba(var(--tier-rgb), 0.3));
    }

    .tier-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.15);
        border-color: var(--tier-color);
    }

    .tier-icon {
        font-size: 48px;
        margin-bottom: 12px;
    }

    .tier-name {
        font-size: 22px;
        font-weight: 950;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .tier-description {
        color: #6b7280;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 16px;
    }

    .tier-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e5e7eb;
    }

    .tier-stat {
        text-align: center;
    }

    .tier-stat-label {
        font-size: 11px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .tier-stat-value {
        font-size: 18px;
        font-weight: 950;
        color: var(--tier-color);
    }

    .tier-discount {
        background: rgba(var(--tier-rgb), 0.1);
        padding: 12px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 16px;
    }

    .tier-discount-label {
        font-size: 11px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
    }

    .tier-discount-value {
        font-size: 24px;
        font-weight: 950;
        color: var(--tier-color);
    }

    .tier-action {
        display: flex;
        gap: 8px;
    }

    .tier-btn {
        flex: 1;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: white;
        color: #1f2937;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        text-align: center;
    }

    .tier-btn:hover {
        background: var(--tier-color);
        color: white;
        border-color: var(--tier-color);
    }

    .tier-btn-primary {
        background: var(--tier-color);
        color: white;
        border-color: var(--tier-color);
    }

    .tier-btn-primary:hover {
        opacity: 0.9;
    }

    .tier-bronze { --tier-color: #cd7f32; --tier-rgb: 205, 127, 50; }
    .tier-silver { --tier-color: #c0c0c0; --tier-rgb: 192, 192, 192; }
    .tier-gold { --tier-color: #ffd700; --tier-rgb: 255, 215, 0; }
    .tier-platinum { --tier-color: #e5e4e2; --tier-rgb: 229, 228, 226; }

    .quick-links {
        display: flex;
        gap: 12px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .quick-link {
        padding: 10px 16px;
        border-radius: 8px;
        background: #f3f4f6;
        color: #1f2937;
        text-decoration: none;
        font-weight: 700;
        font-size: 13px;
        transition: all 0.2s;
        border: 1px solid #e5e7eb;
    }

    .quick-link:hover {
        background: #d92e2e;
        color: white;
        border-color: #d92e2e;
    }

    .stats-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 30px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .stat-card {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        text-align: center;
    }

    .stat-label {
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 950;
        color: #1f2937;
    }

    @@media (max-width: 768px) {
        .loyalty-container {
            padding: 16px;
        }

        .tiers-grid {
            grid-template-columns: 1fr;
        }

        .loyalty-header h1 {
            font-size: 22px;
        }
    }
</style>

<div class="loyalty-container">
    <div class="loyalty-header">
        <h1>🏅 Quản Lý Hạng Thành Viên</h1>
    </div>

    <!-- Quick Links -->
    <div class="quick-links">
        <a href="@Url.Action("Members", "Loyalty", new { area = "Admin" })" class="quick-link">
            👥 Xem Tất Cả Hội Viên
        </a>
        <a href="@Url.Action("Report", "Loyalty", new { area = "Admin" })" class="quick-link">
            📊 Báo Cáo Hạng Thành Viên
        </a>
        <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="quick-link">
            ← Quay Lại Dashboard
        </a>
    </div>

    <!-- Tier Cards -->
    <div class="tiers-grid">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var tier in Model.OrderBy(t => t.MinPoints))
            {
                var tierClass = tier.Color?.ToLower() ?? "bronze";
                var tierIcon = tier.Color?.ToLower() switch
                {
                    "bronze" => "🥉",
                    "silver" => "🥈",
                    "gold" => "🥇",
                    "platinum" => "💎",
                    _ => "🏅"
                };

                <div class="tier-card tier-@tierClass">
                    <div class="tier-icon">@tierIcon</div>
                    <div class="tier-name">@tier.Name</div>
                    <div class="tier-description">@tier.Description</div>

                    <div class="tier-stats">
                        <div class="tier-stat">
                            <div class="tier-stat-label">Điểm Tối Thiểu</div>
                            <div class="tier-stat-value">@tier.MinPoints</div>
                        </div>
                        <div class="tier-stat">
                            <div class="tier-stat-label">Điểm Tối Đa</div>
                            <div class="tier-stat-value">@tier.MaxPoints</div>
                        </div>
                    </div>

                    <div class="tier-discount">
                        <div class="tier-discount-label">Ưu Đãi Giảm Giá</div>
                        <div class="tier-discount-value">@tier.DiscountPercentage%</div>
                    </div>

                    <div class="tier-action">
                        <a href="@Url.Action("TierDetails", "Loyalty", new { area = "Admin", id = tier.Id })" class="tier-btn tier-btn-primary">
                            Xem Chi Tiết
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #9ca3af;">
                <div style="font-size: 48px; margin-bottom: 12px;">📭</div>
                <div style="font-size: 16px; font-weight: 700;">Chưa có hạng thành viên</div>
            </div>
        }
    </div>

    <!-- Statistics Section -->
    <div class="stats-section">
        <h3 style="margin: 0 0 20px 0; font-size: 18px; font-weight: 900; color: #1f2937;">📈 Thống Kê Chung</h3>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Tổng Hạng Thành Viên</div>
                <div class="stat-value">@(Model?.Count ?? 0)</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Tổng Hội Viên</div>
                <div class="stat-value">@ViewBag.TotalMembers ?? 0</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Tổng Điểm Thưởng</div>
                <div class="stat-value">@(ViewBag.TotalPoints ?? 0)</div>
            </div>
        </div>
    </div>
</div>

