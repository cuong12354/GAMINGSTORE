@{
    ViewData["Title"] = "Chi Tiết Hạng Thành Viên";
    var tier = ViewBag.Tier as GAMINGSTORE.Models.MemberTier;
    var customers = ViewBag.Customers as List<dynamic>;
}

<style>
    .tier-details-container {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .tier-header {
        background: linear-gradient(135deg, #d92e2e 0%, #b82222 100%);
        color: white;
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 30px;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 24px;
        align-items: center;
    }

    .tier-icon-large {
        font-size: 64px;
        width: 100px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 16px;
    }

    .tier-info h1 {
        margin: 0 0 12px 0;
        font-size: 32px;
        font-weight: 950;
    }

    .tier-info p {
        margin: 4px 0;
        opacity: 0.9;
        font-size: 14px;
    }

    .tier-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

    .stat-label {
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 950;
        color: #1f2937;
    }

    .customers-section {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 900;
        color: #1f2937;
        margin: 0 0 20px 0;
        padding-bottom: 16px;
        border-bottom: 2px solid #f0f0f0;
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    table thead {
        background: #f3f4f6;
    }

    table th {
        padding: 12px;
        text-align: left;
        font-weight: 700;
        color: #1f2937;
        border-bottom: 2px solid #e5e7eb;
    }

    table td {
        padding: 12px;
        border-bottom: 1px solid #e5e7eb;
        color: #4b5563;
    }

    table tbody tr:hover {
        background: #f9fafb;
    }

    .customer-name {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .customer-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d92e2e 0%, #b82222 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
    }

    .action-btn {
        padding: 10px 16px;
        border-radius: 8px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        color: #1f2937;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .action-btn:hover {
        background: #d92e2e;
        color: white;
        border-color: #d92e2e;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #9ca3af;
    }

    .empty-icon {
        font-size: 48px;
        margin-bottom: 12px;
    }

    @@media (max-width: 768px) {
        .tier-details-container {
            padding: 16px;
        }

        .tier-header {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .tier-icon-large {
            width: 80px;
            height: 80px;
            font-size: 48px;
        }

        .tier-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        table {
            font-size: 12px;
        }

        table th, table td {
            padding: 8px;
        }
    }
</style>

<div class="tier-details-container">
    <!-- Header -->
    @if (tier != null)
    {
        var tierIcon = tier.Color?.ToLower() switch
        {
            "platinum" => "💎",
            "gold" => "🥇",
            "silver" => "🥈",
            _ => "🥉"
        };

        <div class="tier-header">
            <div class="tier-icon-large">@tierIcon</div>
            <div class="tier-info">
                <h1>@tier.Name</h1>
                <p>@tier.Description</p>
                <p>Ưu đãi giảm giá: <strong>@tier.DiscountPercentage%</strong></p>
            </div>
        </div>

        <!-- Statistics -->
        <div class="tier-stats-grid">
            <div class="stat-card">
                <div class="stat-label">Số Khách Hàng</div>
                <div class="stat-value">@(ViewBag.CustomerCount ?? 0)</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Điểm Tối Thiểu</div>
                <div class="stat-value">@tier.MinPoints</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Điểm Tối Đa</div>
                <div class="stat-value">@tier.MaxPoints</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Ưu Đãi Giảm Giá</div>
                <div class="stat-value">@tier.DiscountPercentage%</div>
            </div>
        </div>

        <!-- Customers Table -->
        <div class="customers-section">
            <h3 class="section-title">👥 Khách Hàng Trong Hạng (@(ViewBag.CustomerCount ?? 0) người)</h3>

            @if (customers != null && customers.Count > 0)
            {
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Tên Khách Hàng</th>
                                <th>Email</th>
                                <th>Điện Thoại</th>
                                <th>Điểm Thưởng</th>
                                <th>Đơn Hàng</th>
                                <th>Tổng Chi Tiêu</th>
                                <th>Ngày Tham Gia</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in customers)
                            {
                                <tr>
                                    <td>
                                        <div class="customer-name">
                                            <div class="customer-avatar">@customer.FullName?.First()</div>
                                            <strong>@customer.FullName</strong>
                                        </div>
                                    </td>
                                    <td style="font-size: 12px;">@customer.Email</td>
                                    <td>@customer.PhoneNumber</td>
                                    <td><strong>@customer.TotalPoints</strong></td>
                                    <td>@customer.TotalOrders</td>
                                    <td>@customer.TotalSpent.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</td>
                                    <td style="font-size: 12px;">@customer.CreatedDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a href="@Url.Action("MemberDetails", "Loyalty", new { area = "Admin", id = customer.Id })" class="action-btn">
                                            Xem Chi Tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <div>Chưa có khách hàng trong hạng này</div>
                </div>
            }
        </div>
    }

    <!-- Action Buttons -->
    <div style="display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap;">
        <a href="@Url.Action("Tiers", "Loyalty", new { area = "Admin" })" class="action-btn">
            ← Quay Lại Hạng Thành Viên
        </a>
        <a href="@Url.Action("Members", "Loyalty", new { area = "Admin" })" class="action-btn">
            ← Xem Danh Sách Hội Viên
        </a>
        <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="action-btn">
            ← Quay Lại Dashboard
        </a>
    </div>
</div>

