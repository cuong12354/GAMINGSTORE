@using GAMINGSTORE.Authorization
@using GAMINGSTORE.Extensions
@using GAMINGSTORE.Areas.Admin.Controllers
@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    string Money(decimal value) => value.ToString("N0") + " ₫";
    var nowText = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
}

<style>
    :root {
        --admin-primary: #d0021b;
        --admin-primary-2: #ff4d4d;
        --admin-dark: #111827;
        --admin-muted: #6b7280;
        --admin-soft: #f5f7fb;
        --admin-card: rgba(255,255,255,.92);
        --admin-border: rgba(15,23,42,.08);
        --admin-shadow: 0 18px 45px rgba(15,23,42,.09);
        --admin-radius: 24px;
    }

    body { background: #f3f5f9 !important; }

    .dashboard-shell {
        max-width: 1480px;
        margin: 0 auto;
        padding: 26px;
        color: var(--admin-dark);
    }

    .hero-admin {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        padding: 32px;
        margin-bottom: 22px;
        color: #fff;
        background:
            radial-gradient(circle at 86% 12%, rgba(255,255,255,.32), transparent 26%),
            radial-gradient(circle at 14% 78%, rgba(255,255,255,.16), transparent 30%),
            linear-gradient(135deg, #111827 0%, #d0021b 52%, #ff5a3d 100%);
        box-shadow: 0 24px 60px rgba(208,2,27,.24);
    }

    .hero-admin::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
        background-size: 42px 42px;
        opacity: .35;
        pointer-events: none;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 26px;
        align-items: center;
    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 34px;
        padding: 0 13px;
        border-radius: 999px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.24);
        backdrop-filter: blur(10px);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .8px;
        margin-bottom: 14px;
    }

    .hero-title {
        font-size: clamp(28px, 4vw, 46px);
        line-height: 1.04;
        font-weight: 950;
        letter-spacing: -.8px;
        margin: 0 0 12px;
    }

    .hero-desc {
        max-width: 760px;
        margin: 0;
        color: rgba(255,255,255,.86);
        font-size: 15px;
        line-height: 1.75;
        font-weight: 600;
    }

    .hero-panel {
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.22);
        backdrop-filter: blur(14px);
        border-radius: 24px;
        padding: 18px;
    }

    .hero-panel-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,.16);
    }

    .hero-panel-row:last-child { border-bottom: 0; }
    .hero-panel-label { color: rgba(255,255,255,.74); font-weight: 800; font-size: 13px; }
    .hero-panel-value { color: #fff; font-weight: 950; font-size: 16px; text-align: right; }

    .top-actions {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    .action-pill {
        min-height: 42px;
        padding: 0 15px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #fff;
        text-decoration: none;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.22);
        font-size: 13px;
        font-weight: 900;
        transition: all .22s ease;
    }

    .action-pill:hover {
        transform: translateY(-2px);
        background: #fff;
        color: #d0021b;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .kpi-card {
        position: relative;
        overflow: hidden;
        min-height: 154px;
        border-radius: 24px;
        padding: 20px;
        background: var(--admin-card);
        border: 1px solid rgba(255,255,255,.7);
        box-shadow: var(--admin-shadow);
        transition: transform .22s ease, box-shadow .22s ease;
    }

    .kpi-card::after {
        content: "";
        position: absolute;
        right: -28px;
        bottom: -28px;
        width: 108px;
        height: 108px;
        border-radius: 50%;
        background: rgba(208,2,27,.08);
    }

    .kpi-card:hover { transform: translateY(-5px); box-shadow: 0 24px 52px rgba(15,23,42,.13); }
    .kpi-card.hot { background: linear-gradient(135deg, #d0021b 0%, #ff6148 100%); color: #fff; }
    .kpi-card.dark { background: linear-gradient(135deg, #111827 0%, #334155 100%); color: #fff; }
    .kpi-card.green { background: linear-gradient(135deg, #059669 0%, #10b981 100%); color: #fff; }
    .kpi-card.orange { background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%); color: #fff; }
    .kpi-card.hot::after, .kpi-card.dark::after, .kpi-card.green::after, .kpi-card.orange::after { background: rgba(255,255,255,.14); }

    .kpi-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; position: relative; z-index: 1; }
    .kpi-icon { width: 48px; height: 48px; border-radius: 18px; display: inline-flex; align-items: center; justify-content: center; background: rgba(208,2,27,.1); color: #d0021b; font-size: 24px; }
    .kpi-card.hot .kpi-icon, .kpi-card.dark .kpi-icon, .kpi-card.green .kpi-icon, .kpi-card.orange .kpi-icon { background: rgba(255,255,255,.16); color: #fff; }
    .kpi-label { position: relative; z-index: 1; color: var(--admin-muted); font-size: 12px; font-weight: 950; text-transform: uppercase; letter-spacing: .65px; margin-bottom: 10px; }
    .kpi-card.hot .kpi-label, .kpi-card.dark .kpi-label, .kpi-card.green .kpi-label, .kpi-card.orange .kpi-label { color: rgba(255,255,255,.78); }
    .kpi-value { position: relative; z-index: 1; font-size: 30px; line-height: 1.05; font-weight: 950; letter-spacing: -.5px; color: #111827; }
    .kpi-card.hot .kpi-value, .kpi-card.dark .kpi-value, .kpi-card.green .kpi-value, .kpi-card.orange .kpi-value { color: #fff; }
    .kpi-note { position: relative; z-index: 1; margin-top: 12px; color: var(--admin-muted); font-size: 13px; font-weight: 800; }
    .kpi-card.hot .kpi-note, .kpi-card.dark .kpi-note, .kpi-card.green .kpi-note, .kpi-card.orange .kpi-note { color: rgba(255,255,255,.82); }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .admin-section {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: var(--admin-radius);
        padding: 22px;
        box-shadow: var(--admin-shadow);
    }

    .section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 18px;
        padding-bottom: 16px;
        border-bottom: 1px solid #edf0f5;
    }

    .section-head h2 { margin: 0; font-size: 21px; font-weight: 950; color: #111827; letter-spacing: -.2px; }
    .section-head p { margin: 4px 0 0; color: var(--admin-muted); font-size: 13px; font-weight: 700; }

    .module-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .module-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 160px;
        padding: 18px;
        border-radius: 22px;
        text-decoration: none;
        color: #111827;
        background: linear-gradient(180deg, #fff 0%, #fbfcff 100%);
        border: 1px solid #e8edf5;
        transition: all .22s ease;
    }

    .module-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 4px;
        background: linear-gradient(90deg, var(--accent, #d0021b), rgba(208,2,27,.2));
    }

    .module-card:hover {
        transform: translateY(-5px);
        color: #111827;
        border-color: rgba(208,2,27,.28);
        box-shadow: 0 18px 34px rgba(15,23,42,.11);
    }

    .module-card:hover .module-arrow { transform: translateX(3px); opacity: 1; }
    .module-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
    .module-icon { width: 48px; height: 48px; border-radius: 18px; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--accent, #d0021b) 12%, white); color: var(--accent, #d0021b); font-size: 24px; }
    .module-count { min-width: 34px; min-height: 30px; padding: 0 10px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: #111827; color: #fff; font-size: 12px; font-weight: 950; }
    .module-title { margin: 0 0 6px; font-size: 16px; font-weight: 950; }
    .module-desc { color: #64748b; font-size: 13px; line-height: 1.52; font-weight: 650; }
    .module-footer { margin-top: auto; padding-top: 14px; display: flex; align-items: center; justify-content: space-between; color: var(--accent, #d0021b); font-size: 12px; font-weight: 950; }
    .module-arrow { opacity: .6; transition: .22s; }

    .quick-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #edf0f5;
    }

    .quick-btn {
        min-height: 40px;
        padding: 0 15px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 950;
        background: #f8fafc;
        color: #111827;
        border: 1px solid #e5e7eb;
        transition: all .2s;
    }

    .quick-btn:hover { background: #d0021b; color: #fff; border-color: #d0021b; transform: translateY(-2px); }

    .two-col {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(340px, .85fr);
        gap: 20px;
        margin-top: 20px;
    }

    .chart-card, .mini-card, .table-card {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: var(--admin-radius);
        padding: 22px;
        box-shadow: var(--admin-shadow);
    }

    .chart-box { height: 330px; }
    .chart-box canvas { max-height: 330px; }

    .stat-list { display: grid; gap: 11px; }
    .stat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 14px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #edf0f5;
    }
    .stat-label { color: #64748b; font-weight: 850; font-size: 13px; }
    .stat-value { color: #111827; font-weight: 950; }

    .table-grid {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        gap: 20px;
        margin-top: 20px;
    }

    .table-wrap { overflow-x: auto; }
    .admin-table { width: 100%; border-collapse: separate; border-spacing: 0 10px; font-size: 14px; }
    .admin-table thead th { padding: 0 12px 6px; color: #64748b; font-size: 11px; font-weight: 950; text-transform: uppercase; letter-spacing: .6px; }
    .admin-table tbody tr { background: #f8fafc; box-shadow: inset 0 0 0 1px #edf0f5; }
    .admin-table tbody td { padding: 13px 12px; border-top: 1px solid #edf0f5; border-bottom: 1px solid #edf0f5; font-weight: 700; color: #334155; }
    .admin-table tbody td:first-child { border-left: 1px solid #edf0f5; border-radius: 14px 0 0 14px; }
    .admin-table tbody td:last-child { border-right: 1px solid #edf0f5; border-radius: 0 14px 14px 0; }

    .badge { display: inline-flex; align-items: center; min-height: 25px; padding: 0 10px; border-radius: 999px; font-size: 12px; font-weight: 950; white-space: nowrap; }
    .badge-warn { background: #fef3c7; color: #92400e; }
    .badge-ok { background: #dcfce7; color: #166534; }
    .badge-danger { background: #fee2e2; color: #991b1b; }
    .muted { color: #94a3b8; }

    @@media(max-width: 1200px) {
        .kpi-grid, .module-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .two-col, .table-grid { grid-template-columns: 1fr; }
    }

    @@media(max-width: 768px) {
        .dashboard-shell { padding: 14px; }
        .hero-inner { grid-template-columns: 1fr; }
        .hero-admin { padding: 22px; border-radius: 22px; }
        .hero-panel { padding: 14px; }
        .kpi-grid, .module-grid { grid-template-columns: 1fr; }
        .section-head { align-items: flex-start; flex-direction: column; }
        .admin-section, .chart-card, .mini-card, .table-card { padding: 16px; border-radius: 18px; }
        .chart-box { height: 260px; }
    }
</style>

<div class="dashboard-shell">
    <div class="hero-admin">
        <div class="hero-inner">
            <div>
                <div class="hero-kicker">⚡ GamingStore Admin Center</div>
                <h1 class="hero-title">Điều khiển toàn bộ hệ thống trong một màn hình</h1>
                <p class="hero-desc">Quản lý sản phẩm, đơn hàng, coupon, kho, khách hàng, phân quyền và báo cáo ngay trên web. Database chỉ dùng để lưu trữ dữ liệu.</p>
            </div>
            <div class="hero-panel">
                <div class="hero-panel-row"><span class="hero-panel-label">Cập nhật</span><span class="hero-panel-value">@nowText</span></div>
                <div class="hero-panel-row"><span class="hero-panel-label">Đơn chờ xử lý</span><span class="hero-panel-value">@Model.PendingOrders đơn</span></div>
                <div class="hero-panel-row"><span class="hero-panel-label">Cảnh báo kho</span><span class="hero-panel-value">@Model.LowStockProducts sản phẩm</span></div>
                <div class="hero-panel-row"><span class="hero-panel-label">Coupon active</span><span class="hero-panel-value">@Model.ActiveCoupons mã</span></div>
            </div>
        </div>
        <div class="top-actions">
            <a class="action-pill" href="@Url.Action("Create", "Product", new { area = "Admin" })">➕ Thêm sản phẩm</a>
            <a class="action-pill" href="@Url.Action("Create", "Coupon", new { area = "Admin" })">🎟️ Tạo coupon</a>
            <a class="action-pill" href="@Url.Action("Index", "OrderManagement", new { area = "Admin" })">📦 Xử lý đơn</a>
            <a class="action-pill" href="@Url.Action("SalesReport", "Dashboard", new { area = "Admin" })">📈 Xem báo cáo</a>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card hot">
            <div class="kpi-top"><div><div class="kpi-label">Tổng doanh thu</div><div class="kpi-value">@Money(Model.TotalRevenue)</div></div><span class="kpi-icon">💰</span></div>
            <div class="kpi-note">Hôm nay: @Money(Model.TodayRevenue)</div>
        </div>
        <div class="kpi-card dark">
            <div class="kpi-top"><div><div class="kpi-label">Đơn hàng</div><div class="kpi-value">@Model.TotalOrders</div></div><span class="kpi-icon">📦</span></div>
            <div class="kpi-note">@Model.PendingOrders cần xử lý · @Model.TodayOrders hôm nay</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-top"><div><div class="kpi-label">Sản phẩm</div><div class="kpi-value">@Model.TotalProducts</div></div><span class="kpi-icon">🛒</span></div>
            <div class="kpi-note">@Model.ActiveProducts đang bán · @Model.LowStockProducts sắp hết</div>
        </div>
        <div class="kpi-card orange">
            <div class="kpi-top"><div><div class="kpi-label">Khách hàng</div><div class="kpi-value">@Model.TotalUsers</div></div><span class="kpi-icon">👥</span></div>
            <div class="kpi-note">@Model.TotalReviews đánh giá · @Model.TotalWishlistItems wishlist</div>
        </div>
    </div>

    <div class="content-grid">
        <div class="admin-section">
            <div class="section-head">
                <div>
                    <h2>🧭 Trung tâm chức năng Admin</h2>
                    <p>Gom tất cả màn hình quản trị quan trọng vào Dashboard.</p>
                </div>
                <p>@Model.ActiveCoupons coupon active · @Model.PendingReturns đổi trả chờ</p>
            </div>

            <div class="module-grid">
                @if (User.HasPermission(PermissionConstants.ProductManage))
                {
                    <a class="module-card" style="--accent:#d0021b" href="@Url.Action("Index", "Product", new { area = "Admin" })">
                        <div class="module-top"><span class="module-icon">🛒</span><span class="module-count">@Model.TotalProducts</span></div>
                        <div class="module-title">Quản lý sản phẩm</div>
                        <div class="module-desc">Thêm, sửa, xóa sản phẩm, upload ảnh, gán danh mục và cập nhật tồn kho.</div>
                        <div class="module-footer"><span>Mở quản lý</span><span class="module-arrow">→</span></div>
                    </a>
                }
                <a class="module-card" style="--accent:#2563eb" href="@Url.Action("Index", "Categories", new { area = "Admin" })">
                    <div class="module-top"><span class="module-icon">📂</span><span class="module-count">@Model.TotalCategories</span></div>
                    <div class="module-title">Quản lý danh mục</div>
                    <div class="module-desc">Tạo nhóm Laptop, PC, Màn hình, Linh kiện và Gaming Gear.</div>
                    <div class="module-footer"><span>Mở danh mục</span><span class="module-arrow">→</span></div>
                </a>
                @if (User.HasPermission(PermissionConstants.OrderManage) || User.HasPermission(PermissionConstants.OrderView))
                {
                    <a class="module-card" style="--accent:#7c3aed" href="@Url.Action("Index", "OrderManagement", new { area = "Admin" })">
                        <div class="module-top"><span class="module-icon">📦</span><span class="module-count">@Model.PendingOrders</span></div>
                        <div class="module-title">Quản lý đơn hàng</div>
                        <div class="module-desc">Xem đơn, xác nhận thanh toán, cập nhật xử lý và giao hàng.</div>
                        <div class="module-footer"><span>Xử lý đơn</span><span class="module-arrow">→</span></div>
                    </a>
                }
                @if (User.HasPermission(PermissionConstants.CouponManage))
                {
                    <a class="module-card" style="--accent:#f59e0b" href="@Url.Action("Index", "Coupon", new { area = "Admin" })">
                        <div class="module-top"><span class="module-icon">🎟️</span><span class="module-count">@Model.ActiveCoupons</span></div>
                        <div class="module-title">Mã giảm giá</div>
                        <div class="module-desc">Tạo, sửa, xóa coupon; quản lý mã active, hết hạn và sắp chạy.</div>
                        <div class="module-footer"><span>Mở coupon</span><span class="module-arrow">→</span></div>
                    </a>
                }
                @if (User.HasPermission(PermissionConstants.ReturnManage) || User.HasPermission(PermissionConstants.ReturnView))
                {
                    <a class="module-card" style="--accent:#ef4444" href="/Return/Pending">
                        <div class="module-top"><span class="module-icon">↩️</span><span class="module-count">@Model.PendingReturns</span></div>
                        <div class="module-title">Yêu cầu đổi trả</div>
                        <div class="module-desc">Duyệt yêu cầu trả hàng, cập nhật trạng thái và ghi chú xử lý.</div>
                        <div class="module-footer"><span>Xem yêu cầu</span><span class="module-arrow">→</span></div>
                    </a>
                }
                <a class="module-card" style="--accent:#0f766e" href="@Url.Action("InventoryReport", "Dashboard", new { area = "Admin" })">
                    <div class="module-top"><span class="module-icon">🏬</span><span class="module-count">@Model.LowStockProducts</span></div>
                    <div class="module-title">Kho hàng</div>
                    <div class="module-desc">Theo dõi tồn kho thấp, hết hàng và sản phẩm cần nhập thêm.</div>
                    <div class="module-footer"><span>Kiểm tra kho</span><span class="module-arrow">→</span></div>
                </a>
                <a class="module-card" style="--accent:#ca8a04" href="@Url.Action("Tiers", "Loyalty", new { area = "Admin" })">
                    <div class="module-top"><span class="module-icon">🏅</span><span class="module-count">@Model.TotalMemberTiers</span></div>
                    <div class="module-title">Hội viên / điểm thưởng</div>
                    <div class="module-desc">Xem hạng thành viên, điểm thưởng và giao dịch loyalty.</div>
                    <div class="module-footer"><span>Mở hội viên</span><span class="module-arrow">→</span></div>
                </a>
                @if (User.HasPermission(PermissionConstants.AuditView))
                {
                    <a class="module-card" style="--accent:#475569" href="@Url.Action("Index", "Audit", new { area = "Admin" })">
                        <div class="module-top"><span class="module-icon">🧾</span><span class="module-count">@Model.TotalAuditLogs</span></div>
                        <div class="module-title">Nhật ký hệ thống</div>
                        <div class="module-desc">Theo dõi lịch sử thay đổi dữ liệu, user thao tác và audit trail.</div>
                        <div class="module-footer"><span>Xem log</span><span class="module-arrow">→</span></div>
                    </a>
                }
                @if (User.HasPermission(PermissionConstants.RoleManage))
                {
                    <a class="module-card"
                       style="--accent:#111827"
                       href="@Url.Action("Index", "RolePermission", new { area = "Admin" })">

                        <div class="module-top">
                            <span class="module-icon">🛡️</span>
                            <span class="module-count">RBAC</span>
                        </div>

                        <div class="module-title">
                            Role Permission
                        </div>

                        <div class="module-desc">
                            Quản lý quyền theo nhóm vai trò như Admin, Staff, Customer.
                        </div>

                        <div class="module-footer">
                            <span>Quản lý Role</span>
                            <span class="module-arrow">→</span>
                        </div>
                    </a>

                    <a class="module-card"
                       style="--accent:#dc2626"
                       href="@Url.Action("Index", "UserPermission", new { area = "Admin" })">

                        <div class="module-top">
                            <span class="module-icon">🔐</span>
                            <span class="module-count">@Model.TotalUsers</span>
                        </div>

                        <div class="module-title">
                            User Permission
                        </div>

                        <div class="module-desc">
                            Phân quyền riêng cho từng tài khoản, override quyền từ role.
                        </div>

                        <div class="module-footer">
                            <span>Phân quyền User</span>
                            <span class="module-arrow">→</span>
                        </div>
                    </a>
                }
                <a class="module-card" style="--accent:#16a34a" href="@Url.Action("SalesReport", "Dashboard", new { area = "Admin" })">
                    <div class="module-top"><span class="module-icon">📈</span><span class="module-count">@Model.MonthlyOrders</span></div>
                    <div class="module-title">Báo cáo doanh thu</div>
                    <div class="module-desc">Xem doanh thu theo tháng, số đơn và xu hướng bán hàng.</div>
                    <div class="module-footer"><span>Xem báo cáo</span><span class="module-arrow">→</span></div>
                </a>
                <a class="module-card" style="--accent:#db2777" href="/Notification/GetUnreadNotifications">
                    <div class="module-top"><span class="module-icon">🔔</span><span class="module-count">@Model.UnreadNotifications</span></div>
                    <div class="module-title">Thông báo</div>
                    <div class="module-desc">Theo dõi thông báo chưa đọc và lịch sử gửi thông báo khách hàng.</div>
                    <div class="module-footer"><span>Xem thông báo</span><span class="module-arrow">→</span></div>
                </a>
            </div>

            <div class="quick-bar">
                <a class="quick-btn" href="@Url.Action("Create", "Product", new { area = "Admin" })">➕ Thêm sản phẩm</a>
                <a class="quick-btn" href="@Url.Action("Add", "Categories", new { area = "Admin" })">➕ Thêm danh mục</a>
                <a class="quick-btn" href="@Url.Action("Create", "Coupon", new { area = "Admin" })">➕ Tạo coupon</a>
                <a class="quick-btn" href="@Url.Action("Index", "OrderManagement", new { area = "Admin" })">📦 Xử lý đơn</a>
                <a class="quick-btn" href="@Url.Action("InventoryReport", "Dashboard", new { area = "Admin" })">⚠️ Kiểm tra kho</a>
            </div>
        </div>
    </div>

    <div class="two-col">
        <div class="chart-card">
            <div class="section-head">
                <div>
                    <h2>📈 Doanh thu 12 tháng</h2>
                    <p>Biểu đồ kết hợp doanh thu và số đơn hàng.</p>
                </div>
            </div>
            <div class="chart-box"><canvas id="revenueChart"></canvas></div>
        </div>
        <div class="mini-card">
            <div class="section-head">
                <div>
                    <h2>📊 Thống kê nhanh</h2>
                    <p>Tình trạng vận hành hiện tại.</p>
                </div>
            </div>
            <div class="stat-list">
                <div class="stat-row"><span class="stat-label">Doanh thu hôm nay</span><span class="stat-value">@Money(Model.TodayRevenue)</span></div>
                <div class="stat-row"><span class="stat-label">Doanh thu 30 ngày</span><span class="stat-value">@Money(Model.MonthlyRevenue)</span></div>
                <div class="stat-row"><span class="stat-label">Coupon active / hết hạn</span><span class="stat-value">@Model.ActiveCoupons / @Model.ExpiredCoupons</span></div>
                <div class="stat-row"><span class="stat-label">Đổi trả đang chờ</span><span class="stat-value">@Model.PendingReturns</span></div>
                <div class="stat-row"><span class="stat-label">Thông báo chưa đọc</span><span class="stat-value">@Model.UnreadNotifications</span></div>
                <div class="stat-row"><span class="stat-label">Newsletter</span><span class="stat-value">@Model.TotalNewsletterSubscriptions</span></div>
            </div>
        </div>
    </div>

    <div class="table-grid">
        <div class="table-card">
            <div class="section-head">
                <div>
                    <h2>📋 Đơn hàng gần đây</h2>
                    <p>@Model.TotalOrders tổng đơn hàng trong hệ thống.</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Mã</th><th>Khách</th><th>Trạng thái</th><th>Tổng tiền</th><th></th></tr></thead>
                    <tbody>
                    @if (Model.RecentOrders.Any())
                    {
                        foreach (var order in Model.RecentOrders)
                        {
                            var statusClass = (order.Status == "Confirmed" || order.Status == "Delivered") ? "badge-ok" : "badge-warn";
                            <tr>
                                <td>#@order.Id</td>
                                <td>@(order.CustomerName ?? order.ApplicationUser?.FullName ?? "Khách")</td>
                                <td><span class="badge @statusClass">@(order.Status ?? "Pending")</span></td>
                                <td><strong>@Money(order.TotalPrice)</strong></td>
                                <td><a class="quick-btn" href="@Url.Action("Details", "OrderManagement", new { area = "Admin", id = order.Id })">Xem</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="muted" style="text-align:center; padding:24px;">Chưa có đơn hàng</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="table-card">
            <div class="section-head">
                <div>
                    <h2>⚠️ Tồn kho thấp</h2>
                    <p>@Model.LowStockProducts sản phẩm cần kiểm tra.</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Sản phẩm</th><th>Tồn</th><th>Tối thiểu</th></tr></thead>
                    <tbody>
                    @if (Model.LowStockItems.Any())
                    {
                        foreach (var item in Model.LowStockItems)
                        {
                            <tr>
                                <td>@(item.Product?.Name ?? "Sản phẩm #" + item.ProductId)</td>
                                <td><span class="badge badge-danger">@item.StockQuantity</span></td>
                                <td>@(item.MinimumStockLevel ?? 10)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="muted" style="text-align:center; padding:24px;">Kho đang ổn</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="table-card" style="margin-top:20px;">
        <div class="section-head">
            <div>
                <h2>🔥 Sản phẩm bán chạy</h2>
                <p>Những mặt hàng tạo doanh thu tốt nhất.</p>
            </div>
        </div>
        <div class="table-wrap">
            <table class="admin-table">
                <thead><tr><th>Sản phẩm</th><th>Số lượng bán</th><th>Doanh thu</th></tr></thead>
                <tbody>
                @if (Model.TopProducts.Any())
                {
                    foreach (var item in Model.TopProducts)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td><strong>@item.Quantity</strong></td>
                            <td>@Money(item.Revenue)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="muted" style="text-align:center; padding:24px;">Chưa có dữ liệu bán hàng</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyRevenueData ?? new List<MonthlyRevenueDataItem>()));
    const monthNames = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];
    const labels = monthlyData.map(item => monthNames[item.month - 1] + '/' + item.year);
    const revenueValues = monthlyData.map(item => item.revenue);
    const orderCounts = monthlyData.map(item => item.orders);

    const ctx = document.getElementById('revenueChart');
    if (ctx) {
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    {
                        label: 'Doanh thu',
                        data: revenueValues,
                        backgroundColor: 'rgba(208,2,27,.74)',
                        borderColor: '#d0021b',
                        borderRadius: 12,
                        borderSkipped: false,
                        borderWidth: 1,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Số đơn',
                        data: orderCounts,
                        type: 'line',
                        tension: .38,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16,185,129,.18)',
                        borderWidth: 3,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { weight: 800 } } },
                    y: {
                        position: 'left',
                        grid: { color: 'rgba(148,163,184,.18)' },
                        ticks: { color: '#64748b', callback: value => new Intl.NumberFormat('vi-VN').format(value) + '₫' }
                    },
                    y1: {
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        ticks: { color: '#64748b', precision: 0 }
                    }
                },
                plugins: {
                    legend: { labels: { usePointStyle: true, boxWidth: 8, color: '#334155', font: { weight: 800 } } },
                    tooltip: {
                        backgroundColor: '#111827',
                        padding: 12,
                        cornerRadius: 12,
                        callbacks: {
                            label: function(context) {
                                if (context.dataset.label === 'Doanh thu') {
                                    return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN').format(context.parsed.y) + ' ₫';
                                }
                                return 'Số đơn: ' + context.parsed.y;
                            }
                        }
                    }
                }
            }
        });
    }
</script>
