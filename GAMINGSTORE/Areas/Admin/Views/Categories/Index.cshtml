@model IEnumerable<GAMINGSTORE.Models.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
    Layout = "_LayoutAdmin"; // Assuming there is an admin layout

    // Helper to render tree
    void RenderCategoryRow(GAMINGSTORE.Models.Category category, int level)
    {
        <tr>
            <td>
                @for (int i = 0; i < level; i++)
                {
                    <span class="ms-4 text-muted">|—</span>
                }
                <span class="@(level == 0 ? "fw-bold" : "")">@category.Name</span>
            </td>
            <td>
                @if (!string.IsNullOrEmpty(category.Icon))
                {
                    <i class="@category.Icon"></i> <small>@category.Icon</small>
                }
            </td>
            <td>@category.DisplayOrder</td>
            <td>
                @if (category.IsMenuVisible)
                {
                    <span class="badge bg-success">Hiện</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ẩn</span>
                }
            </td>
            <td class="text-end">
                <a href="/Admin/Categories/Update/@category.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                <a href="/Admin/Categories/Delete/@category.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
            </td>
        </tr>

        var subCats = Model.Where(c => c.ParentId == category.Id).OrderBy(c => c.DisplayOrder);
        foreach (var sub in subCats)
        {
            RenderCategoryRow(sub, level + 1);
        }
    }
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-grid-3x3-gap me-2"></i>Quản lý Danh mục</h2>
        <a asp-action="Add" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Thêm danh mục mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Tên danh mục</th>
                            <th>Icon</th>
                            <th>Thứ tự</th>
                            <th>Menu</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Where(c => c.ParentId == null).OrderBy(c => c.DisplayOrder))
                        {
                            RenderCategoryRow(category, 0);
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
