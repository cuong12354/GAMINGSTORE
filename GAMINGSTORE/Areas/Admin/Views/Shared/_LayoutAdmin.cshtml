        .logo {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: .5px;
        }

        .logo a {
            color: #fff !important;
            text-decoration: none !important;
        }

        .search-wrap {
            max-width: 560px;
        }

        .search-form {
            height: 40px;
            background: #fff;
            border-radius: 4px;
            box-shadow: inset 0 0 0 1px rgba(0,0,0,0.04);
        }

        .search-box {
            color: #111;
            font-weight: 500;
        }

        .search-btn {
            background: var(--primary-hover);
            color: #fff;
        }

        .search-btn:hover {
            background: var(--primary-dark);
        }

        .cart-btn {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            background: rgba(255,255,255,.16);
            color: #fff !important;
        }

        .cart-btn:hover {
            background: rgba(0,0,0,.15);
        }

        .cart-badge {
            background: #fff;
            color: var(--primary);
            border-color: #fff;
        }

        .main-content {
            background: var(--bg-body);
            padding-top: 18px;
            padding-bottom: 28px;
        }

        .megamenu-wrapper {
            background: var(--header-bg);
            top: 60px;
            box-shadow: 0 2px 8px rgba(0,0,0,.16);
            border-top: 1px solid rgba(255,255,255,.08);
            border-bottom: 1px solid rgba(0,0,0,.18);
        }

        .megamenu-container {
            height: 48px;
        }

        .menu-link {
            height: 48px;
            color: #fff !important;
            font-weight: 800;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .35px;
            padding: 0 15px;
        }

        .menu-link:hover,
        .menu-item:hover .menu-link {
            background: rgba(0,0,0,.14);
            color: #fff !important;
        }

        .menu-link::after {
            background: #fff;
            height: 3px;
        }

        .mega-dropdown {
            top: 108px;
            background: #fff;
            border-top: 3px solid var(--primary);
            border-bottom: 1px solid #e9e9e9;
            box-shadow: 0 16px 45px rgba(0,0,0,.22);
            padding: 30px 0;
        }

        .mega-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 28px;
        }

        .mega-title {
            color: #111;
            font-size: 12.5px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .8px;
        }

        .mega-list a {
            color: #444;
            border-radius: 6px;
            padding: 7px 10px;
            font-size: 13.5px;
        }

        .mega-list a:hover {
            background: #fff5f5;
            color: var(--primary);
            padding-left: 15px;
            font-weight: 700;
        }

        /* Product layout lấy theo văn bản 1 */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 22px;
            margin-bottom: 36px;
        }

        .category-product-section {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
