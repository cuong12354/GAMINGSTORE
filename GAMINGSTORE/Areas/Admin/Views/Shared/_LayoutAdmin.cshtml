            scrollbar-width: none;
        }

        .scroll-x-mb::-webkit-scrollbar { display: none; }

        .item-banner {
            flex: 0 0 auto;
            width: 300px;
            border-radius: 10px;
            overflow: hidden;
            transition: transform .25s ease, box-shadow .25s ease;
            box-shadow: 0 6px 18px rgba(0,0,0,.08);
        }

        .item-banner:hover {
