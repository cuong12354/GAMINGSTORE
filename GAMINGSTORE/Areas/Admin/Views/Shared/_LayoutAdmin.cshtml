@using GAMINGSTORE.Models
@using GAMINGSTORE.Extensions

@{
    var cart = Context.Session.GetShoppingCart(Context.User);
    var totalQuantity = cart.GetTotalQuantity();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GAMINGSTORE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #d0021b;
            --primary-dark: #a50015;
            --primary-hover: #e50100;
            --surface: #1e1e1e;
            --surface-soft: #2a2a2a;
            --bg-body: #161617;
            --text: #ffffff;
            --text-light: #cccccc;
            --text-muted: #aaaaaa;
            --border: rgba(255,255,255,0.08);
            --border-light: rgba(255,255,255,0.06);
            --footer-bg: #161617;
            --header-bg: #d0021b;
            --radius: 6px;
            --radius-lg: 12px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        *:focus {
            outline: none;
        }

        html, body {
            height: 100%;
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-body);
            display: flex;
            flex-direction: column;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
            color: var(--text);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-size: 14px;
            line-height: 1.5;
        }

        /* ===== HEADER / TOPBAR ===== */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: var(--header-bg);
            color: white;
            padding: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.18);
            flex-shrink: 0;
        }

        .topbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            height: 60px;
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        .logo a {
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: opacity 0.2s;
        }

        .logo a:hover {
            opacity: 0.9;
        }

        /* ===== SEARCH ===== */
        .search-wrap {
            flex: 1;
            max-width: 480px;
        }

        .search-form {
            display: flex;
            align-items: center;
            background: #ffffff;
            border-radius: 4px;
            overflow: hidden;
            height: 40px;
        }

        .search-box {
            width: 100%;
            border: none;
            padding: 0 14px;
            font-size: 14px;
            font-family: inherit;
            background: transparent;
            color: #161617;
            height: 100%;
        }

        .search-box::placeholder { color: #aaa; }
        .search-box:focus { outline: none; }

        .search-btn {
            width: 44px;
            height: 100%;
            border-radius: 0;
            background: var(--primary-hover);
            border: none;
            color: white;
            cursor: pointer;
            font-size: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background 0.2s;
        }

        .search-btn:hover { background: var(--primary-dark); }

        /* ===== TOPBAR ACTIONS ===== */
        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-btn {
            width: 42px;
            height: 42px;
            font-size: 20px;
            color: white;
            text-decoration: none;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(255,255,255,0.15);
            transition: background 0.2s;
        }

        .cart-btn:hover {
            color: white;
            background: rgba(255,255,255,0.25);
        }

        .cart-badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background: white;
            color: var(--primary);
            border-radius: 50%;
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            border: 1px solid var(--primary);
        }

        /* OFFCANVAS CART */
        .cart-offcanvas {
            position: fixed;
            top: 0;
            right: -400px;
            width: 400px;
            max-width: 100vw;
            height: 100vh;
            background: #fff;
            box-shadow: -5px 0 25px rgba(0,0,0,0.1);
            z-index: 1060;
            transition: right 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
        }

        .cart-offcanvas.show {
            right: 0;
        }

        .cart-offcanvas-header {
            padding: 16px 20px;
            background: var(--header-bg);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cart-offcanvas-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0;
        }

        .btn-close-offcanvas {
            background: none;
            border: none;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .btn-close-offcanvas:hover {
            transform: scale(1.1);
        }

        .cart-offcanvas-body {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            background: #f8f9fa;
        }

        .offcanvas-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.5);
            z-index: 1050;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
            backdrop-filter: blur(3px);
        }

        .offcanvas-backdrop.show {
            opacity: 1;
            visibility: visible;
        }

        /* CONTENT */
        .main-content {
            flex: 1;
        }

        .container {
            max-width: 1220px;
            margin: 0 auto;
            padding: 0 18px;
        }

        /* ===== FOOTER ===== */
        footer {
            background: var(--footer-bg);
            color: rgba(255,255,255,0.75);
            margin-top: auto;
            padding: 48px 0 20px;
            flex-shrink: 0;
            border-top: 3px solid var(--primary);
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 32px;
            margin-bottom: 32px;
        }

        .footer-section h5 {
            color: #fff;
            font-weight: 700;
            margin-bottom: 14px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--primary);
            padding-bottom: 8px;
            display: inline-block;
        }

        .footer-section ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-section ul li {
            margin-bottom: 8px;
        }

        .footer-section a {
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.2s;
        }

        .footer-section a:hover { color: white; }

        .footer-section p {
            font-size: 13px;
            color: rgba(255,255,255,0.6);
            line-height: 1.7;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 18px;
            text-align: center;
            color: rgba(255,255,255,0.4);
            font-size: 12px;
        }

        /* RESPONSIVE - TABLET & MOBILE */
        @@media (max-width: 768px) {
            /* TOPBAR OPTIMIZATION */
            .topbar {
                padding: 12px 0;
            }

            .topbar-inner {
                flex-wrap: wrap;
                gap: 10px;
            }

            .logo {
                font-size: 18px;
                letter-spacing: 0.4px;
            }

            .search-wrap {
                order: 3;
                max-width: none;
                width: 100%;
                margin-top: 6px;
            }

            .search-form {
                padding: 4px;
            }

            .search-box {
                padding: 10px 14px;
                font-size: 13px;
            }

            .search-btn {
                width: 42px;
                height: 42px;
                font-size: 16px;
            }

            .topbar-actions {
                gap: 8px;
            }

            .cart-btn {
                width: 44px;
                height: 44px;
                font-size: 20px;
            }

            .cart-badge {
                width: 20px;
                height: 20px;
                font-size: 10px;
                top: -6px;
                right: -10px;
            }

            /* CONTAINER */
            .container {
                padding: 0 12px;
            }

            /* FOOTER */
            .footer-content {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .footer-section h5 {
                font-size: 15px;
            }
        }

        /* RESPONSIVE - SMALL PHONES (max 480px) */
        @@media (max-width: 480px) {
            /* TEXT SIZING */
            html {
                font-size: 14px;
            }

            /* TOPBAR MORE COMPACT */
            .topbar {
                padding: 8px 0;
            }

            .logo {
                font-size: 14px;
                flex-shrink: 0;
                width: 60px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .logo a {
                gap: 4px;
                font-size: 14px;
            }

            .topbar-inner {
                gap: 6px;
                flex-wrap: nowrap !important;
                padding: 0 6px;
            }

            .search-wrap {
                order: auto !important;
                width: auto !important;
                max-width: none !important;
                flex: 1;
                min-width: 80px;
                margin: 0 !important;
            }

            .search-form {
                padding: 3px;
                gap: 4px;
            }

            .search-box {
                padding: 6px 10px;
                font-size: 11px;
                min-width: 0;
            }

            .search-btn {
                width: 36px;
                height: 36px;
                font-size: 13px;
                flex-shrink: 0;
            }

            .topbar-actions {
                flex-shrink: 0;
                gap: 4px;
                order: auto !important;
            }

            .cart-btn {
                width: 38px;
                height: 38px;
                font-size: 16px;
                flex-shrink: 0;
            }

            /* FORM INPUTS - TOUCH FRIENDLY */
            input[type="text"],
            input[type="email"],
            input[type="password"],
            input[type="tel"],
            input[type="number"],
            textarea,
            select {
                font-size: 16px !important;
                padding: 12px 14px !important;
                min-height: 44px !important;
                border-radius: 12px !important;
            }

            /* BUTTONS - LARGER TOUCH TARGETS */
            button,
            a.btn,
            .btn {
                min-height: 48px !important;
                padding: 12px 16px !important;
                font-size: 14px !important;
                border-radius: 12px !important;
            }

            /* MODAL & ALERTS */
            .modal-dialog {
                margin: 10px !important;
            }

            .alert {
                padding: 12px 14px !important;
                margin: 12px 0 !important;
            }

            /* CARD PADDING */
            .card {
                margin-bottom: 12px !important;
            }

            .card-body {
                padding: 14px !important;
            }

            /* SPACING */
            h1, .h1 { font-size: 1.75rem; margin-bottom: 12px; }
            h2, .h2 { font-size: 1.5rem; margin-bottom: 10px; }
            h3, .h3 { font-size: 1.25rem; margin-bottom: 8px; }
            p { margin-bottom: 10px; }

            /* TABLES RESPONSIVE */
            table {
                font-size: 13px !important;
            }

            table th,
            table td {
                padding: 10px 8px !important;
            }

            /* HIDE DESKTOP ONLY ELEMENTS */
            .desktop-only {
                display: none !important;
            }

            /* CHATBOT POSITION */
            .sales-chatbot {
                right: 8px;
                bottom: 8px;
            }

            .sales-chatbot-toggle {
                width: 56px;
                height: 56px;
                font-size: 22px;
            }

            .sales-chatbot-panel {
                width: calc(100vw - 16px) !important;
                height: min(85vh, 500px) !important;
                border-radius: 20px;
            }

            /* NAVBAR */
            .navbar {
                padding: 10px 0 !important;
            }

            .navbar-brand {
                font-size: 16px !important;
            }

            .nav-link {
                padding: 8px 12px !important;
            }

            /* GRID RESPONSIVE */
            .row {
                margin-right: -8px;
                margin-left: -8px;
            }

            .col-6 { padding-right: 8px; padding-left: 8px; }
            .col-12 { padding-right: 8px; padding-left: 8px; }
        }

        @@media (max-width: 360px) {
            .logo {
                font-size: 14px !important;
            }

            .topbar-actions {
                gap: 4px;
            }

            .cart-btn {
                width: 38px;
                height: 38px;
                font-size: 16px;
            }

            .search-box {
                font-size: 11px;
                padding: 8px 10px;
            }
        }

        .sales-chatbot {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 1050;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 14px;
        }

        .sales-chatbot-panel {
            width: min(390px, calc(100vw - 28px));
            height: 560px;
            max-height: calc(100vh - 110px);
            border-radius: 26px;
            overflow: hidden;
            background: rgba(255,255,255,0.98);
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
            display: none;
            flex-direction: column;
        }

        .sales-chatbot.is-open .sales-chatbot-panel {
            display: flex;
        }

        .sales-chatbot-header {
            padding: 18px 18px 16px;
            color: white;
            background: var(--header-bg);
        }

        .sales-chatbot-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .sales-chatbot-title-icon {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.18);
            font-size: 18px;
        }

        .sales-chatbot-subtitle {
            font-size: 13px;
            line-height: 1.6;
            color: rgba(255,255,255,0.86);
            margin: 0;
        }

        .sales-chatbot-body {
            flex: 1;
            padding: 16px;
            background: linear-gradient(180deg, #fff9f6 0%, #f8fafc 100%);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sales-chat-message {
            max-width: 88%;
            padding: 12px 14px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.7;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
        }

        .sales-chat-message.bot {
            align-self: flex-start;
            background: white;
            color: var(--text);
            border-top-left-radius: 8px;
        }

        .sales-chat-message.user {
            align-self: flex-end;
            background: var(--primary);
            color: white;
            border-top-right-radius: 8px;
        }

        .sales-chat-product-list {
            display: grid;
            gap: 10px;
        }

        .sales-chat-product {
            display: grid;
            grid-template-columns: 70px minmax(0, 1fr);
            gap: 12px;
            padding: 12px;
            border-radius: 18px;
            background: white;
            text-decoration: none;
            color: inherit;
            border: 1px solid rgba(15, 23, 42, 0.06);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
        }

        .sales-chat-product img {
            width: 70px;
            height: 70px;
            object-fit: contain;
            border-radius: 14px;
            background: linear-gradient(180deg, #fff8f5, #f8fafc);
            padding: 8px;
        }

        .sales-chat-product-name {
            font-size: 14px;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 6px;
            line-height: 1.45;
        }

        .sales-chat-product-meta {
            font-size: 12px;
            color: var(--text-light);
            margin-bottom: 8px;
        }

        .sales-chat-product-price {
            font-size: 16px;
            font-weight: 800;
            color: var(--primary);
        }

        .sales-chat-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 2px;
        }

        .sales-chat-suggestion {
            min-height: 34px;
            padding: 0 12px;
            border-radius: 999px;
            border: 1px solid rgba(217, 46, 46, 0.16);
            background: white;
            color: var(--primary-dark);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .sales-chat-input-wrap {
            padding: 14px;
            border-top: 1px solid rgba(15, 23, 42, 0.06);
            background: white;
        }

        .sales-chat-form {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 52px;
            gap: 10px;
        }

        .sales-chat-input {
            min-height: 52px;
            border-radius: 16px;
            border: 1px solid rgba(15, 23, 42, 0.08);
            padding: 0 16px;
            font-size: 14px;
            color: var(--text);
            background: #fbfcfd;
        }

        .sales-chat-input:focus {
            outline: none;
            border-color: rgba(217, 46, 46, 0.5);
            box-shadow: 0 0 0 4px rgba(217, 46, 46, 0.12);
        }

        .sales-chat-send,
        .sales-chat-toggle {
            border: none;
            color: white;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--primary);
        }

        .sales-chat-send {
            width: auto;
            min-width: 52px;
            height: 52px;
            padding: 0 14px;
            border-radius: 16px;
            box-shadow: 0 14px 28px rgba(217, 46, 46, 0.18);
            font-size: 12px;
            font-weight: 700;
            gap: 6px;
        }

        .sales-chat-send:hover {
            box-shadow: 0 18px 36px rgba(217, 46, 46, 0.25);
        }

        .sales-chat-send:active {
            box-shadow: 0 8px 16px rgba(217, 46, 46, 0.15);
        }

        .sales-chat-toggle {
            width: 62px;
            height: 62px;
            border-radius: 22px;
            font-size: 24px;
            box-shadow: 0 18px 34px rgba(217, 46, 46, 0.25);
        }

        .sales-chatbot.is-open .sales-chat-toggle {
            background: linear-gradient(135deg, #212245, #2f325f);
        }

        .sales-chat-typing {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .sales-chat-typing span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(31, 41, 55, 0.4);
            animation: sales-chat-pulse 1.1s infinite ease-in-out;
        }

        .sales-chat-typing span:nth-child(2) {
            animation-delay: 0.12s;
        }

        .sales-chat-typing span:nth-child(3) {
            animation-delay: 0.24s;
        }

        @@keyframes sales-chat-pulse {
            0%, 80%, 100% { transform: scale(0.7); opacity: 0.45; }
            40% { transform: scale(1); opacity: 1; }
        }

        @@media (max-width: 768px) {
            .sales-chatbot {
                right: 14px;
                bottom: 14px;
            }

            .sales-chatbot-panel {
                width: min(100vw - 18px, 390px);
                height: min(76vh, 560px);
            }
        }

        /* ===== MEGA MENU - XGEAR STYLE ===== */
        .megamenu-wrapper {
            background: #d0021b;
            position: sticky;
            top: 60px;
            z-index: 999;
            border-bottom: 1px solid rgba(0,0,0,0.1);
        }

        .megamenu-container {
            display: flex;
            align-items: center;
            list-style: none;
            margin: 0;
            padding: 0;
            height: 48px;
        }

        .menu-item {
            height: 100%;
            position: relative;
        }

        .menu-link {
            display: flex;
            align-items: center;
            height: 100%;
            padding: 0 16px;
            color: white;
            text-decoration: none !important;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            white-space: nowrap;
            transition: all 0.2s;
            position: relative;
        }

        .menu-link i { font-size: 16px; }

        .menu-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 15%;
            right: 15%;
            height: 3px;
            background: white;
            transform: scaleX(0);
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 3px 3px 0 0;
        }

        .menu-item:hover .menu-link::after { transform: scaleX(1); }
        .menu-item:hover .menu-link { background: rgba(0,0,0,0.12); color: #fff; }

        /* ===== MEGA DROPDOWN PANEL ===== */
        .mega-dropdown {
            position: fixed;
            top: 108px; /* 60px header + 48px megamenu */
            left: 0;
            right: 0;
            background: white;
            box-shadow: 0 15px 40px rgba(0,0,0,0.2);
            padding: 32px 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            border-top: 3px solid #d0021b;
            z-index: 998;
            border-bottom: 1px solid #eee;
        }

        .menu-item:hover .mega-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* Bridge gap */
        .mega-dropdown::before {
            content: "";
            position: absolute;
            top: -15px;
            left: 0;
            right: 0;
            height: 15px;
            background: transparent;
        }

        .mega-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .mega-title {
            font-size: 12.5px;
            font-weight: 800;
            color: #111;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #f2f2f2;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            position: relative;
        }

        .mega-title::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 40px;
            height: 2px;
            background: #d0021b;
        }

        .mega-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .mega-list li { margin-bottom: 3px; }

        .mega-list a {
            color: #444;
            text-decoration: none !important;
            font-size: 13.5px;
            transition: all 0.2s;
            display: block;
            padding: 6px 10px;
            border-radius: 5px;
        }

        .mega-list a:hover {
            color: #d0021b;
            background: #fff5f5;
            padding-left: 15px;
            font-weight: 600;
        }

        .mega-promo {
            transition: transform 0.3s;
        }
        .mega-promo:hover { transform: translateY(-5px); }

        .menu-link.text-warning {
            color: #ffc107 !important;
            background: rgba(0,0,0,0.05);
            margin-left: 10px;
            border-radius: 4px;
        }

        .menu-link.text-warning:hover {
            background: rgba(0,0,0,0.15);
        }

        @@media (max-width: 991px) {
            .megamenu-wrapper { display: none; }
        }

        /* ===== CATEGORY PRODUCT SECTIONS ===== */
        .category-product-section {
            margin-bottom: 50px;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        .section-header-banner {
            width: 100%;
            height: auto;
            display: block;
        }

        .section-header-banner img {
            width: 100%;
            height: auto;
            max-height: 250px;
            object-fit: cover;
        }

        .section-content {
            padding: 25px;
        }

        .section-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 15px;
        }

        .section-name {
            font-size: 24px;
            font-weight: 800;
            color: #111;
            text-transform: uppercase;
            position: relative;
        }

        .section-name::after {
            content: '';
            position: absolute;
            bottom: -17px;
            left: 0;
            width: 60px;
            height: 3px;
            background: #d0021b;
        }

        .view-all-link {
