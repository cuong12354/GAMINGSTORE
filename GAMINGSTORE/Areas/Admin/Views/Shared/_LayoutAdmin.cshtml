        }

        .product-card {
            background: #fff;
            border: 1px solid #eeeeee;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(0,0,0,.08);
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }

        .product-card:hover {
            transform: translateY(-4px);
            border-color: rgba(208,2,27,.25);
            box-shadow: 0 14px 30px rgba(0,0,0,.15);
        }

        .product-image-wrapper {
            background: #fff;
            height: 220px;
        }

        .product-image {
            object-fit: contain;
            padding: 16px;
        }

        .product-name {
            color: #111;
            font-size: 15px;
            font-weight: 800;
            line-height: 1.45;
        }

        .product-category,
        .result-pill {
            background: #fff5f5;
            color: var(--primary);
        }

        .product-price {
            color: var(--primary);
            font-size: 21px;
            font-weight: 900;
        }

        .product-button,
        .btn-outline-danger:hover {
            background: var(--primary) !important;
            border-color: var(--primary) !important;
            color: #fff !important;
        }

        .filter-bar {
            background: #fff;
            border: 1px solid rgba(0,0,0,.06);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
        }

        .form-select,
        .category-dropdown {
            background: #fff;
            color: #111;
            border-color: #e5e5e5;
        }

        footer {
            background: var(--footer-bg);
            border-top: 3px solid var(--primary);
        }

        .footer-section h5 {
            color: #fff;
            border-bottom-color: var(--primary);
        }

        .footer-section a:hover {
            color: #fff;
        }

        @@media (max-width: 991px) {
            .megamenu-wrapper { display: none; }
            .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
        }

        @@media (max-width: 768px) {
            .topbar { padding: 10px 0; }
            .topbar-inner { height: auto; flex-wrap: wrap; }
            .logo { font-size: 18px; }
            .search-wrap { order: 3; max-width: none; width: 100%; }
            .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
            .section-content { padding: 16px; }
            .section-name { font-size: 19px; }
            .item-banner { width: 240px; }
        }

        @@media (max-width: 480px) {
            .main-content { padding-top: 12px; }
            .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
            .product-image-wrapper { height: 150px; }
            .product-name { font-size: 13px; }
            .product-price { font-size: 17px; }
        }
</style>
</head>



<body>
    <!-- HEADER -->
    <div class="topbar">
        <div class="container topbar-inner">

            <!-- LOGO -->
            <div class="logo">
                <a asp-area="" asp-controller="Home" asp-action="Index">🎮 GAMINGSTORE</a>
            </div>

            <!-- SEARCH -->
            <div class="search-wrap">
                <form asp-area="" asp-controller="Home" asp-action="Index" method="get" class="search-form">
                    <input class="search-box"
                           type="text"
                           name="searchString"
                           placeholder="Tìm sản phẩm..." 
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="search-btn">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <!-- CART + NOTIFICATIONS + LOGIN -->
            <div class="topbar-actions" style="display: flex; align-items: center; gap: 12px;">
                <a href="/ShoppingCart/Index" onclick="handleCartClick(event)" class="cart-btn" title="Xem giỏ hàng">
                    <i class="bi bi-cart-fill"></i>
                    <span class="cart-badge" id="cart-badge-count" style="display: @(totalQuantity > 0 ? "flex" : "none")">@totalQuantity</span>
                </a>

                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>

    @await Component.InvokeAsync("CategoryNav")

    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- OFFCANVAS CART HTML -->
    <div id="cartOffcanvasBackdrop" class="offcanvas-backdrop" onclick="toggleCartOffcanvas(event)"></div>
    <div id="cartOffcanvas" class="cart-offcanvas">
        <div class="cart-offcanvas-header">
            <h5 class="cart-offcanvas-title"><i class="bi bi-cart3 me-2"></i>Giỏ hàng</h5>
            <button type="button" class="btn-close-offcanvas" onclick="toggleCartOffcanvas(event)"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="cart-offcanvas-body" id="cartOffcanvasBody">
            <div class="text-center py-5">
                <div class="spinner-border text-danger" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h5>🎮 GAMINGSTORE</h5>
                    <p style="color: rgba(255,255,255,0.72); line-height: 1.8;">Nền tảng mua sắm thiết bị gaming với trải nghiệm hiện đại, lọc sản phẩm nhanh và quy trình đặt hàng gọn gàng.</p>
                </div>

                <div class="footer-section">
                    <h5>📚 Hỗ Trợ</h5>
                    <ul>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>📞 Liên Hệ</h5>
                    <ul>
                        <li><strong>📧 Email:</strong> support@gamingstore.com</li>
                        <li><strong>📱 Hotline:</strong> 1900.xxx.xxx</li>
                        <li><strong>📍 Địa chỉ:</strong> 123 Đường ABC, TP.HCM</li>
                        <li><strong>⏰ Giờ làm:</strong> 8:00 - 22:00 (T2-CN)</li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>🤝 Theo Dõi</h5>
                    <div style="display: flex; gap: 12px;">
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">f</a>
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">📷</a>
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">▶</a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 <strong>GAMINGSTORE</strong> - Tất cả các quyền được bảo lưu | Thiết kế và phát triển bởi <strong>A Nam đệp trai</strong></p>
            </div>
        </div>
    </footer>

    <div class="sales-chatbot" id="salesChatbot" data-sales-chat-url="@Url.Action("Ask", "SalesChat")">
        <div class="sales-chatbot-panel">
            <div class="sales-chatbot-header">
                <div class="sales-chatbot-title">
                    <span class="sales-chatbot-title-icon"><i class="bi bi-headset"></i></span>
                    <span>Trợ lý bán hàng</span>
                </div>
                <p class="sales-chatbot-subtitle">Hỏi theo nhu cầu, danh mục hoặc giá. Ví dụ: laptop gaming dưới 20 triệu, chuột RGB, màn hình 27 inch.</p>
            </div>

            <div class="sales-chatbot-body" id="salesChatMessages"></div>

            <div class="sales-chat-input-wrap">
                <form class="sales-chat-form" id="salesChatForm">
                    <input id="salesChatInput" class="sales-chat-input" type="text" placeholder="Nhập nhu cầu mua sắm của bạn..." autocomplete="off" />
                    <button class="sales-chat-send" type="submit" aria-label="Gửi tin nhắn">
                        <i class="bi bi-send-fill"></i><span>Gửi</span>
                    </button>
                </form>
            </div>
        </div>

        <button class="sales-chat-toggle" id="salesChatToggle" type="button" aria-label="Mở chatbot bán hàng">
            <i class="bi bi-chat-dots-fill"></i>
        </button>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    <script>
        function handleCartClick(e) {
            // Chỉ bật offcanvas ở trang chi tiết sản phẩm
            if (window.location.pathname.toLowerCase().includes('/product/details')) {
                e.preventDefault();
                toggleCartOffcanvas(e);
            }
        }

        function toggleCartOffcanvas(e) {
            if (e) e.preventDefault();
            const offcanvas = document.getElementById('cartOffcanvas');
            const backdrop = document.getElementById('cartOffcanvasBackdrop');
            
            if (offcanvas.classList.contains('show')) {
                offcanvas.classList.remove('show');
                backdrop.classList.remove('show');
            } else {
                offcanvas.classList.add('show');
                backdrop.classList.add('show');
                loadCartPartial();
            }
        }

        function loadCartPartial() {
            fetch('/ShoppingCart/GetCartPartial')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('cartOffcanvasBody').innerHTML = html;
                })
                .catch(error => console.error('Error loading cart:', error));
        }

        function updateCartItem(productId, action) {
            let url = `/ShoppingCart/${action === 'increase' ? 'Increase' : 'Decrease'}?productId=${productId}`;
            fetch(url, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    updateCartBadge(data.totalQuantity);
                    loadCartPartial();
                }
            });
        }

        function removeCartItem(productId) {
            fetch(`/ShoppingCart/RemoveFromCart?productId=${productId}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    updateCartBadge(data.totalQuantity);
                    loadCartPartial();
                }
            });
        }

        function updateCartBadge(totalQuantity) {
            const badge = document.getElementById('cart-badge-count');
            if (badge) {
                if (totalQuantity > 0) {
                    badge.innerText = totalQuantity;
                    badge.style.display = 'flex';
                    // Trigger animation
                    badge.style.animation = 'none';
                    badge.offsetHeight; /* trigger reflow */
                    badge.style.animation = 'pulse-badge 0.6s ease-in-out 1';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        // CHẶN LOAD TRANG KHI ẤN THÊM VÀO GIỎ
        document.addEventListener('click', function(e) {
            // Tìm thẻ <a> có chứa addtocart không phân biệt chữ hoa chữ thường
            let target = e.target.closest('a[href*="AddToCart" i], a[href*="addtocart" i]');
            if (target) {
                e.preventDefault();
                let url = target.getAttribute('href');
                addToCartAjax(url);
            }
        });

        document.addEventListener('submit', function(e) {
            let target = e.target.closest('form[action*="AddToCart" i], form[action*="addtocart" i]');
            if (target) {
                e.preventDefault();
                let formData = new FormData(target);
                let url = new URL(target.action, window.location.origin);
                let params = new URLSearchParams(formData);
                let fetchUrl = url.pathname + '?' + params.toString();
                
                addToCartAjax(fetchUrl);
            }
        });

        function addToCartAjax(url) {
            fetch(url, {
                method: 'POST', 
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    updateCartBadge(data.totalQuantity);
                    
                    // Bật offcanvas nếu đang xem trang chi tiết sản phẩm
                    if (window.location.pathname.toLowerCase().includes('/product/details')) {
                        const offcanvas = document.getElementById('cartOffcanvas');
                        const backdrop = document.getElementById('cartOffcanvasBackdrop');
                        offcanvas.classList.add('show');
                        backdrop.classList.add('show');
                        loadCartPartial();
                    } else {
                        // Thêm Toast notification
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Thêm vào giỏ hàng thành công',
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true,
                            background: '#161617',
                            color: '#fff',
                            iconColor: '#a5dc86'
                        });
                    }
                }
            })
            .catch(err => console.error(err));
        }

    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>