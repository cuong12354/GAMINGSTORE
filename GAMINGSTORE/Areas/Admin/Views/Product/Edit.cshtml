@model GAMINGSTORE.Models.Product
@using System.Globalization

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";

    var existingImages = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? new List<string> { "/images/no-image.png" }
        : Model.ImageUrl
            .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

    var selectedCategoryCount = Model.Categories?.Count ?? 0;
}

<style>
    :root {
        --edit-primary: #d92e2e;
        --edit-primary-dark: #c43a20;
        --edit-text: #18212f;
        --edit-muted: #64748b;
        --edit-line: rgba(15, 23, 42, 0.08);
        --edit-bg: #f5f7fb;
    }

    body {
        background:
            radial-gradient(circle at top right, rgba(217, 46, 46, 0.10), transparent 24%),
            linear-gradient(180deg, #fffaf8 0%, var(--edit-bg) 40%, #eef2f7 100%);
    }

    .edit-shell {
        padding: 28px 0 60px;
    }

    .edit-hero {
        background: linear-gradient(145deg, rgba(255,255,255,0.96), rgba(255,255,255,0.88));
        border: 1px solid rgba(255,255,255,0.76);
        border-radius: 32px;
        box-shadow: 0 28px 60px rgba(15, 23, 42, 0.09);
        padding: 30px;
        margin-bottom: 24px;
    }

    .edit-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        background: #fff4f1;
        color: var(--edit-primary-dark);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .edit-hero-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .edit-title {
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.04;
        font-weight: 900;
        color: var(--edit-text);
        margin-bottom: 10px;
    }

    .edit-desc {
        max-width: 760px;
        margin: 0;
        font-size: 15px;
        line-height: 1.8;
        color: var(--edit-muted);
    }

    .edit-back-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 48px;
        padding: 0 18px;
        border-radius: 16px;
        background: #fff;
        border: 1px solid var(--edit-line);
        color: var(--edit-text);
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
    }

    .edit-back-link:hover {
        color: var(--edit-primary-dark);
        background: #fff7f3;
        border-color: rgba(217, 46, 46, 0.18);
    }

    .edit-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 24px;
    }

    .edit-stat-card {
        padding: 20px 22px;
        border-radius: 24px;
        background: #fff;
        border: 1px solid var(--edit-line);
    }

    .edit-stat-label {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: var(--edit-muted);
        margin-bottom: 8px;
    }

    .edit-stat-value {
        font-size: clamp(24px, 3vw, 32px);
        line-height: 1.05;
        font-weight: 900;
        color: var(--edit-text);
    }

    .edit-stat-note {
        margin-top: 8px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--edit-muted);
    }

    .edit-layout {
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        gap: 24px;
    }

    .edit-panel {
        background: rgba(255,255,255,0.94);
        border: 1px solid rgba(255,255,255,0.74);
        border-radius: 30px;
        box-shadow: 0 24px 52px rgba(15, 23, 42, 0.08);
        padding: 26px;
    }

    .panel-kicker {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: var(--edit-primary-dark);
        margin-bottom: 8px;
    }

    .panel-title {
        font-size: 28px;
        line-height: 1.12;
        font-weight: 900;
        color: var(--edit-text);
        margin-bottom: 20px;
    }

    .form-grid {
        display: grid;
        gap: 18px;
    }

    .field-label {
        display: block;
        font-size: 13px;
        font-weight: 800;
        color: var(--edit-text);
        margin-bottom: 8px;
    }

    .field-input,
    .field-textarea,
    .field-select {
        width: 100%;
        border: 1px solid var(--edit-line);
        border-radius: 18px;
        background: #fff;
        color: var(--edit-text);
        padding: 14px 16px;
        font-size: 14px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .field-input:focus,
    .field-textarea:focus,
    .field-select:focus {
        outline: none;
        border-color: rgba(217, 46, 46, 0.35);
        box-shadow: 0 0 0 4px rgba(217, 46, 46, 0.10);
    }

    .field-textarea {
        min-height: 170px;
        resize: vertical;
        line-height: 1.75;
    }

    .field-select {
        min-height: 180px;
    }

    .field-help {
        margin-top: 8px;
        font-size: 12px;
        line-height: 1.7;
        color: var(--edit-muted);
    }

    .validation-note {
        display: block;
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .price-field {
        position: relative;
    }

    .price-currency {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 12px;
        font-weight: 800;
        color: var(--edit-muted);
        pointer-events: none;
    }

    .price-field .field-input {
        padding-right: 64px;
    }

    .edit-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .edit-action-primary,
    .edit-action-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 50px;
        padding: 0 22px;
        border-radius: 18px;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: 0.25s ease;
    }

    .edit-action-primary {
        border: none;
        background: linear-gradient(135deg, var(--edit-primary), var(--edit-primary-dark));
        color: #fff;
        box-shadow: 0 18px 34px rgba(217, 46, 46, 0.22);
    }

    .edit-action-primary:hover {
        color: #fff;
        transform: translateY(-1px);
    }

    .edit-action-secondary {
        background: #fff;
        color: var(--edit-text);
        border: 1px solid var(--edit-line);
    }

    .edit-action-secondary:hover {
        color: var(--edit-primary-dark);
        background: #fff7f3;
        border-color: rgba(217, 46, 46, 0.18);
    }

    .image-stack {
        display: grid;
        gap: 18px;
    }

    .main-preview {
        position: relative;
        min-height: 300px;
        border-radius: 26px;
        background: linear-gradient(180deg, #fff8f5, #f8fafc);
        border: 1px solid var(--edit-line);
        overflow: hidden;
    }

    .main-preview img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 22px;
    }

    .preview-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.94);
        color: var(--edit-primary-dark);
        font-size: 11px;
        font-weight: 800;
    }

    .thumb-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .thumb-item {
        height: 94px;
        border-radius: 20px;
        background: #fff;
        border: 1px solid var(--edit-line);
        overflow: hidden;
    }

    .thumb-item img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 10px;
    }

    .upload-box {
        border: 1px dashed rgba(217, 46, 46, 0.28);
        border-radius: 24px;
        background: #fff9f7;
        padding: 18px;
    }

    .upload-box input[type="file"] {
        width: 100%;
        border: 1px solid var(--edit-line);
        border-radius: 16px;
        background: #fff;
        padding: 14px;
        font-size: 14px;
    }

    .side-note {
        padding: 18px;
        border-radius: 22px;
        background: #fff;
        border: 1px solid var(--edit-line);
    }

    .side-note-title {
        font-size: 14px;
        font-weight: 900;
        color: var(--edit-text);
        margin-bottom: 8px;
    }

    .side-note p {
        margin: 0;
        font-size: 13px;
        line-height: 1.75;
        color: var(--edit-muted);
    }

    @@media (max-width: 991.98px) {
        .edit-stats,
        .edit-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .edit-shell {
            padding-top: 20px;
        }

        .edit-hero,
        .edit-panel {
            padding: 20px;
        }

        .thumb-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .edit-actions {
            flex-direction: column;
        }

        .edit-action-primary,
        .edit-action-secondary {
            width: 100%;
        }
    }

    /* ===== CHIP CHECKBOXES ===== */
    .category-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 8px;
    }

    .category-chip-label {
        cursor: pointer;
        user-select: none;
        margin: 0;
    }

    .category-chip-label input {
        display: none;
    }

    .category-chip-label .chip-text {
        display: inline-flex;
        align-items: center;
        padding: 8px 16px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid var(--edit-line);
        color: var(--edit-muted);
        font-size: 13px;
        font-weight: 700;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .category-chip-label:hover .chip-text {
        border-color: var(--edit-primary);
        color: var(--edit-primary);
    }

    .category-chip-label input:checked + .chip-text {
        background: var(--edit-primary);
        color: #fff;
        border-color: var(--edit-primary);
        box-shadow: 0 4px 12px rgba(217, 46, 46, 0.25);
    }

    .category-chip-label input:checked:hover + .chip-text {
        background: var(--edit-primary-dark);
        border-color: var(--edit-primary-dark);
        color: #fff;
    }
</style>

<div class="container edit-shell">
    <section class="edit-hero">
        <div class="edit-kicker"><i class="bi bi-pencil-square"></i> Product Editor</div>

        <div class="edit-hero-row">
            <div>
                <h1 class="edit-title">Tinh chỉnh sản phẩm</h1>
                <p class="edit-desc">Bạn có thể cập nhật tên, giá, mô tả, danh mục và bộ ảnh trong cùng một bố cục nhìn nhanh</p>
            </div>

            <a asp-action="Index" class="edit-back-link">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>

        <div class="edit-stats">
            <div class="edit-stat-card">
                <div class="edit-stat-label">Mã sản phẩm</div>
                <div class="edit-stat-value">GS-@Model.Id.ToString("0000")</div>
                <div class="edit-stat-note">Dùng để dò nhanh trong catalog quản trị.</div>
            </div>
            <div class="edit-stat-card">
                <div class="edit-stat-label">Giá hiện tại</div>
                <div class="edit-stat-value">@Model.Price.ToString("N0", new CultureInfo("vi-VN")) ₫</div>
                <div class="edit-stat-note">Bạn có thể cập nhật trực tiếp ở form bên dưới.</div>
            </div>
            <div class="edit-stat-card">
                <div class="edit-stat-label">Danh mục đã gắn</div>
                <div class="edit-stat-value">@selectedCategoryCount</div>
                <div class="edit-stat-note">Số danh mục hiện đang liên kết với sản phẩm này.</div>
            </div>
        </div>
    </section>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="edit-layout">
            <section class="edit-panel">
                <div class="panel-kicker">Product Form</div>
                <h2 class="panel-title">Thông tin cần cập nhật</h2>

                <div class="form-grid">
                    <div>
                        <label asp-for="Name" class="field-label">Tên sản phẩm</label>
                        <input asp-for="Name" class="field-input" placeholder="Nhập tên sản phẩm rõ ràng, dễ tìm kiếm" />
                        <span asp-validation-for="Name" class="text-danger validation-note"></span>
                    </div>

                    <div>
                        <label asp-for="Price" class="field-label">Giá bán</label>
                        <div class="price-field">
                            <input asp-for="Price" class="field-input" placeholder="Ví dụ: 15990000" />
                            <span class="price-currency">VNĐ</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger validation-note"></span>
                    </div>

                    <!-- ✨ Thêm Tồn Kho -->
                    <div>
                        <label class="field-label">Số lượng tồn kho</label>
                        <input type="number" name="stockQuantity" class="field-input" value="@(Model.Inventory?.StockQuantity ?? 0)" min="0" />
                    </div>

                    <div class="category-group">
                        <label class="field-label">Danh mục (Chọn nhiều)</label>
                        <div class="category-chips">
                            @if (ViewBag.CategoryList != null)
                            {
                                foreach (var item in (IEnumerable<SelectListItem>)ViewBag.CategoryList)
                                {
                                    <label class="category-chip-label">
                                        <input type="checkbox" name="categoryIds" value="@item.Value" @(item.Selected ? "checked" : "") />
                                        <span class="chip-text">@item.Text</span>
                                    </label>
                                }
                            }
                        </div>
                        <div class="field-help">Click trực tiếp vào từng thẻ để thêm hoặc gỡ danh mục. Rất trực quan và không cần giữ phím Ctrl.</div>
                    </div>

                    <div>
                        <label asp-for="Description" class="field-label">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="field-textarea" placeholder="Cập nhật mô tả chi tiết, điểm mạnh, nhóm khách hàng phù hợp và trải nghiệm sử dụng."></textarea>
                        <span asp-validation-for="Description" class="text-danger validation-note"></span>
                    </div>

                    <div class="edit-actions">
                        <button type="submit" class="edit-action-primary">
                            <i class="bi bi-check2-circle"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="edit-action-secondary">
                            <i class="bi bi-eye"></i> Xem trang chi tiết
                        </a>
                    </div>
                </div>
            </section>

            <aside class="edit-panel">
                <div class="panel-kicker">Visual Update</div>
                <h2 class="panel-title">Ảnh sản phẩm và preview</h2>

                <div class="image-stack">
                    <div class="main-preview">
                        <span class="preview-badge"><i class="bi bi-image"></i> Ảnh đại diện hiện tại</span>
                        <img src="@existingImages[0]" id="previewImage" alt="@Model.Name" onerror="this.src='/images/no-image.png'" />
                    </div>

                    <div class="thumb-grid" id="thumbGrid">
                        @if (existingImages.Count > 1)
                        {
                            @foreach (var image in existingImages.Take(6))
                            {
                                <div class="thumb-item">
                                    <img src="@image" alt="Thumbnail" onerror="this.src='/images/no-image.png'" />
                                </div>
                            }
                        }
                    </div>

                    <div class="upload-box">
                        <label class="field-label">Thay bộ ảnh mới</label>
                        <input type="file" name="imageFiles" id="imageInput" multiple accept="image/*" />
                        <div class="field-help">Nếu bạn chọn ảnh mới, hệ thống sẽ dùng bộ ảnh đó để thay thế ảnh hiện tại. Preview lớn sẽ đổi theo file đầu tiên bạn chọn.</div>
                    </div>

                    <div class="side-note">
                        <div class="side-note-title">Lưu ý khi chỉnh sửa</div>
                        <p>Tên sản phẩm nên rõ model, giá nên theo đúng mức bán thực tế, mô tả nên đủ ngắn để hiển thị card đẹp nhưng đủ chi tiết để trang chi tiết trông thuyết phục hơn. Nếu sản phẩm thuộc nhiều nhóm, hãy giữ các danh mục quan trọng nhất.</p>
                    </div>
                </div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imageInput = document.getElementById('imageInput');
        const previewImage = document.getElementById('previewImage');
        const thumbGrid = document.getElementById('thumbGrid');

        if (imageInput && previewImage && thumbGrid) {
            imageInput.addEventListener('change', function (event) {
                const files = Array.from(event.target.files || []);
                
                // Only clear the grid if the user selected new files
                if (files.length > 0) {
                    thumbGrid.innerHTML = '';
                } else {
                    return;
                }

                const firstReader = new FileReader();
                firstReader.onload = function (loadEvent) {
                    previewImage.src = loadEvent.target?.result;
                };
                firstReader.readAsDataURL(files[0]);

                files.slice(0, 6).forEach(function (file) {
                    const reader = new FileReader();
                    reader.onload = function (loadEvent) {
                        const item = document.createElement('div');
                        item.className = 'thumb-item';

                        const img = document.createElement('img');
                        img.src = loadEvent.target?.result;
                        img.alt = file.name;

                        item.appendChild(img);
                        thumbGrid.appendChild(item);
                    };
                    reader.readAsDataURL(file);
                });
            });
        }
    </script>
}