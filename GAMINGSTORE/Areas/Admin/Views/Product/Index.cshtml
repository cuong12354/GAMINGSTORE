        }

        .admin-hero {
            padding: 18px;
            margin-bottom: 18px;
            border-radius: 20px;
        }

        .admin-kicker {
            padding: 7px 12px;
            font-size: 10px;
            margin-bottom: 12px;
        }

        .admin-title-row {
            gap: 12px;
        }

        .admin-title {
            font-size: clamp(24px, 6vw, 32px);
            margin-bottom: 8px;
        }

        .admin-desc {
            font-size: 13px;
            line-height: 1.7;
        }

        .admin-create-btn {
            min-height: 44px;
            padding: 0 16px;
            font-size: 12px;
            border-radius: 12px;
        }

        .admin-stats {
            grid-template-columns: 1fr;
            gap: 12px;
            margin-top: 16px;
        }

        .admin-stat-card {
            padding: 14px 16px;
            border-radius: 16px;
        }

        .admin-stat-label {
            font-size: 10px;
            margin-bottom: 6px;
        }

        .admin-stat-value {
            font-size: clamp(20px, 5vw, 28px);
        }

        .admin-stat-desc {
            margin-top: 6px;
            font-size: 11px;
        }

        .catalog-panel {
            padding: 16px;
            border-radius: 18px;
            margin: 0 -12px;
        }

        .catalog-toolbar {
            gap: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .catalog-heading {
            font-size: 20px;
            margin: 0;
        }

        .catalog-subheading {
            margin-top: 4px;
            font-size: 12px;
        }

        .catalog-pill {
            min-height: 32px;
            padding: 0 12px;
            font-size: 11px;
        }

        .admin-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }

        .admin-product-card {
            border-radius: 16px;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
        }

        .admin-product-thumb {
            height: 160px;
        }

        .admin-product-thumb img {
            padding: 12px;
        }

        .admin-product-badge {
            top: 8px;
            left: 8px;
            min-height: 28px;
            padding: 0 10px;
            font-size: 11px;
            border-radius: 999px;
        }

        .admin-product-content {
            padding: 12px;
        }

        .admin-product-title {
            font-size: 12px;
            margin-bottom: 6px;
            line-height: 1.4;
        }

        .admin-product-price {
            font-size: 13px;
            margin-bottom: 8px;
        }

        .admin-product-rating {
            font-size: 11px;
            margin-bottom: 8px;
        }

        .admin-product-actions {
            gap: 6px;
        }

        .admin-action-btn {
            min-height: 34px;
            padding: 0 10px;
            font-size: 11px;
            border-radius: 8px;
        }

        .admin-action-btn i {
            font-size: 12px;
        }

        .empty-catalog {
            padding: 48px 16px;
            margin: 0 -12px;
            border-radius: 0;
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .empty-catalog h3 {
            font-size: 16px;
        }

        .empty-catalog p {
            font-size: 12px;
        }

        .back-btn {
