@model IEnumerable<GAMINGSTORE.Models.Product>
@using System.Globalization

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";

    string GetFirstImage(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return "/images/no-image.png";
        }

        return imageUrl
            .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault() ?? "/images/no-image.png";
    }

    string GetShortDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return "Sản phẩm đang hiển thị trên catalog và sẵn sàng được chỉnh sửa thêm nội dung nếu cần.";
        }

        var normalized = description.Trim();
        return normalized.Length > 110 ? normalized[..107].TrimEnd() + "..." : normalized;
    }

    var totalProducts = Model.Count();
    var categorizedProducts = Model.Count(p => p.Categories?.Any() == true);
    var averagePrice = totalProducts > 0 ? Model.Average(p => p.Price) : 0m;
}

<style>
    :root {
        --admin-primary: #d92e2e;
        --admin-primary-dark: #c43a20;
        --admin-text: #18212f;
        --admin-muted: #64748b;
        --admin-line: rgba(15, 23, 42, 0.08);
        --admin-bg: #f5f7fb;
        --admin-danger: #dc2626;
    }

    body {
        background:
            radial-gradient(circle at top right, rgba(217, 46, 46, 0.10), transparent 24%),
            linear-gradient(180deg, #fffaf8 0%, var(--admin-bg) 38%, #eff2f7 100%);
    }

    .admin-shell {
        padding: 28px 0 60px;
    }

    .admin-hero {
        background: linear-gradient(145deg, rgba(255,255,255,0.96), rgba(255,255,255,0.88));
        border: 1px solid rgba(255,255,255,0.76);
        border-radius: 32px;
        box-shadow: 0 28px 60px rgba(15, 23, 42, 0.09);
        padding: 30px;
        margin-bottom: 24px;
    }

    .admin-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        background: #fff4f1;
        color: var(--admin-primary-dark);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .admin-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .admin-title {
        font-size: clamp(32px, 4vw, 46px);
        line-height: 1.03;
        font-weight: 900;
        color: var(--admin-text);
        margin-bottom: 10px;
    }

    .admin-desc {
        max-width: 760px;
        margin: 0;
        font-size: 15px;
        line-height: 1.8;
        color: var(--admin-muted);
    }

    .admin-create-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 52px;
        padding: 0 22px;
        border-radius: 18px;
        background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-dark));
        color: #fff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
        box-shadow: 0 18px 34px rgba(217, 46, 46, 0.22);
    }

    .admin-create-btn:hover {
        color: #fff;
        transform: translateY(-1px);
    }

    .admin-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 24px;
    }

    .admin-stat-card {
        padding: 20px 22px;
        border-radius: 24px;
        background: #fff;
        border: 1px solid var(--admin-line);
    }

    .admin-stat-label {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: var(--admin-muted);
        margin-bottom: 8px;
    }

    .admin-stat-value {
        font-size: clamp(26px, 3vw, 34px);
        line-height: 1;
        font-weight: 900;
        color: var(--admin-text);
    }

    .admin-stat-desc {
        margin-top: 8px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--admin-muted);
    }

    .catalog-panel {
        background: rgba(255,255,255,0.94);
        border: 1px solid rgba(255,255,255,0.74);
        border-radius: 30px;
        box-shadow: 0 24px 52px rgba(15, 23, 42, 0.08);
        padding: 26px;
    }

    .catalog-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .catalog-heading {
        font-size: 28px;
        font-weight: 900;
