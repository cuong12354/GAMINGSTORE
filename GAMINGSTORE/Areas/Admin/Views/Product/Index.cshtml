            padding: 0 14px;
            font-size: 12px;
        }
    }

    @@media (max-width: 480px) {
        .admin-shell {
            padding: 12px 0 32px;
        }

        .admin-hero {
            padding: 14px;
            margin-bottom: 14px;
            border-radius: 16px;
        }

        .admin-title {
            font-size: clamp(20px, 5vw, 24px);
        }

        .admin-title-row {
            flex-direction: column;
            gap: 10px;
        }

        .admin-desc {
            font-size: 12px;
        }

        .admin-create-btn {
            width: 100%;
            min-height: 40px;
            margin-top: 8px;
        }

        .admin-stats {
            gap: 10px;
            margin-top: 14px;
        }

        .admin-stat-card {
            padding: 12px 14px;
        }

        .admin-stat-value {
            font-size: clamp(18px, 4vw, 24px);
        }

        .catalog-panel {
            padding: 12px;
            margin: 0 -12px;
            border-radius: 14px;
        }

        .catalog-toolbar {
            gap: 8px;
            margin-bottom: 12px;
        }

        .catalog-heading {
            font-size: 18px;
            width: 100%;
        }

        .catalog-subheading {
            width: 100%;
            font-size: 11px;
        }

        .admin-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 10px;
        }

        .admin-product-card {
            border-radius: 12px;
        }

        .admin-product-thumb {
            height: 140px;
        }

        .admin-product-thumb img {
            padding: 8px;
        }

        .admin-product-badge {
            top: 6px;
            left: 6px;
            min-height: 26px;
            padding: 0 8px;
            font-size: 10px;
        }

        .admin-product-content {
            padding: 10px;
        }

        .admin-product-title {
            font-size: 11px;
            margin-bottom: 4px;
            line-height: 1.3;
            max-height: 33px;
            overflow: hidden;
        }

        .admin-product-price {
            font-size: 12px;
            margin-bottom: 6px;
            font-weight: 900;
        }

        .admin-product-rating {
            font-size: 10px;
            margin-bottom: 6px;
        }

        .admin-product-actions {
            gap: 4px;
            flex-wrap: wrap;
        }

        .admin-action-btn {
            flex: 1;
            min-height: 32px;
            padding: 0 8px;
            font-size: 10px;
            border-radius: 6px;
        }

        .empty-catalog {
            padding: 40px 12px;
            margin: 0 -12px;
        }

        .empty-icon {
            font-size: 40px;
        }

        .empty-catalog h3 {
            font-size: 14px;
        }

        .empty-catalog p {
            font-size: 11px;
        }

        .back-btn {
            width: 100%;
            min-height: 40px;
        }
    }

    /* Tooltip styles */
    .tooltip-container {
        position: relative;
        cursor: help;
    }

    .tooltip-content {
        position: absolute;
        bottom: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%) translateY(8px);
        background: #fff;
        border: 1px solid var(--admin-line);
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.12);
        border-radius: 16px;
        padding: 16px;
        width: 260px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        z-index: 100;
        pointer-events: none;
    }

    .tooltip-container:hover .tooltip-content {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    .tooltip-content::before {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border-width: 8px;
        border-style: solid;
        border-color: #fff transparent transparent transparent;
        z-index: 2;
    }

    .tooltip-content::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(1px);
        border-width: 8px;
        border-style: solid;
        border-color: var(--admin-line) transparent transparent transparent;
        z-index: 1;
    }

    .tooltip-item {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
        line-height: 1.4;
    }

    .tooltip-item:last-child {
        margin-bottom: 0;
    }

    .tooltip-label {
        font-weight: 800;
        color: var(--admin-muted);
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 0.5px;
        width: 75px;
        flex-shrink: 0;
    }

    .tooltip-value {
        font-weight: 700;
        color: var(--admin-text);
        text-align: right;
        font-size: 12px;
    }

</style>

<div class="container admin-shell">
    <section class="admin-hero">
        <div class="admin-kicker"><i class="bi bi-box-seam"></i> Product Control Center</div>

        <div class="admin-title-row">
            <div>
                <h1 class="admin-title">Quản lý sản phẩm</h1>
                <p class="admin-desc">Bạn có thể quét nhanh ảnh, danh mục, giá, mô tả ngắn và thao tác sửa, xem, xóa ngay trên từng card mà vẫn đồng bộ với trải nghiệm ngoài trang bán hàng.</p>
            </div>

            @if (User.HasPermission(PermissionConstants.ProductManage))
            {
                <a asp-action="Create" class="admin-create-btn">
                    <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
                </a>
            }
        </div>

        <div class="admin-stats">
            <div class="admin-stat-card">
                <div class="admin-stat-label">Tổng sản phẩm</div>
                <div class="admin-stat-value">@totalProducts</div>
                <div class="admin-stat-desc">Số sản phẩm hiện có trong catalog quản lý.</div>
            </div>
            <div class="admin-stat-card">
                <div class="admin-stat-label">Đã phân loại</div>
                <div class="admin-stat-value">@categorizedProducts</div>
                <div class="admin-stat-desc">Sản phẩm đã gắn ít nhất một danh mục để hiển thị storefront.</div>
            </div>
            <div class="admin-stat-card">
                <div class="admin-stat-label">Giá trung bình</div>
                <div class="admin-stat-value">@averagePrice.ToString("N0", new CultureInfo("vi-VN")) ₫</div>
                <div class="admin-stat-desc">Snapshot nhanh giúp bạn rà mặt bằng giá hiện tại.</div>
            </div>
        </div>
    </section>

    <section class="catalog-panel">
        <div class="catalog-toolbar">
            <div>
                <h2 class="catalog-heading">Quản lý sản phẩm</h2>
                <p class="catalog-subheading">Xem nhanh toàn bộ sản phẩm với card trực quan, phù hợp khi rà ảnh, nội dung và mức giá.</p>
            </div>
            <div class="catalog-pill"><i class="bi bi-grid-3x3-gap"></i> @totalProducts sản phẩm đang hiển thị</div>
        </div>

        @if (Model.Any())
        {
            var groupedProducts = Model
                .GroupBy(p => p.Categories?.FirstOrDefault()?.Name ?? "Chưa phân loại")
                .OrderBy(g => g.Key == "Chưa phân loại" ? 1 : 0) // Put "Uncategorized" at the bottom
                .ThenBy(g => g.Key);

            foreach (var group in groupedProducts)
            {
                <div style="margin-top: 36px; margin-bottom: 20px;">
                    <h3 style="font-size: 20px; font-weight: 900; color: var(--admin-text); display: flex; align-items: center; gap: 10px; margin: 0;">
                        <i class="bi bi-folder2-open" style="color: var(--admin-primary);"></i>
                        @group.Key
                        <span style="font-size: 12px; font-weight: 800; padding: 4px 10px; background: #fff4f1; color: var(--admin-primary-dark); border-radius: 999px; margin-left: auto;">@group.Count() sản phẩm</span>
                    </h3>
                    <hr style="border-top: 1px dashed var(--admin-line); margin: 12px 0 0 0;" />
                </div>

                <div class="admin-grid">
                    @foreach (var product in group)
                    {
                        <article class="admin-product-card">
                            <div class="admin-product-thumb">
                                <img src="@GetFirstImage(product.ImageUrl)" alt="@product.Name" onerror="this.src='/images/no-image.png'">
                                <span class="admin-product-badge"><i class="bi bi-stars"></i> @(product.Categories?.FirstOrDefault()?.Name ?? "Chưa phân loại")</span>
                                <span class="admin-product-id">GS-@product.Id.ToString("0000")</span>
                            </div>

                            <div class="admin-product-body">
                                <div class="admin-product-name">@product.Name</div>

                                <div class="admin-product-categories">
                                    @if (product.Categories?.Any() == true)
                                    {
                                        @foreach (var category in product.Categories.Take(3))
                                        {
                                            <span class="admin-category-chip">@category.Name</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="admin-category-chip">Chưa phân loại</span>
                                    }
                                </div>

                                <div class="admin-product-description">@GetShortDescription(product.Description)</div>

                                <div class="admin-meta">
                                    <span class="admin-meta-pill"><i class="bi bi-image"></i> @(string.IsNullOrWhiteSpace(product.ImageUrl) ? "Chưa có ảnh" : "Đã có ảnh")</span>
                                    
                                    <div class="admin-meta-pill tooltip-container">
                                        <i class="bi bi-diagram-3"></i> @(product.Categories?.Count ?? 0) danh mục
                                        <div class="tooltip-content">
                                            <div class="tooltip-item">
                                                <span class="tooltip-label">Tồn kho</span>
                                                <span class="tooltip-value">@(product.Inventory?.StockQuantity.ToString() ?? "N/A")</span>
                                            </div>
                                            <div class="tooltip-item">
                                                <span class="tooltip-label">Danh mục</span>
                                                <span class="tooltip-value">@(product.Categories != null && product.Categories.Any() ? string.Join(", ", product.Categories.Select(c => c.Name)) : "Chưa có")</span>
                                            </div>
                                            <div class="tooltip-item">
                                                <span class="tooltip-label">Trạng thái</span>
                                                <span class="tooltip-value" style="color: @(product.IsActive ? "var(--admin-primary)" : "var(--admin-muted)");">
                                                    @(product.IsActive ? "Đang bán" : "Ngừng bán")
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    @if (product.ReviewCount > 0)
                                    {
                                        <span class="admin-meta-pill" style="color: #fbbf24;">
                                            ⭐ @product.AverageRating.ToString("F1") (@product.ReviewCount)
                                        </span>
                                    }
                                </div>

                                <div class="admin-product-price">@Math.Round(product.Price, 0).ToString("N0", new CultureInfo("vi-VN")) ₫</div>
                                <div class="admin-product-note">Card quản trị đồng bộ với phong cách giao diện bán hàng hiện tại.</div>

                                <div class="admin-actions">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="admin-action admin-action-view">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="admin-action admin-action-edit">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="admin-action admin-action-delete">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inboxes"></i>
                <div class="empty-title">Chưa có sản phẩm nào trong catalog</div>
                <div class="empty-desc">Hãy thêm sản phẩm đầu tiên để bắt đầu quản lý hình ảnh, nội dung, danh mục và mức giá trong cùng một khu vực trực quan hơn.</div>
                @if (User.HasPermission(PermissionConstants.ProductManage))
                {
                    <a asp-action="Create" class="admin-create-btn">
                        <i class="bi bi-plus-circle"></i> Thêm sản phẩm đầu tiên
                    </a>
                }
            </div>
        }
    </section>
</div>