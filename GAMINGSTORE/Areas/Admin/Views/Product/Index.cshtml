    }

    .admin-action-edit {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.18);
    }

    .admin-action-edit:hover {
        color: #1d4ed8;
        background: rgba(37, 99, 235, 0.18);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.15);
