    }

    .catalog-subheading {
        margin: 6px 0 0;
        font-size: 14px;
        color: var(--admin-muted);
    }

    .catalog-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        background: #fff4f1;
        color: var(--admin-primary-dark);
        font-size: 12px;
        font-weight: 800;
    }

    .admin-grid {
        display: grid;
