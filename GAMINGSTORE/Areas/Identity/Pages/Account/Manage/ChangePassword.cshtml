@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    .manage-shell {
        max-width: 1060px;
        margin: 36px auto;
        padding: 0 24px 0 42px;
    }

    .manage-header,
    .manage-nav-card,
    .manage-content-card,
    .password-note {
        background: #fff;
        border-radius: 22px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }

    .manage-header {
        padding: 28px;
        margin-bottom: 24px;
        background: radial-gradient(circle at top right, rgba(33, 34, 69, 0.14), transparent 28%), linear-gradient(135deg, #f8f8ff, #ffffff);
        border: 1px solid rgba(33, 34, 69, 0.08);
    }

    .manage-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 34px;
        padding: 0 14px;
        border-radius: 999px;
        background: rgba(33, 34, 69, 0.08);
        color: #212245;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 14px;
    }

    .manage-title {
        font-size: 30px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 10px;
    }

    .manage-text {
        color: #6b7280;
        font-size: 15px;
        line-height: 1.75;
        max-width: 680px;
        margin: 0;
    }

    .manage-grid {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 20px;
    }

    .manage-nav-card {
        padding: 16px;
        height: fit-content;
    }

    .manage-content-card {
        padding: 24px;
    }

    .content-title {
        font-size: 24px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 8px;
    }

    .content-subtitle {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 22px;
    }

    .status-wrap {
        margin-bottom: 18px;
    }

    .validation-summary-box {
        border-radius: 14px;
        padding: 12px 14px;
        background: #fff1f0;
        border: 1px solid #ffd7d2;
        margin-bottom: 20px;
    }

    .field-grid {
        display: grid;
        gap: 18px;
    }

    .field-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 8px;
    }

    .field-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 56px;
        padding: 0 16px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: #fff;
        transition: all 0.25s ease;
    }

    .field-wrap:focus-within {
        border-color: #d92e2e;
        box-shadow: 0 0 0 4px rgba(217, 46, 46, 0.12);
    }

    .field-wrap i {
        color: #9ca3af;
    }

    .field-wrap input {
        border: none;
        box-shadow: none;
        padding: 0;
        background: transparent;
    }

    .field-wrap input:focus {
        box-shadow: none;
    }

    .save-btn {
        border: none;
        border-radius: 16px;
        padding: 14px 20px;
        background: linear-gradient(135deg, #d92e2e, #b82222);
        color: #fff;
        font-weight: 800;
        font-size: 15px;
        min-width: 240px;
        box-shadow: 0 14px 28px rgba(217, 46, 46, 0.18);
        margin-top: 10px;
    }

    .password-note {
        padding: 18px;
        background: linear-gradient(180deg, #212245, #2f325f);
        color: #fff;
        margin-top: 18px;
    }

    .password-note-title {
        font-size: 16px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .password-note ul {
        margin: 0;
        padding-left: 18px;
        color: rgba(255,255,255,0.82);
        line-height: 1.75;
        font-size: 14px;
    }

    @@media (max-width: 991px) {
        .manage-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .manage-shell {
            padding: 0 14px;
        }

        .manage-header,
        .manage-content-card {
            padding: 22px;
        }

        .manage-title {
            font-size: 26px;
        }
    }
</style>

<div class="manage-shell">
    <div class="manage-header">
        <div class="manage-tag"><i class="bi bi-shield-lock"></i> Security</div>
        <div class="manage-title">Đổi mật khẩu để bảo vệ tài khoản</div>
        <p class="manage-text">Nếu bạn nghi ngờ tài khoản đã lộ thông tin hoặc chỉ đơn giản muốn tăng độ an toàn, hãy cập nhật mật khẩu mới ngay tại đây.</p>
    </div>

    <div class="manage-grid">
        <aside class="manage-nav-card">
            <partial name="_ManageNav" />
        </aside>

        <section>
            <div class="manage-content-card">
                <div class="content-title">Thay đổi mật khẩu</div>
                <div class="content-subtitle">Nhập mật khẩu hiện tại để xác minh, sau đó thiết lập mật khẩu mới cho tài khoản của bạn.</div>

                <div class="status-wrap">
                    <partial name="_StatusMessage" for="StatusMessage" />
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary-box" role="alert"></div>

                    <div class="field-grid">
                        <div>
                            <label asp-for="Input.OldPassword" class="field-label">Mật khẩu hiện tại</label>
                            <div class="field-wrap">
                                <i class="bi bi-lock"></i>
                                <input asp-for="Input.OldPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại" />
                            </div>
                            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="Input.NewPassword" class="field-label">Mật khẩu mới</label>
                            <div class="field-wrap">
                                <i class="bi bi-key"></i>
                                <input asp-for="Input.NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                            </div>
                            <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="Input.ConfirmPassword" class="field-label">Xác nhận mật khẩu mới</label>
                            <div class="field-wrap">
                                <i class="bi bi-patch-check"></i>
                                <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="save-btn">Cập nhật mật khẩu</button>
                </form>
            </div>

            <div class="password-note">
                <div class="password-note-title">Mật khẩu nên có</div>
                <ul>
                    <li>Tối thiểu 6 ký tự và đủ khác với mật khẩu cũ.</li>
                    <li>Kết hợp chữ hoa, chữ thường, số hoặc ký tự đặc biệt nếu có thể.</li>
                    <li>Không dùng lại mật khẩu bạn đang dùng cho các dịch vụ khác.</li>
                </ul>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}