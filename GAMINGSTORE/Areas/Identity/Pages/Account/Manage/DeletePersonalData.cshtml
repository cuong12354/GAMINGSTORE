@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Xóa tài khoản";
    ViewData["ActivePage"] = ManageNavPages.DeletePersonalData;
}

<style>
    .delete-shell {
        max-width: 720px;
        margin: 36px auto;
        padding: 0 18px;
    }

    .delete-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
        border: 1px solid rgba(180, 35, 24, 0.14);
        overflow: hidden;
    }

    .delete-head {
        padding: 28px;
        background: linear-gradient(135deg, #fff4f2, #ffffff);
        border-bottom: 1px solid rgba(180, 35, 24, 0.1);
    }

    .delete-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 34px;
        padding: 0 14px;
        border-radius: 999px;
        background: rgba(180, 35, 24, 0.1);
        color: #b42318;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 14px;
    }

    .delete-title {
        font-size: 30px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 10px;
    }

    .delete-text {
        color: #6b7280;
        line-height: 1.75;
        margin: 0;
    }

    .delete-body {
        padding: 24px 28px 28px;
    }

    .warning-box {
        border-radius: 16px;
        padding: 16px 18px;
        background: #fff7f6;
        border: 1px solid #ffd7d2;
        color: #6b7280;
        line-height: 1.75;
        margin-bottom: 22px;
    }

    .validation-summary-box {
        border-radius: 14px;
        padding: 12px 14px;
        background: #fff1f0;
        border: 1px solid #ffd7d2;
        margin-bottom: 20px;
    }

    .field-label {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 8px;
    }

    .field-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 56px;
        padding: 0 16px;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: #fff;
        transition: all 0.25s ease;
    }

    .field-wrap:focus-within {
        border-color: #b42318;
        box-shadow: 0 0 0 4px rgba(180, 35, 24, 0.12);
    }

    .field-wrap i {
        color: #9ca3af;
    }

    .field-wrap input {
        border: none;
        box-shadow: none;
        padding: 0;
        background: transparent;
    }

    .delete-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .delete-btn,
    .cancel-btn {
        min-height: 48px;
        padding: 0 18px;
        border-radius: 16px;
        font-weight: 800;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
    }

    .delete-btn {
        background: linear-gradient(135deg, #d63d1f, #b42318);
        color: #fff;
        box-shadow: 0 14px 28px rgba(180, 35, 24, 0.2);
    }

    .cancel-btn {
        background: #edf1f5;
        color: #111827;
    }
</style>

<div class="delete-shell">
    <div class="delete-card">
        <div class="delete-head">
            <div class="delete-tag"><i class="bi bi-exclamation-triangle"></i> Dangerous action</div>
            <div class="delete-title">Xóa tài khoản của bạn</div>
            <p class="delete-text">Thao tác này sẽ xóa tài khoản đăng nhập hiện tại khỏi hệ thống. Hãy chắc chắn rằng bạn thực sự muốn tiếp tục.</p>
        </div>

        <div class="delete-body">
            <div class="warning-box">
                Sau khi xóa tài khoản, bạn sẽ không thể dùng lại phiên đăng nhập hiện tại. Nếu mục tiêu của bạn chỉ là cập nhật thông tin, hãy quay lại trang hồ sơ thay vì xóa tài khoản.
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary-box" role="alert"></div>

                @if (Model.RequirePassword)
                {
                    <div>
                        <label asp-for="Input.Password" class="field-label">Nhập mật khẩu để xác nhận</label>
                        <div class="field-wrap">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Input.Password" class="form-control" placeholder="Mật khẩu hiện tại" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                }

                <div class="delete-actions">
                    <button type="submit" class="delete-btn">Xóa tài khoản vĩnh viễn</button>
                    <a asp-page="./PersonalData" class="cancel-btn">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}