@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Đăng nhập bên ngoài";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Đăng nhập bằng @Model.ProviderDisplayName</h4>
                    
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    <p>Bạn đã đăng nhập thành công bằng <strong>@Model.ProviderDisplayName</strong>.</p>
                    <p>Vui lòng chờ trong khi chúng tôi xử lý thông tin đăng nhập của bạn...</p>

                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
