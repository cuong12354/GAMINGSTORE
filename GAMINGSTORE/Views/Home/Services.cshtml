@{
    ViewData["Title"] = "Dịch vụ - GAMINGSTORE";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="row mb-5">
        <div class="col-lg-12">
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="bi bi-wrench-adjustable text-danger me-2"></i>DỊCH VỤ GAMINGSTORE
                </h1>
                <p class="lead text-muted">
                    Chúng tôi cung cấp các dịch vụ chuyên nghiệp để giúp bạn duy trì và nâng cấp hệ thống máy tính
                </p>
            </div>
        </div>
    </div>

    <!-- Services Grid -->
    <div class="row g-4 mb-5">
        <!-- Service 1: Computer Cleaning -->
        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm border-0 service-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="service-icon bg-danger bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="bi bi-droplet-fill text-danger fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0">Vệ sinh máy tính</h5>
                    </div>
                    <p class="card-text text-muted mb-3">
                        Dịch vụ vệ sinh chuyên sâu cho máy tính, laptop và các thiết bị điện tử. Loại bỏ bụi, tạp chí, 
                        giúp máy tính hoạt động mát mẻ và ổn định hơn.
                    </p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-check-circle text-success me-2"></i>Vệ sinh quạt tản nhiệt</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Thay keo tản nhiệt</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Làm sạch bộ lọc không khí</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Kiểm tra hệ thống làm mát</li>
                    </ul>
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-danger">Từ 150.000đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 2: System Maintenance -->
        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm border-0 service-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="service-icon bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="bi bi-gear-fill text-primary fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0">Bảo trì hệ thống</h5>
                    </div>
                    <p class="card-text text-muted mb-3">
                        Kiểm tra và bảo trì toàn bộ hệ thống máy tính. Cập nhật driver, phần mềm, loại bỏ malware 
                        và tối ưu hóa hiệu suất.
                    </p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-check-circle text-success me-2"></i>Cập nhật driver thiết bị</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Quét và loại bỏ malware</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Tối ưu hóa hệ thống</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Kiểm tra sức khỏe ổ cứng</li>
                    </ul>
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-primary">Từ 200.000đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 3: Hardware Upgrade -->
        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm border-0 service-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="service-icon bg-success bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="bi bi-cpu-fill text-success fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0">Nâng cấp phần cứng</h5>
                    </div>
                    <p class="card-text text-muted mb-3">
                        Tư vấn và lắp đặt các linh kiện máy tính. Nâng cấp RAM, SSD, VGA, CPU để cải thiện hiệu suất 
                        máy tính của bạn.
                    </p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-check-circle text-success me-2"></i>Tư vấn cấu hình phù hợp</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Lắp đặt linh kiện chuyên nghiệp</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Kiểm tra ổn định sau lắp</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Hỗ trợ bảo hành linh kiện</li>
                    </ul>
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-success">Tùy theo linh kiện</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 4: Data Recovery -->
        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm border-0 service-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="service-icon bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="bi bi-cloud-arrow-down-fill text-warning fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0">Phục hồi dữ liệu</h5>
                    </div>
                    <p class="card-text text-muted mb-3">
                        Dịch vụ phục hồi dữ liệu từ ổ cứng, SSD, USB bị hỏng hoặc xóa nhầm. Đội ngũ chuyên gia 
                        sẽ giúp bạn lấy lại dữ liệu quan trọng.
                    </p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-check-circle text-success me-2"></i>Phục hồi từ ổ cứng hỏng</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Lấy dữ liệu từ USB/thẻ nhớ</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Sao lưu dữ liệu an toàn</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Tư vấn giải pháp sao lưu</li>
                    </ul>
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-warning">Từ 300.000đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 5: Software Installation -->
        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm border-0 service-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="service-icon bg-info bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="bi bi-window-stack text-info fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0">Cài đặt phần mềm</h5>
                    </div>
                    <p class="card-text text-muted mb-3">
                        Cài đặt và cấu hình các phần mềm chuyên dụng. Từ hệ điều hành, phần mềm văn phòng đến 
                        phần mềm chuyên nghiệp cho thiết kế, lập trình.
                    </p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-check-circle text-success me-2"></i>Cài đặt Windows/Linux</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Cài phần mềm văn phòng</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Cài phần mềm chuyên dụng</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Cấu hình môi trường phát triển</li>
                    </ul>
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-info">Từ 100.000đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Service 6: Gaming Setup -->
        <div class="col-lg-6 col-md-12">
            <div class="card h-100 shadow-sm border-0 service-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="service-icon bg-danger bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="bi bi-joystick text-danger fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0">Thiết lập Gaming</h5>
                    </div>
                    <p class="card-text text-muted mb-3">
                        Tư vấn và thiết lập hệ thống gaming tối ưu. Cài đặt driver GPU, tối ưu cài đặt game, 
                        kiểm tra hiệu suất FPS.
                    </p>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-check-circle text-success me-2"></i>Cài driver GPU mới nhất</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Tối ưu cài đặt game</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Kiểm tra FPS và hiệu suất</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Thiết lập RGB lighting</li>
                    </ul>
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-danger">Từ 250.000đ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Process Section -->
    <div class="row mb-5">
        <div class="col-lg-12">
            <div class="bg-light p-5 rounded-3">
                <h3 class="mb-4 fw-bold">
                    <i class="bi bi-diagram-3 text-primary me-2"></i>Quy trình dịch vụ của chúng tôi
                </h3>
                <div class="row g-4">
                    <div class="col-md-3 text-center">
                        <div class="mb-3">
                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px;">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                        </div>
                        <h6 class="fw-bold">Bước 1: Liên hệ</h6>
                        <p class="text-muted small">Gọi hoặc chat với chúng tôi để tư vấn dịch vụ phù hợp</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="mb-3">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px;">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                        </div>
                        <h6 class="fw-bold">Bước 2: Đặt lịch</h6>
                        <p class="text-muted small">Chọn thời gian phù hợp để nhận dịch vụ</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="mb-3">
                            <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px;">
                                <i class="bi bi-tools"></i>
                            </div>
                        </div>
                        <h6 class="fw-bold">Bước 3: Thực hiện</h6>
                        <p class="text-muted small">Đội kỹ thuật chuyên nghiệp thực hiện dịch vụ</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="mb-3">
                            <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px;">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                        </div>
                        <h6 class="fw-bold">Bước 4: Hoàn thành</h6>
                        <p class="text-muted small">Kiểm tra chất lượng và bàn giao cho khách hàng</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Section -->
    <div class="row">
        <div class="col-lg-12">
            <div class="bg-gradient-primary p-5 rounded-3 text-white">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h3 class="mb-3 fw-bold">Cần dịch vụ ngay?</h3>
                        <p class="mb-0 lead">
                            Liên hệ với chúng tôi để được tư vấn miễn phí và nhận ưu đãi đặc biệt cho khách hàng thân thiết.
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="tel:0123456789" class="btn btn-light btn-lg fw-bold me-2">
                            <i class="bi bi-telephone me-2"></i>Gọi ngay
                        </a>
                        <a href="https://zalo.me/0123456789" class="btn btn-outline-light btn-lg fw-bold">
                            <i class="bi bi-chat-dots me-2"></i>Chat Zalo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .service-card {
        transition: all 0.3s ease;
    }

    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
    }

    .service-icon {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    }
</style>
