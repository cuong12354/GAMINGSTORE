@model IEnumerable<GAMINGSTORE.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "Trang chủ";
    int numOfQuantity = 1;
}

<style>
    body {
        background: #f5f5f5;
    }

    /* ===== BANNER ===== */
    .banner-img {
        height: 350px; /* Bạn có thể chỉnh lại chiều cao tùy ý */
        object-fit: cover; /* Chống méo ảnh */
    }

    /* Kéo dài thời gian hiệu ứng Fade để mượt hơn (Mặc định của Bootstrap hơi nhanh) */
    .carousel-fade .carousel-item {
        transition: opacity 0.8s ease-in-out !important; /* 0.8s là thời gian chuyển cảnh, có thể tăng lên 1s nếu thích chậm hơn */
    }

    /* Làm cho 2 nút Next/Prev dễ bấm hơn và đẹp hơn */
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0,0,0,0.6);
        border-radius: 50%;
        padding: 22px;
    }

    /* ===== CATEGORY ICON ===== */
    .category-box {
        background: white;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        transition: 0.3s;
        cursor: pointer;
    }

        .category-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

    /* ===== PRODUCT ===== */
    .product-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
        }

    .product-img {
        height: 200px;
        object-fit: cover;
    }

    .price {
        color: #ee4d2d;
        font-weight: bold;
    }

    .old-price {
        text-decoration: line-through;
        color: gray;
        font-size: 13px;
    }

    .badge-sale {
        position: absolute;
        top: 10px;
        left: 0;
        background: red;
        color: white;
        padding: 3px 6px;
        font-size: 12px;
    }

    /* ===== SECTION TITLE ===== */
    .section-title {
        font-size: 20px;
        font-weight: bold;
        margin: 20px 0 10px;
    }

    .hover-dropdown .dropdown-menu {
        display: block;
        visibility: hidden;
        opacity: 0;
        transform: translateY(15px); /* Đẩy menu xuống một chút để tạo hiệu ứng trượt lên */
        transition: all 0.4s ease; /* 0.4s là tốc độ biến mất từ từ (bạn có thể tăng lên 0.5s nếu muốn chậm hơn) */
        margin-top: 0;
        border: none;
    }

        /* Tạo một cầu nối vô hình giữa nút và menu để khi di chuột xuống không bị mất menu */
        .hover-dropdown .dropdown-menu::before {
            content: '';
            position: absolute;
            top: -10px;
            left: 0;
            width: 100%;
            height: 10px;
            background: transparent;
        }

    /* Khi di chuột vào khu vực dropdown */
    .hover-dropdown:hover .dropdown-menu {
        visibility: visible;
        opacity: 1;
        transform: translateY(0); /* Trượt về vị trí cũ */
    }

    /* Làm đẹp thẻ category-box một chút cho đồng bộ */
    .category-box {
        background: #fff;
        border-radius: 10px;
        padding: 12px 10px;
        text-align: center;
        cursor: pointer;
        font-weight: 600;
        border: 1px solid #eaeaea;
        transition: all 0.3s ease;
    }

    .hover-dropdown:hover .category-box {
        background-color: #f8f9fa;
        box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }

</style>

<!-- ================= BANNER SLIDER ================= -->
<div class="container mt-3">
    <div id="bannerCarousel" class="carousel slide carousel-fade shadow-sm rounded overflow-hidden" data-bs-ride="carousel" data-bs-interval="3000">

        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/banner/banner1.jpg" class="d-block w-100 banner-img" alt="Banner 1">
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/banner2.jpg" class="d-block w-100 banner-img" alt="Banner 2">
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/banner3.jpg" class="d-block w-100 banner-img" alt="Banner 3">
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>

    </div>
</div>

    <!-- ================= CATEGORY QUICK ================= -->
<div class="container mt-4 mb-5">
    <div class="row text-center gx-2 gy-3 row-cols-2 row-cols-md-3 row-cols-lg-6">

        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box" id="dropLaptop">
                    💻 Laptop
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropLaptop">
                    <li><a class="dropdown-item fw-bold" asp-controller="Product" asp-action="Category" asp-route-keyword="Laptop Gaming">Laptop Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="Laptop Sinh viên">Laptop Văn phòng</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" asp-controller="Product" asp-action="Category" asp-route-keyword="Macbook">Apple Macbook</a></li>
                </ul>
            </div>
        </div>

        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box" id="dropPC">
                    🖥 PC
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropPC">
                    <li><a class="dropdown-item fw-bold" asp-controller="Product" asp-action="Category" asp-route-keyword="PC Gaming">PC Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="PC Đồ họa">PC Đồ họa</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="PC Văn phòng">PC Đồng bộ</a></li>
                </ul>
            </div>
        </div>

        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box" id="dropMonitor">
                    📺 Màn hình
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropMonitor">
                    <li><a class="dropdown-item fw-bold" asp-controller="Product" asp-action="Category" asp-route-keyword="Màn hình Gaming">Màn hình Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="Màn hình Đồ họa">Màn hình Đồ họa</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="Màn hình Văn phòng">Màn hình Văn phòng</a></li>
                </ul>
            </div>
        </div>

        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box" id="dropGear">
                    🖱️ Gear
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropGear">
                    <li><a class="dropdown-item fw-bold" asp-controller="Product" asp-action="Category" asp-route-keyword="Bàn phím">Bàn phím cơ</a></li>
                    <li><a class="dropdown-item fw-bold" asp-controller="Product" asp-action="Category" asp-route-keyword="Chuột">Chuột Gaming</a></li>
                    <li><a class="dropdown-item fw-bold" asp-controller="Product" asp-action="Category" asp-route-keyword="Tai nghe">Tai nghe Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="Lót chuột">Lót chuột (Mousepad)</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="Ghế Gaming">Ghế Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="Loa">Loa máy tính</a></li>
                </ul>
            </div>
        </div>

        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box" id="dropComponent">
                    ⚙ Linh kiện
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropComponent">
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="CPU">CPU</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="VGA">VGA</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="Mainboard">Mainboard</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="RAM">RAM</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="SSD">Ổ cứng SSD</a></li>
                </ul>
            </div>
        </div>

        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box" id="dropBuildPC">
                    🛠 Build PC
                </div>
                <ul class="dropdown-menu shadow dropdown-menu-end" aria-labelledby="dropBuildPC">
                    <li><a class="dropdown-item fw-bold text-primary" asp-controller="Product" asp-action="Category" asp-route-keyword="Build PC">Công cụ Build PC</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="PC Intel">Cấu hình Intel</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Category" asp-route-keyword="PC AMD">Cấu hình AMD</a></li>
                </ul>
            </div>
        </div>

    </div>
</div>

    <!-- ================= FLASH SALE ================= -->
    <div class="container mt-4">
        <div class="section-title">🔥 FLASH SALE</div>

        <div class="row g-3">
            @foreach (var item in Model.Take(4))
            {
                <div class="col-6 col-md-3">
                    <div class="product-card position-relative">

                        <div class="badge-sale">-20%</div>

                        <img src="@item.ImageUrl" class="w-100 product-img">

                        <div class="p-2">
                            <div>@item.Name</div>

                            <div class="d-flex">
                                <span class="price">@String.Format("{0:N0} VNĐ", item.Price)</span>
                                <span class="old-price ms-2">
                                    @String.Format("{0:N0} VNĐ", item.Price * 1.2M)
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ================= ALL PRODUCTS ================= -->
    <div class="container mt-4">
        <div class="section-title">🛒 SẢN PHẨM</div>

        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-3">
                    <div class="product-card position-relative">

                        <div class="badge-sale">HOT</div>

                        <img src="@item.ImageUrl" class="w-100 product-img">

                        <div class="p-2">
                            <div>@item.Name</div>

                            <div class="d-flex">
                                <span class="price">@String.Format("{0:N0} VNĐ", item.Price)</span>
                            </div>

                            <a asp-controller="ShoppingCart"
                               asp-action="AddToCart"
                               asp-route-productId="@item.Id"
                               asp-route-quantity="@numOfQuantity"
                               class="btn btn-danger mt-2 w-100">
                                Thêm vào giỏ
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
    <div class="container my-5">
        <h2 class="text-center mb-4 text-uppercase fw-bold">Danh Sách Sản Phẩm</h2>
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 product-card shadow-sm">
                        <div class="img-container">
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name">
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate">@item.Name</h5>
                            <p class="card-text text-danger fw-bold">@item.Price.ToString("N0") VNĐ</p>

                            <div class="mt-auto">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100 mb-2">Chi tiết</a>
                                <button class="btn btn-primary btn-sm w-100">Thêm vào giỏ</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
