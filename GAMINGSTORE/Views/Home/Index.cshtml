@model IEnumerable<GAMINGSTORE.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "Trang chủ";
    int numOfQuantity = 1;
}

<style>
    body {
        background: #f5f5f5;
    }

    /* ===== BANNER ===== */
    .banner-img {
        height: 350px;
        object-fit: cover;
        border-radius: 10px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0,0,0,0.5);
        border-radius: 50%;
    }

    .carousel-fade .carousel-item {
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

        .carousel-fade .carousel-item.active {
            opacity: 1;
        }

    /* ===== CATEGORY ICON ===== */
    .category-box {
        background: white;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        transition: 0.3s;
        cursor: pointer;
    }

        .category-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

    /* ===== PRODUCT ===== */
    .product-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
        }

    .product-img {
        height: 200px;
        object-fit: cover;
    }

    .price {
        color: #ee4d2d;
        font-weight: bold;
    }

    .old-price {
        text-decoration: line-through;
        color: gray;
        font-size: 13px;
    }

    .badge-sale {
        position: absolute;
        top: 10px;
        left: 0;
        background: red;
        color: white;
        padding: 3px 6px;
        font-size: 12px;
    }

    /* ===== SECTION TITLE ===== */
    .section-title {
        font-size: 20px;
        font-weight: bold;
        margin: 20px 0 10px;
    }

</style>

<!-- ================= BANNER SLIDER ================= -->
<div class="container mt-3">
    <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">

        <div class="carousel-inner rounded">
            <div class="carousel-item active">
                <img src="~/images/banner/banner1.jpg" class="d-block w-100 banner-img">
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/banner2.jpg" class="d-block w-100 banner-img">
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/banner3.jpg" class="d-block w-100 banner-img">
            </div>
            <div id="bannerCarousel"
                 class="carousel slide"
                 data-bs-ride="carousel"
                 data-bs-interval="3000">
            </div>
            <div>
                <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>

                <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
            </div>


        </div>
    </div>

    <!-- ================= CATEGORY QUICK ================= -->
    <div class="container mt-4">
        <div class="row text-center">

            <div class="col">
                <div class="category-box">💻 Laptop</div>
            </div>
            <div class="col">
                <div class="category-box">🖥 PC</div>
            </div>
            <div class="col">
                <div class="category-box">🖥 Màn hình</div>
            </div>
            <div class="col">
                <div class="category-box">⚙ Linh kiện</div>
            </div>
            <div class="col">
                <div class="category-box">🛠 Build PC</div>
            </div>

        </div>
    </div>

    <!-- ================= FLASH SALE ================= -->
    <div class="container mt-4">
        <div class="section-title">🔥 FLASH SALE</div>

        <div class="row g-3">
            @foreach (var item in Model.Take(4))
            {
                <div class="col-6 col-md-3">
                    <div class="product-card position-relative">

                        <div class="badge-sale">-20%</div>

                        <img src="@item.ImageUrl" class="w-100 product-img">

                        <div class="p-2">
                            <div>@item.Name</div>

                            <div class="d-flex">
                                <span class="price">@String.Format("{0:N0} VNĐ", item.Price)</span>
                                <span class="old-price ms-2">
                                    @String.Format("{0:N0} VNĐ", item.Price * 1.2M)
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ================= ALL PRODUCTS ================= -->
    <div class="container mt-4">
        <div class="section-title">🛒 SẢN PHẨM</div>

        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-3">
                    <div class="product-card position-relative">

                        <div class="badge-sale">HOT</div>

                        <img src="@item.ImageUrl" class="w-100 product-img">

                        <div class="p-2">
                            <div>@item.Name</div>

                            <div class="d-flex">
                                <span class="price">@String.Format("{0:N0} VNĐ", item.Price)</span>
                            </div>

                            <a asp-controller="ShoppingCart"
                               asp-action="AddToCart"
                               asp-route-productId="@item.Id"
                               asp-route-quantity="@numOfQuantity"
                               class="btn btn-danger mt-2 w-100">
                                Thêm vào giỏ
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
