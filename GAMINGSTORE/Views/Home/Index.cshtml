@model IEnumerable<GAMINGSTORE.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "GAMINGSTORE - Mua Thiết Bị Gaming Online";
}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--bg-body, #161617);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: var(--text, #ffffff);
    }

    a {
        text-decoration: none;
    }

    /* ===== HERO BANNER ===== */
    .banner-section {
        background: #161617;
        border-radius: 0 0 18px 18px;
        overflow: hidden;
        margin-bottom: 34px;
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    }

    .banner-section .carousel,
    .banner-section .carousel-inner,
    .banner-section .carousel-item {
        height: 390px;
    }

    .banner-section .carousel-item {
        position: relative;
        transition: opacity 0.9s ease-in-out;
    }

    .banner-img {
        width: 100%;
        height: 390px;
        object-fit: cover;
        transform: scale(1.04);
        transition: transform 5s ease;
        filter: saturate(1.04) contrast(1.03);
    }

    .banner-section .carousel-item.active .banner-img {
        transform: scale(1);
    }

    .banner-section .carousel::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(0,0,0,0.76), rgba(0,0,0,0.28), rgba(0,0,0,0.04));
        pointer-events: none;
        z-index: 1;
    }

    .banner-caption {
        position: absolute;
        left: 42px;
        bottom: 40px;
        z-index: 2;
        max-width: 560px;
        color: white;
    }

    .banner-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 13px;
        border-radius: 4px;
        background: var(--primary, #d0021b);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .banner-title {
        font-size: 40px;
        line-height: 1.08;
        font-weight: 800;
        margin-bottom: 12px;
        text-shadow: 0 10px 26px rgba(0,0,0,0.3);
    }

    .banner-desc {
        font-size: 15px;
        line-height: 1.75;
        color: rgba(255,255,255,0.86);
        max-width: 500px;
        margin-bottom: 18px;
    }

    .banner-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .banner-btn {
        min-height: 44px;
        padding: 0 18px;
        border-radius: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.22s ease;
    }

    .banner-btn-primary {
        background: var(--primary-hover, #e50100);
        color: white;
    }

    .banner-btn-secondary {
        background: rgba(255,255,255,0.12);
        color: white;
        border: 1px solid rgba(255,255,255,0.22);
        backdrop-filter: blur(8px);
    }

    .banner-btn:hover {
        transform: translateY(-2px);
        color: white;
    }

    .carousel-indicators {
        z-index: 2;
        margin-bottom: 18px;
    }

    .carousel-indicators [data-bs-target] {
        width: 9px;
        height: 9px;
        border-radius: 99px;
        border: none;
        background: rgba(255,255,255,0.55);
    }

    .carousel-indicators .active {
        width: 30px;
        background: var(--primary-hover, #e50100);
    }

    .carousel-control-prev,
    .carousel-control-next {
        z-index: 3;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background-color: rgba(0, 0, 0, 0.52);
        background-size: 48%;
        backdrop-filter: blur(4px);
    }

    /* ===== FILTER / RESULT BAR ===== */
    .filter-bar {
        background: #ffffff;
        color: #111;
        padding: 16px 18px;
        margin-bottom: 22px;
        border-radius: 10px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }

    .filter-label {
        font-size: 13px;
        font-weight: 800;
        color: #111;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .form-select {
        min-height: 42px;
        padding: 0 38px 0 13px;
        border: 1px solid rgba(15, 23, 42, 0.14);
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        background-color: #fff;
        color: #111;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .form-select:hover,
    .form-select:focus {
        border-color: var(--primary, #d0021b);
        box-shadow: 0 0 0 3px rgba(208, 2, 27, 0.1);
        outline: none;
    }

    .result-count {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 13px;
        color: #555;
    }

    .result-pill {
        min-height: 32px;
        padding: 0 12px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff1f2;
        color: var(--primary, #d0021b);
        border: 1px solid rgba(208, 2, 27, 0.16);
        font-size: 12px;
        font-weight: 800;
    }

    /* ===== CATEGORY PRODUCT SECTIONS - XGEAR STYLE ===== */
    .category-product-section {
        margin-bottom: 34px;
        background: #ffffff;
        color: #111;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(15, 23, 42, 0.08);
        box-shadow: 0 10px 26px rgba(0,0,0,0.14);
    }

    .bg-color-while {
        background: #ffffff;
        padding: 14px 14px 0;
    }

    .row-left-list {
        gap: 12px;
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .row-left-list::-webkit-scrollbar {
        height: 6px;
    }

    .row-left-list::-webkit-scrollbar-thumb {
        background: #d0021b;
        border-radius: 99px;
    }

    .item-banner {
        min-width: 260px;
        flex: 1;
        border-radius: 8px;
        overflow: hidden;
        background: #f4f4f4;
    }

    .item-banner img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }

    .item-banner:hover img {
        transform: scale(1.035);
    }

    .section-content {
        padding: 20px;
    }

    .section-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        padding-bottom: 13px;
        border-bottom: 1px solid #eeeeee;
        position: relative;
    }

    .section-title-row::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 72px;
        height: 3px;
        background: var(--primary, #d0021b);
        border-radius: 99px;
    }

    .section-name {
        font-size: 22px;
        line-height: 1.25;
        font-weight: 800;
        color: #111;
        text-transform: uppercase;
        margin: 0;
        letter-spacing: 0.2px;
    }

    /* ===== PRODUCT GRID ===== */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    /* Style cho _ProductCard hiện tại */
    .product-card,
    .product-block.item {
        height: 100%;
        background: #ffffff;
        color: #111;
        border: 1px solid #eeeeee;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        position: relative;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

    .product-card:hover,
    .product-block.item:hover {
        transform: translateY(-4px);
        border-color: rgba(208, 2, 27, 0.34);
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.12);
    }

    .product-image-wrapper,
    .product-img {
        position: relative;
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: linear-gradient(180deg, #ffffff 0%, #f7f7f7 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image,
    .product-img img,
    .image-resize img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 14px;
        transition: transform 0.28s ease;
    }

    .product-card:hover .product-image,
    .product-block.item:hover .product-img img {
        transform: scale(1.045);
    }

    .product-badge,
    .product-sale {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
        min-height: 26px;
        padding: 0 9px;
        border-radius: 4px;
        background: var(--primary-hover, #e50100);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        box-shadow: 0 5px 12px rgba(208, 2, 27, 0.24);
    }

    .product-floating-action {
        position: absolute;
        right: 10px;
        top: 10px;
        z-index: 2;
        min-width: 38px;
        height: 34px;
        padding: 0 10px;
        border-radius: 4px;
        background: rgba(255,255,255,0.95);
        color: #111;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
    }

    .product-info,
    .product-detail {
        padding: 13px 14px 15px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .product-name,
    .pro-name {
        min-height: 44px;
        margin: 0 0 9px;
        color: #111;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-name a,
    .pro-name a {
        color: #111;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .product-card:hover .product-name,
    .product-card:hover .product-name a,
    .product-block.item:hover .pro-name a {
        color: var(--primary, #d0021b);
    }

    .product-category {
        width: fit-content;
        min-height: 24px;
        padding: 0 8px;
        border-radius: 4px;
        background: #fff1f2;
        color: var(--primary, #d0021b);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .product-description {
        min-height: 42px;
        margin-bottom: 10px;
        color: #666;
        font-size: 12.5px;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-meta-row,
    .config-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 10px;
    }

    .product-meta-pill,
    .config-tags li {
        min-height: 25px;
        padding: 0 8px;
        border-radius: 4px;
        background: #f5f5f5;
        color: #444;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 700;
    }

    .config-tags ul {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .config-tags img {
        width: 18px;
        height: 18px;
        object-fit: contain;
    }

    .product-price,
    .pro-price {
        margin: auto 0 4px;
        color: var(--primary, #d0021b);
        font-size: 18px;
        line-height: 1.2;
        font-weight: 900;
        letter-spacing: -0.2px;
    }

    .pro-price span {
        color: var(--primary, #d0021b);
        font-size: 18px;
        font-weight: 900;
    }

    .product-subprice {
        color: #888;
        font-size: 12px;
        margin-bottom: 12px;
    }

    .box-pro-prices {
        margin-top: auto;
    }

    .product-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 12px;
    }

    .product-button {
        min-height: 38px;
        border-radius: 5px;
        border: 1px solid var(--primary-hover, #e50100);
        background: var(--primary-hover, #e50100);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 12.5px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .product-button:hover {
        background: var(--primary-dark, #a50015);
        border-color: var(--primary-dark, #a50015);
        color: #fff;
    }

    .product-button-secondary {
        background: #ffffff;
        color: #111;
        border-color: #dddddd;
    }

    .product-button-secondary:hover {
        background: #fff1f2;
        color: var(--primary, #d0021b);
        border-color: rgba(208, 2, 27, 0.22);
    }

    .fl_progressbar_group {
        margin-top: 10px;
        padding: 8px;
        border-radius: 6px;
        background: #fff6f6;
    }

    .fl_label {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #333;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .fl_progressbar {
        height: 6px;
        border-radius: 99px;
        background: #ffd4d4;
        overflow: hidden;
    }

    .fl_percent {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #d0021b, #ff6b6b);
    }

    /* ===== PAGINATION ===== */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin: 34px 0;
        flex-wrap: wrap;
    }

    .pagination-btn,
    .pagination-current {
        min-width: 38px;
        min-height: 38px;
        padding: 0 12px;
        border-radius: 5px;
        border: 1px solid rgba(255,255,255,0.12);
        background: #1e1e1e;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .pagination-btn:hover {
        border-color: var(--primary, #d0021b);
        color: #ffffff;
        background: var(--primary, #d0021b);
    }

    .pagination-current {
        background: var(--primary-hover, #e50100);
        border-color: var(--primary-hover, #e50100);
        color: #ffffff;
    }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 70px 24px;
        background: #ffffff;
        color: #111;
        border-radius: 10px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        box-shadow: 0 10px 26px rgba(0,0,0,0.12);
    }

    .empty-icon {
        font-size: 68px;
        margin-bottom: 16px;
    }

    .empty-title {
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .empty-desc {
        color: #666;
        margin-bottom: 18px;
    }

    .empty-btn {
        min-height: 42px;
        padding: 0 22px;
        border-radius: 5px;
        background: var(--primary-hover, #e50100);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: 800;
    }

    .empty-btn:hover {
        color: white;
        background: var(--primary-dark, #a50015);
    }

    .btn-outline-danger {
        border-color: var(--primary, #d0021b) !important;
        color: var(--primary, #d0021b) !important;
        font-weight: 800;
    }

    .btn-outline-danger:hover {
        background: var(--primary, #d0021b) !important;
        color: #fff !important;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1199px) {
        .product-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991px) {
        .banner-section .carousel,
        .banner-section .carousel-inner,
        .banner-section .carousel-item,
        .banner-img {
            height: 320px;
        }

        .banner-title {
            font-size: 30px;
        }

        .product-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }

        .product-image-wrapper,
        .product-img {
            height: 190px;
        }
    }

    @@media (max-width: 768px) {
        .banner-caption {
            left: 20px;
            right: 20px;
            bottom: 24px;
        }

        .banner-title {
            font-size: 25px;
        }

        .banner-desc {
            font-size: 13px;
        }

        .filter-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .form-select {
            width: 100%;
        }

        .category-product-section {
            border-radius: 8px;
        }

        .section-content {
            padding: 14px;
        }

        .section-name {
            font-size: 18px;
        }

        .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .product-image-wrapper,
        .product-img {
            height: 160px;
        }

        .product-info,
        .product-detail {
            padding: 10px;
        }

        .product-actions {
            grid-template-columns: 1fr;
        }

        .item-banner {
            min-width: 220px;
        }
    }

    @@media (max-width: 480px) {
        .container.mt-4 {
            margin-top: 10px !important;
        }

        .banner-section .carousel,
        .banner-section .carousel-inner,
        .banner-section .carousel-item,
        .banner-img {
            height: 250px;
        }

        .banner-caption {
            left: 14px;
            right: 14px;
            bottom: 18px;
        }

        .banner-title {
            font-size: 20px;
        }

        .banner-desc {
            display: none;
        }

        .banner-btn {
            min-height: 38px;
            padding: 0 13px;
            font-size: 12px;
        }

        .product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .product-image-wrapper,
        .product-img {
            height: 136px;
        }

        .product-name,
        .pro-name {
            min-height: 40px;
            font-size: 12.5px;
        }

        .product-description,
        .product-category,
        .product-meta-row,
        .config-tags {
            display: none;
        }

        .product-price,
        .pro-price,
        .pro-price span {
            font-size: 15px;
        }
    }
</style>

<div class="container mt-4">
    <!-- BANNER -->
    <div class="banner-section">
        <div id="bannerCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/banner/banner1.jpg" class="banner-img" alt="Banner">
                    <div class="banner-caption">
                        <div class="banner-kicker">New collection</div>
                        <div class="banner-title">Gaming gear mạnh, đẹp và sẵn sàng cho mọi setup.</div>
                        <div class="banner-desc">Khám phá laptop, màn hình, phụ kiện và thiết bị gaming với giao diện mua sắm nhanh, rõ và hiện đại.</div>
                        <div class="banner-actions">
                            <a asp-controller="Home" asp-action="Index" class="banner-btn banner-btn-primary">Mua ngay</a>
                            <a asp-controller="Product" asp-action="Index" class="banner-btn banner-btn-secondary">Xem sản phẩm</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/banner/banner2.jpg" class="banner-img" alt="Banner">
                    <div class="banner-caption">
                        <div class="banner-kicker">Performance first</div>
                        <div class="banner-title">Tối ưu góc máy chiến game với thiết bị đúng chất.</div>
                        <div class="banner-desc">Từ SSD, chuột, bàn phím đến màn hình gaming, mọi thứ đều được gom lại trong một trải nghiệm mua sắm gọn gàng.</div>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/banner/banner3.jpg" class="banner-img" alt="Banner">
                    <div class="banner-caption">
                        <div class="banner-kicker">Fast checkout</div>
                        <div class="banner-title">Chọn nhanh, lọc gọn, đặt hàng mượt hơn.</div>
                        <div class="banner-desc">Hệ thống lọc sản phẩm, giỏ hàng theo tài khoản và giao diện thanh toán đã được tối ưu để dùng thực tế.</div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>

    <!-- CATEGORY PRODUCT SECTIONS -->
    @{
        bool isSearching = !string.IsNullOrEmpty(ViewBag.SearchString) || ViewBag.SelectedCategoryId != null || !string.IsNullOrEmpty(ViewBag.ProductType);
    }

    @if (isSearching)
    {
        <div class="container mb-3 mt-4">
            <h3 class="fw-bold text-uppercase border-bottom pb-2" style="border-bottom-width: 3px !important; border-bottom-color: #d92e2e !important; display: inline-block;">
                Kết quả tìm kiếm
            </h3>
        </div>

        <!-- FILTER & SORT -->
        <div class="container">
            <div class="filter-bar">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <label class="filter-label">Sắp xếp:</label>
                    <form asp-controller="Home" asp-action="Index" method="get" id="sortForm" onchange="document.getElementById('sortForm').submit()">
                        <input type="hidden" name="searchString" value="@ViewBag.SearchString">
                        <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategoryId">
                        <input type="hidden" name="page" value="1">
                        
                        @{
                            var sortBy = ViewBag.SortBy ?? "newest";
                        }
                        <select name="sortBy" class="form-select">
                            @if (sortBy == "newest") { <option value="newest" selected>🆕 Mới nhất</option> } else { <option value="newest">🆕 Mới nhất</option> }
                            @if (sortBy == "name_asc") { <option value="name_asc" selected>📝 Tên A-Z</option> } else { <option value="name_asc">📝 Tên A-Z</option> }
                            @if (sortBy == "name_desc") { <option value="name_desc" selected>📝 Tên Z-A</option> } else { <option value="name_desc">📝 Tên Z-A</option> }
                            @if (sortBy == "price_asc") { <option value="price_asc" selected>💰 Giá thấp</option> } else { <option value="price_asc">💰 Giá thấp</option> }
                            @if (sortBy == "price_desc") { <option value="price_desc" selected>💰 Giá cao</option> } else { <option value="price_desc">💰 Giá cao</option> }
                        </select>
                    </form>
                </div>

                <div class="result-count">
                    <span class="result-pill"><strong>@ViewBag.TotalProduct</strong> sản phẩm</span>
                    @if (ViewBag.SelectedCategoryId != null) { <span class="result-pill">Đang lọc theo danh mục</span> }
                    @if (!string.IsNullOrEmpty(ViewBag.SearchString)) { <span class="result-pill">Từ khóa: <strong>"@ViewBag.SearchString"</strong></span> }
                </div>
            </div>
        </div>

        <!-- PRODUCTS -->
        <div class="container mb-5">
            @if (Model != null && Model.Any())
            {
                <div class="product-grid">
                    @foreach (var product in Model)
                    {
                        @await Html.PartialAsync("_ProductCard", product)
                    }
                </div>

                <!-- PAGINATION -->
                @if (ViewBag.TotalPage > 1)
                {
                    <div class="pagination-wrapper mt-4">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <a asp-controller="Home" asp-action="Index" asp-route-page="1" 
                               asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                               asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">⏮ Đầu</a>
                            
                            <a asp-controller="Home" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" 
                               asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                               asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">⬅ Trước</a>
                        }

                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPage, ViewBag.CurrentPage + 2); i++)
                        {
                            @if (i == ViewBag.CurrentPage)
                            {
                                <span class="pagination-current">@i</span>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" asp-route-page="@i" 
                                   asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                                   asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">@i</a>
                            }
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPage)
                        {
                            <a asp-controller="Home" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" 
                               asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                               asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">Tiếp ➡</a>
                            
                            <a asp-controller="Home" asp-action="Index" asp-route-page="@ViewBag.TotalPage" 
                               asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                               asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">Cuối ⏭</a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🔍</div>
                    <div class="empty-title">Không tìm thấy sản phẩm nào</div>
                    <p class="empty-desc">Thử tìm kiếm với từ khóa khác hoặc quay lại trang chủ.</p>
                    <a href="/" class="empty-btn">Quay lại trang chủ</a>
                </div>
            }
        </div>
    }
    else
{
    <!-- CHẾ ĐỘ TRANG CHỦ MẶC ĐỊNH - CÁC CONTAINER DANH MỤC TỰ ĐỘNG -->
    var homeProducts = ViewBag.AllHomeProducts as IEnumerable<GAMINGSTORE.Models.Product> ?? Model;
    var categories = ViewBag.Categories as IEnumerable<GAMINGSTORE.Models.Category>;

    if (categories != null && homeProducts != null)
    {
        var categoryIndex = 0;
        foreach (var category in categories.Where(c => c.IsMenuVisible))
        {
            var categoryProducts = homeProducts.Where(p => p.Categories != null && p.Categories.Any(c => c.Id == category.Id)).Take(4).ToList();

            if (categoryProducts.Any())
            {
                <div class="container category-product-section">
                    
                    @if (categoryIndex == 0)
                    {
                        <div class="bg-color-while">
                            <div class="d-flex row-left-list scroll-x-mb">
                                <div class="item-banner">
                                    <a href="#"><img src="~/images/banner/banner1.jpg" alt="Banner 1"></a>
                                </div>
                                <div class="item-banner">
                                    <a href="#"><img src="~/images/banner/banner2.jpg" alt="Banner 2"></a>
                                </div>
                                <div class="item-banner">
                                    <a href="#"><img src="~/images/banner/banner3.jpg" alt="Banner 3"></a>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="section-content">
                        <div class="section-title-row">
                            <h2 class="section-name">@category.Name</h2>
                        </div>
                        <div class="product-grid">
                            @foreach (var product in categoryProducts)
                            {
                                @await Html.PartialAsync("_ProductCard", product)
                            }
                        </div>
                        <div class="text-center mt-4 mb-2">
                            <a href="/Home/Index?categoryId=@category.Id" class="btn btn-outline-danger px-4 py-2 rounded-pill fw-bold">
                                Xem thêm @category.Name <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
                
                categoryIndex++;
            }
        }
    }
}

<style>
    .hover-primary:hover {
        background-color: #d92e2e !important;
        color: white !important;
        border-color: #d92e2e !important;
        transform: translateY(-2px);
    }
    .fw-800 { font-weight: 800; }
    .letter-spacing-1 { letter-spacing: 0.5px; }
</style>

<script>
    function handleCategoryChange() {
        const categorySelect = document.querySelector('[name="categoryId"]');
        const selectedValue = categorySelect.value;
        const form = document.getElementById('categoryForm');
        
        // Luôn reset về trang 1 khi thay đổi danh mục
        document.querySelector('input[name="page"]').value = '1';
        
        if (selectedValue === '') {
            // Nếu chọn "Tất cả", xóa categoryId và reset
            window.location.href = '@Url.Action("Index", "Home")';
        } else {
            // Nếu chọn danh mục cụ thể, submit form
            form.submit();
        }
    }
</script>
