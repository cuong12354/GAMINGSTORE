@model IEnumerable<GAMINGSTORE.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "GAMINGSTORE - Mua Thiết Bị Gaming Online";

    string GetFirstImage(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return "/images/no-image.png";
        }

        return imageUrl
            .Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault() ?? "/images/no-image.png";
    }

    string GetShortDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return "Thiết kế hiện đại, sẵn sàng lên đơn nhanh với trải nghiệm mua sắm rõ ràng và tối ưu.";
        }

        var normalized = description.Trim();
        return normalized.Length > 92 ? normalized[..89].TrimEnd() + "..." : normalized;
    }
}

<style>
    :root {
        --primary: #d92e2e;
        --primary-dark: #b82222;
        --secondary: #f5f5f5;
        --text: #212245;
        --text-light: #666;
        --border: #e5e5e5;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--secondary);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: var(--text);
    }

    /* BANNER */
    .banner-section {
        background: white;
        padding: 0;
        border-radius: 28px;
        overflow: hidden;
        margin-bottom: 30px;
        box-shadow: 0 24px 48px rgba(15, 23, 42, 0.1);
    }

    .banner-section .carousel,
    .banner-section .carousel-inner,
    .banner-section .carousel-item {
        height: 400px;
    }

    .banner-section .carousel-item {
        transition: opacity 1.1s ease-in-out;
    }

    .banner-img {
        height: 400px;
        object-fit: cover;
        width: 100%;
        transform: scale(1.06);
        transition: transform 5.5s ease, filter 1.1s ease;
        filter: saturate(1.02);
    }

    .banner-section .carousel-item.active .banner-img {
        transform: scale(1);
    }

    .banner-section .carousel::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12));
        pointer-events: none;
        z-index: 1;
    }

    .banner-section .carousel-control-prev,
    .banner-section .carousel-control-next {
        z-index: 2;
    }

    .banner-caption {
        position: absolute;
        left: 42px;
        bottom: 38px;
        z-index: 2;
        max-width: 520px;
        color: white;
    }

    .banner-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.14);
        backdrop-filter: blur(10px);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .banner-title {
        font-size: 40px;
        line-height: 1.06;
        font-weight: 800;
        margin-bottom: 12px;
        text-shadow: 0 10px 30px rgba(0,0,0,0.22);
    }

    .banner-desc {
        font-size: 15px;
        line-height: 1.75;
        color: rgba(255,255,255,0.88);
        max-width: 470px;
        margin-bottom: 18px;
    }

    .banner-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .banner-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 46px;
        padding: 0 18px;
        border-radius: 16px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 800;
        transition: all 0.25s ease;
    }

    .banner-btn-primary {
        background: white;
        color: var(--primary-dark);
    }

    .banner-btn-secondary {
        background: rgba(255,255,255,0.14);
        color: white;
        backdrop-filter: blur(10px);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
    }

    .banner-btn:hover {
        transform: translateY(-1px);
    }

    .carousel-indicators {
        margin-bottom: 18px;
        z-index: 2;
    }

    .carousel-indicators [data-bs-target] {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.52);
    }

    .carousel-indicators .active {
        width: 28px;
        border-radius: 999px;
        background: white;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0, 0, 0, 0.5);
        border-radius: 50%;
        padding: 15px;
        backdrop-filter: blur(4px);
    }

    /* CATEGORY SECTION */
    .category-section {
        background: white;
        padding: 30px 0;
        margin-bottom: 30px;
        border-radius: 22px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
        border: 1px solid rgba(15,23,42,0.06);
    }

    .category-title {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--text-light);
        margin-bottom: 8px;
        padding: 0 24px;
        letter-spacing: 0.8px;
    }

    .category-subtitle {
        font-size: 22px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 18px;
        padding: 0 24px;
    }

    .category-dropdown {
        width: 100%;
        max-width: 440px;
        padding: 14px 16px;
        border: 1px solid rgba(15,23,42,0.08);
        border-radius: 16px;
        font-size: 14px;
        font-weight: 700;
        background: #fbfcfd;
        cursor: pointer;
        transition: all 0.3s ease;
        color: var(--text);
        font-family: inherit;
    }

    .category-dropdown:hover {
        border-color: var(--primary);
        box-shadow: 0 2px 8px rgba(217, 46, 46, 0.1);
    }

    .category-dropdown:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(217, 46, 46, 0.1);
    }

    .category-dropdown option {
        padding: 8px 12px;
        font-size: 14px;
        color: var(--text);
    }

    /* FILTER & SORT */
    .filter-bar {
        background: white;
        padding: 18px 22px;
        margin-bottom: 20px;
        border-radius: 20px;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
        border: 1px solid rgba(15,23,42,0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
    }

    .filter-label {
        font-size: 13px;
        font-weight: 800;
        color: var(--text);
    }

    .form-select {
        padding: 11px 14px;
        border: 1px solid rgba(15,23,42,0.08);
        border-radius: 14px;
        font-size: 13px;
        background: #fbfcfd;
        cursor: pointer;
        transition: 0.2s;
    }

    .form-select:hover {
        border-color: var(--primary);
    }

    .form-select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(217, 46, 46, 0.1);
    }

    .result-count {
        font-size: 13px;
        color: var(--text-light);
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .result-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 34px;
        padding: 0 12px;
        border-radius: 999px;
        background: #fff4f1;
        color: var(--primary-dark);
        font-size: 12px;
        font-weight: 700;
    }

    /* PRODUCTS GRID */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 22px;
        margin-bottom: 40px;
    }

    .product-card {
        background: white;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid rgba(15,23,42,0.06);
        transition: all 0.32s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        cursor: pointer;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
    }

    .product-card:hover {
        border-color: rgba(217, 46, 46, 0.18);
        box-shadow: 0 22px 44px rgba(15, 23, 42, 0.1);
        transform: translateY(-4px);
    }

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 232px;
        overflow: hidden;
        background: linear-gradient(180deg, #fff8f5, #f8fafc);
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 18px;
        transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .product-card:hover .product-image {
        opacity: 0.86;
        transform: scale(1.03);
    }

    .product-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(255,255,255,0.92);
        color: var(--primary-dark);
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        z-index: 2;
        box-shadow: 0 10px 20px rgba(15,23,42,0.08);
    }

    .product-floating-action {
        position: absolute;
        right: 14px;
        top: 14px;
        min-width: 42px;
        height: 38px;
        padding: 0 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.92);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--text);
        z-index: 2;
        box-shadow: 0 10px 20px rgba(15,23,42,0.08);
        font-size: 11px;
        font-weight: 800;
        gap: 6px;
    }

    .product-info {
        padding: 18px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .product-name {
        font-size: 16px;
        font-weight: 800;
        line-height: 1.4;
        color: var(--text);
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-category {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        background: #fff4f1;
        font-size: 11px;
        font-weight: 700;
        color: var(--primary-dark);
        margin-bottom: 10px;
    }

    .product-description {
        color: var(--text-light);
        font-size: 13px;
        line-height: 1.65;
        margin-bottom: 14px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 64px;
    }

    .product-meta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
    }

    .product-meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        background: #f8fafc;
        color: #475569;
        font-size: 11px;
        font-weight: 800;
    }

    .product-price {
        font-size: 22px;
        font-weight: 800;
        color: var(--primary);
        margin-bottom: 4px;
        letter-spacing: 0.2px;
    }

    .product-subprice {
        font-size: 12px;
        color: var(--text-light);
        margin-bottom: 16px;
    }

    .product-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .product-button {
        width: 100%;
        min-height: 44px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        border: none;
        border-radius: 15px;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.3s;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .product-button:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
    }

    .product-button-secondary {
        background: #fff;
        color: var(--text);
        border: 1px solid rgba(15,23,42,0.09);
    }

    .product-button-secondary:hover {
        background: #fff7f3;
        border-color: rgba(217, 46, 46, 0.2);
        color: var(--primary-dark);
    }

    /* PAGINATION */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin: 40px 0;
        flex-wrap: wrap;
    }

    .pagination-btn {
        padding: 8px 12px;
        border: 1px solid var(--border);
        background: white;
        color: var(--text);
        border-radius: 4px;
        cursor: pointer;
        transition: 0.3s;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pagination-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    .pagination-btn.active,
    .pagination-current {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        border-color: var(--primary);
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 72px 24px;
        background: white;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
        border: 1px solid rgba(15,23,42,0.06);
    }

    .empty-icon {
        font-size: 80px;
        margin-bottom: 20px;
    }

    .empty-title {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .empty-desc {
        color: var(--text-light);
        margin-bottom: 20px;
    }

    .empty-btn {
        display: inline-block;
        padding: 12px 30px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

    .empty-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(217, 46, 46, 0.3);
    }

    /* RESPONSIVE */
    @@media (max-width: 1024px) {
        .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }
    }

    @@media (max-width: 768px) {
        .banner-caption {
            left: 22px;
            right: 22px;
            bottom: 24px;
        }

        .banner-title {
            font-size: 28px;
        }

        .product-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .product-actions {
            grid-template-columns: 1fr;
        }

        .filter-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .form-select {
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .product-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .product-image-wrapper {
            height: 150px;
        }
    }
</style>

<div class="container mt-4">
    <!-- BANNER -->
    <div class="banner-section">
        <div id="bannerCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/banner/banner1.jpg" class="banner-img" alt="Banner">
                    <div class="banner-caption">
                        <div class="banner-kicker">New collection</div>
                        <div class="banner-title">Gaming gear mạnh, đẹp và sẵn sàng cho mọi setup.</div>
                        <div class="banner-desc">Khám phá laptop, màn hình, phụ kiện và thiết bị gaming với giao diện mua sắm nhanh, rõ và hiện đại.</div>
                        <div class="banner-actions">
                            <a asp-controller="Home" asp-action="Index" class="banner-btn banner-btn-primary">Mua ngay</a>
                            <a asp-controller="Product" asp-action="Index" class="banner-btn banner-btn-secondary">Xem sản phẩm</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/banner/banner2.jpg" class="banner-img" alt="Banner">
                    <div class="banner-caption">
                        <div class="banner-kicker">Performance first</div>
                        <div class="banner-title">Tối ưu góc máy chiến game với thiết bị đúng chất.</div>
                        <div class="banner-desc">Từ SSD, chuột, bàn phím đến màn hình gaming, mọi thứ đều được gom lại trong một trải nghiệm mua sắm gọn gàng.</div>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/banner/banner3.jpg" class="banner-img" alt="Banner">
                    <div class="banner-caption">
                        <div class="banner-kicker">Fast checkout</div>
                        <div class="banner-title">Chọn nhanh, lọc gọn, đặt hàng mượt hơn.</div>
                        <div class="banner-desc">Hệ thống lọc sản phẩm, giỏ hàng theo tài khoản và giao diện thanh toán đã được tối ưu để dùng thực tế.</div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</div>

<!-- CATEGORIES DROPDOWN -->
<div class="container mt-5">
    <div class="category-section">
        <div class="category-title">🎮 DANH MỤC SẢN PHẨM</div>
        <div class="category-subtitle">Chọn nhanh nhóm sản phẩm bạn cần</div>
        <div style="padding: 0 20px;">
            <form id="categoryForm" method="get" asp-controller="Home" asp-action="Index">
                <input type="hidden" name="searchString" id="formSearchString" value="@ViewBag.SearchString">
                <input type="hidden" name="sortBy" id="formSortBy" value="@ViewBag.SortBy">
                <input type="hidden" name="page" value="1">
                <select name="categoryId" class="form-select category-dropdown" onchange="handleCategoryChange()">
                    @{
                        var isAllSelected = ViewBag.SelectedCategoryId == null || (int?)ViewBag.SelectedCategoryId == 0;
                    }
                    @if (isAllSelected)
                    {
                        <option value="" selected>🏪 Tất cả danh mục</option>
                    }
                    else
                    {
                        <option value="">🏪 Tất cả danh mục</option>
                    }
                    @foreach (var category in ViewBag.Categories ?? new List<GAMINGSTORE.Models.Category>())
                    {
                        var isSelected = ViewBag.SelectedCategoryId != null && (int?)ViewBag.SelectedCategoryId == category.Id;
                        @if (isSelected)
                        {
                            <option value="@category.Id" selected>@category.Name</option>
                        }
                        else
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>
</div>

<!-- FILTER & SORT -->
<div class="container">
    <div class="filter-bar">
        <div style="display: flex; align-items: center; gap: 12px;">
            <label class="filter-label">Sắp xếp:</label>
            <form asp-controller="Home" asp-action="Index" method="get" id="sortForm" onchange="document.getElementById('sortForm').submit()">
                <input type="hidden" name="searchString" value="@ViewBag.SearchString">
                <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategoryId">
                <input type="hidden" name="page" value="1">
                
                @{
                    var sortBy = ViewBag.SortBy ?? "newest";
                }
                <select name="sortBy" class="form-select">
                    @if (sortBy == "newest")
                    {
                        <option value="newest" selected>🆕 Mới nhất</option>
                    }
                    else
                    {
                        <option value="newest">🆕 Mới nhất</option>
                    }
                    @if (sortBy == "name_asc")
                    {
                        <option value="name_asc" selected>📝 Tên A-Z</option>
                    }
                    else
                    {
                        <option value="name_asc">📝 Tên A-Z</option>
                    }
                    @if (sortBy == "name_desc")
                    {
                        <option value="name_desc" selected>📝 Tên Z-A</option>
                    }
                    else
                    {
                        <option value="name_desc">📝 Tên Z-A</option>
                    }
                    @if (sortBy == "price_asc")
                    {
                        <option value="price_asc" selected>💰 Giá thấp</option>
                    }
                    else
                    {
                        <option value="price_asc">💰 Giá thấp</option>
                    }
                    @if (sortBy == "price_desc")
                    {
                        <option value="price_desc" selected>💰 Giá cao</option>
                    }
                    else
                    {
                        <option value="price_desc">💰 Giá cao</option>
                    }
                </select>
            </form>
        </div>

        <div class="result-count">
            <span class="result-pill"><strong>@ViewBag.TotalProduct</strong> sản phẩm</span>
            @if (ViewBag.SelectedCategoryId != null) { <span class="result-pill">Đang lọc theo danh mục</span> }
            @if (!string.IsNullOrEmpty(ViewBag.SearchString)) { <span class="result-pill">Từ khóa: <strong>"@ViewBag.SearchString"</strong></span> }
        </div>
    </div>
</div>

<!-- PRODUCTS -->
<div class="container">
    @if (Model.Any())
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <div class="product-image-wrapper">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" style="text-decoration: none; display: block; height: 100%;">
                            <img src="@GetFirstImage(product.ImageUrl)" class="product-image" alt="@product.Name" onerror="this.src='/images/no-image.png'">
                        </a>
                        <span class="product-badge">@((product.Categories?.FirstOrDefault()?.Name) ?? "Gaming Choice")</span>
                        <span class="product-floating-action"><i class="bi bi-lightning-charge"></i> Hot</span>
                    </div>

                    <div class="product-info">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" style="text-decoration: none;">
                            <div class="product-name">@product.Name</div>
                        </a>

                        @if (product.Categories?.Any() == true)
                        {
                            <div class="product-category">@string.Join(" • ", product.Categories.Select(c => c.Name).Take(1))</div>
                        }

                        <div class="product-description">@GetShortDescription(product.Description)</div>

                        <div class="product-meta-row">
                            <span class="product-meta-pill"><i class="bi bi-shield-check"></i> Chính hãng</span>
                            <span class="product-meta-pill"><i class="bi bi-truck"></i> Giao nhanh</span>
                        </div>

                        <div class="product-price">
                            @Math.Round(product.Price, 0).ToString("N0", new CultureInfo("vi-VN")) ₫
                        </div>

                        <div class="product-subprice">Hàng chính hãng • Bảo hành rõ ràng</div>

                        <div class="product-actions">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="product-button product-button-secondary">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-productId="@product.Id" class="product-button">
                                <i class="bi bi-cart-plus"></i> Thêm giỏ
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (ViewBag.TotalPage > 1)
        {
            <div class="pagination-wrapper">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Home" asp-action="Index" asp-route-page="1" 
                       asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                       asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">⏮ Đầu</a>
                    
                    <a asp-controller="Home" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" 
                       asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                       asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">⬅ Trước</a>
                }

                @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPage, ViewBag.CurrentPage + 2); i++)
                {
                    @if (i == ViewBag.CurrentPage)
                    {
                        <span class="pagination-current">@i</span>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index" asp-route-page="@i" 
                           asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                           asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">@i</a>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPage)
                {
                    <a asp-controller="Home" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" 
                       asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                       asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">Tiếp ➡</a>
                    
                    <a asp-controller="Home" asp-action="Index" asp-route-page="@ViewBag.TotalPage" 
                       asp-route-searchString="@ViewBag.SearchString" asp-route-categoryId="@ViewBag.SelectedCategoryId" 
                       asp-route-sortBy="@ViewBag.SortBy" class="pagination-btn">Cuối ⏭</a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🔍</div>
            <div class="empty-title">Không tìm thấy sản phẩm</div>
            <div class="empty-desc">Hãy thử tìm kiếm hoặc bộ lọc khác</div>
            <a asp-controller="Home" asp-action="Index" class="empty-btn">🏪 Quay lại</a>
        </div>
    }
</div>

<script>
    function handleCategoryChange() {
        const categorySelect = document.querySelector('[name="categoryId"]');
        const selectedValue = categorySelect.value;
        const form = document.getElementById('categoryForm');
        
        // Luôn reset về trang 1 khi thay đổi danh mục
        document.querySelector('input[name="page"]').value = '1';
        
        if (selectedValue === '') {
            // Nếu chọn "Tất cả", xóa categoryId và reset
            window.location.href = '@Url.Action("Index", "Home")';
        } else {
            // Nếu chọn danh mục cụ thể, submit form
            form.submit();
        }
    }
</script>
