@model IEnumerable<GAMINGSTORE.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "Trang chủ";
    int numOfQuantity = 1;
}

<style>
    body {
        background: #f5f5f5;
    }

    /* ===== BANNER ===== */
    .banner-img {
        height: 350px;
        object-fit: cover;
    }

    .carousel-fade .carousel-item {
        transition: opacity 0.8s ease-in-out !important;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0,0,0,0.6);
        border-radius: 50%;
        padding: 22px;
    }

    /* ===== CATEGORY ICON ===== */
    .category-box {
        background: #fff;
        border-radius: 10px;
        padding: 12px 10px;
        text-align: center;
        cursor: pointer;
        font-weight: 600;
        border: 1px solid #eaeaea;
        transition: all 0.3s ease;
    }

    .hover-dropdown:hover .category-box {
        background-color: #f8f9fa;
        box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }

    .hover-dropdown .dropdown-menu {
        display: block;
        visibility: hidden;
        opacity: 0;
        transform: translateY(15px);
        transition: all 0.4s ease;
        margin-top: 0;
        border: none;
    }

        .hover-dropdown .dropdown-menu::before {
            content: '';
            position: absolute;
            top: -10px;
            left: 0;
            width: 100%;
            height: 10px;
            background: transparent;
        }

    .hover-dropdown:hover .dropdown-menu {
        visibility: visible;
        opacity: 1;
        transform: translateY(0);
    }

    /* ===== PRODUCT CARD ===== */
    /* ===== PRODUCT CARD ===== */
    .product-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        transition: 0.3s;
        border: 1px solid #f0f0f0;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        }

    .product-img {
        height: 200px;
        object-fit: contain; /* Sửa thành contain để ảnh không bị mất góc */
        padding: 10px;
    }

    /* ================================================== */
    /* ===== BẮT ĐẦU PHẦN CSS HOVER ĐỔI ẢNH MỚI THÊM ===== */
    /* ================================================== */
    .product-img-wrapper {
        position: relative;
        height: 200px;
        width: 100%;
        overflow: hidden;
    }

    .img-primary, .img-secondary {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain; /* Giữ nguyên tỷ lệ ảnh */
        padding: 10px;
        transition: opacity 0.6s ease-in-out; /* Thời gian chuyển mờ mượt mà */
    }

    .img-secondary {
        opacity: 0; /* Ẩn ảnh 2 đi */
    }

    /* Khi lướt chuột vào thẻ card */
    .product-card:hover .img-primary {
        opacity: 0; /* Làm mờ ảnh 1 */
    }

    .product-card:hover .img-secondary {
        opacity: 1; /* Hiện ảnh 2 lên */
    }
    /* ================================================== */
    /* ===== KẾT THÚC PHẦN CSS HOVER ĐỔI ẢNH MỚI ====== */
    /* ================================================== */

    .product-title {
        font-size: 1rem;
        font-weight: 500;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 48px;
        margin-bottom: 8px;
    }

    .price {
        color: #d92e2e;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .old-price {
        text-decoration: line-through;
        color: gray;
        font-size: 13px;
    }

    .badge-sale {
        position: absolute;
        top: 10px;
        left: 0;
        background: red;
        color: white;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: bold;
        border-radius: 0 5px 5px 0;
        z-index: 2;
    }

    .section-title {
        font-size: 24px;
        font-weight: bold;
        margin: 30px 0 15px;
        text-transform: uppercase;
    }
</style>

<div class="container mt-3">
    <div id="bannerCarousel" class="carousel slide carousel-fade shadow-sm rounded overflow-hidden" data-bs-ride="carousel" data-bs-interval="3000">

        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/banner/banner1.jpg" class="d-block w-100 banner-img" alt="Banner 1">
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/banner2.jpg" class="d-block w-100 banner-img" alt="Banner 2">
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/banner3.jpg" class="d-block w-100 banner-img" alt="Banner 3">
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="row text-center gx-2 gy-3 row-cols-2 row-cols-md-3 row-cols-lg-6">

        <!-- LAPTOP GROUP -->
        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box text-decoration-none text-dark d-block" id="dropLaptop">
                    💻 Laptop
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropLaptop">
                    <li><a class="dropdown-item fw-bold" asp-controller="Home" asp-action="Index" asp-route-categoryId="52">Laptop Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="53">Laptop Văn phòng</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" asp-controller="Home" asp-action="Index" asp-route-categoryId="54">Apple Macbook</a></li>
                </ul>
            </div>
        </div>

        <!-- PC GROUP -->
        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box text-decoration-none text-dark d-block" id="dropPC">
                    🖥 PC
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropPC">
                    <li><a class="dropdown-item fw-bold" asp-controller="Home" asp-action="Index" asp-route-categoryId="56">PC Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="57">PC Đồ họa</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="58">PC Đồng bộ</a></li>
                </ul>
            </div>
        </div>

        <!-- MONITOR GROUP -->
        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box text-decoration-none text-dark d-block" id="dropMonitor">
                    📺 Màn hình
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropMonitor">
                    <li><a class="dropdown-item fw-bold" asp-controller="Home" asp-action="Index" asp-route-categoryId="60">Màn hình Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="62">Màn hình Đồ họa</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="61">Màn hình Văn phòng</a></li>
                </ul>
            </div>
        </div>

        <!-- GEAR GROUP -->
        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box text-decoration-none text-dark d-block" id="dropGear">
                    🖱️ Gear
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropGear">
                    <li><a class="dropdown-item fw-bold" asp-controller="Home" asp-action="Index" asp-route-categoryId="64">Bàn phím cơ</a></li>
                    <li><a class="dropdown-item fw-bold" asp-controller="Home" asp-action="Index" asp-route-categoryId="65">Chuột Gaming</a></li>
                    <li><a class="dropdown-item fw-bold" asp-controller="Home" asp-action="Index" asp-route-categoryId="66">Tai nghe Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="67">Lót chuột (Mousepad)</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="68">Ghế Gaming</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="69">Loa máy tính</a></li>
                </ul>
            </div>
        </div>

        <!-- COMPONENTS GROUP -->
        <div class="col">
            <div class="dropdown hover-dropdown">
                <div class="category-box text-decoration-none text-dark d-block" id="dropComponent">
                    ⚙ Linh kiện
                </div>
                <ul class="dropdown-menu shadow" aria-labelledby="dropComponent">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="71">CPU</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="72">VGA</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="73">Mainboard</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="74">RAM</a></li>
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-categoryId="75">Ổ cứng SSD</a></li>
                </ul>
            </div>
        </div>

    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="section-title">🔥 FLASH SALE</div>

    <div class="row g-3">
        @foreach (var item in Model.Take(4))
        {
            <div class="col-6 col-md-3">
                <div class="card h-100 product-card position-relative shadow-sm">
                    <div class="badge-sale">-20%</div>

                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl.Split(';')[0])" class="card-img-top w-100 product-img" alt="@item.Name">
                    </a>

                    <div class="card-body d-flex flex-column p-3">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                            <div class="product-title">@item.Name</div>
                        </a>

                        <div class="mt-auto">
                            <div class="d-flex align-items-center mb-2">
                                <span class="price">@item.Price.ToString("#,##0") đ</span>
                                <span class="old-price ms-2">@((item.Price * 1.2M).ToString("#,##0")) đ</span>
                            </div>
                            <a asp-controller="ShoppingCart"
                               asp-action="AddToCart"
                               asp-route-productId="@item.Id"
                               asp-route-quantity="@numOfQuantity"
                               class="btn btn-outline-danger w-100 fw-bold">
                                Thêm vào giỏ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="section-title">🛒 SẢN PHẨM NỔI BẬT</div>

    <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 product-card shadow-sm position-relative">
                    <div class="badge-sale bg-warning text-dark">HOT</div>

                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl.Split(';')[0])" class="card-img-top product-img" alt="@item.Name">
                    </a>

                    <div class="card-body d-flex flex-column p-3">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                            <div class="product-title text-truncate">@item.Name</div>
                        </a>

                        <div class="mt-auto">
                            <div class="price mb-3">@item.Price.ToString("#,##0") VNĐ</div>

                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100 mb-2">
                                Chi tiết
                            </a>
                            <a asp-controller="ShoppingCart"
                               asp-action="AddToCart"
                               asp-route-productId="@item.Id"
                               asp-route-quantity="@numOfQuantity"
                               class="btn btn-primary btn-sm w-100">
                                Thêm vào giỏ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>