@model Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <a asp-action="Index" class="btn btn-secondary">
                ← Quay lại danh sách
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Order Header -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">📦 Đơn Hàng #@Model.Id</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Khách hàng:</strong> @Model.CustomerName</p>
                    <p><strong>Email:</strong> @Model.ApplicationUser?.Email</p>
                    <p><strong>Điện thoại:</strong> @Model.Phone</p>
                    <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Địa chỉ giao hàng:</strong><br/>@Model.ShippingAddress</p>
                    <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
                    @if (Model.DeliveredDate.HasValue)
                    {
                        <p><strong>Ngày giao hàng:</strong> @Model.DeliveredDate.Value.ToString("dd/MM/yyyy HH:mm")</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Current Status -->
    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0">🔄 Trạng Thái Hiện Tại</h6>
        </div>
        <div class="card-body">
            @{
                var statusColor = Model.Status switch
                {
                    "Pending" => "warning",
                    "Confirmed" => "info",
                    "Shipped" => "primary",
                    "Delivered" => "success",
                    "Cancelled" => "danger",
                    _ => "secondary"
                };

                var statusText = Model.Status switch
                {
                    "Pending" => "⏳ Chờ xử lý",
                    "Confirmed" => "✅ Đã xác nhận",
                    "Shipped" => "📦 Đang giao",
                    "Delivered" => "✔️ Đã giao hàng",
                    "Cancelled" => "❌ Đã hủy",
                    _ => Model.Status
                };
            }
            <span class="badge bg-@statusColor" style="font-size: 1.2rem; padding: 0.5rem 1rem;">
                @statusText
            </span>
        </div>
    </div>

    <!-- Order Details -->
    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0">📋 Chi Tiết Sản Phẩm</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td>@detail.Product?.Name</td>
                                <td>@detail.Quantity</td>
                                <td>@detail.Price.ToString("N0")₫</td>
                                <td>@(detail.Quantity * detail.Price).ToString("N0")₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="text-align: right; margin-top: 1rem;">
                <p>
                    <strong>Tổng tiền:</strong> 
                    <span style="font-size: 1.2rem; color: #e74c3c;">@Model.TotalPrice.ToString("N0")₫</span>
                </p>
            </div>
        </div>
    </div>

    <!-- Update Status Form -->
    <div class="card">
        <div class="card-header bg-warning">
            <h6 class="mb-0">🔧 Cập Nhật Trạng Thái</h6>
        </div>
        <div class="card-body">
            <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id">
                <div class="form-group mb-3">
                    <label for="newStatus" class="form-label">
                        <strong>Trạng thái mới:</strong>
                    </label>
                    <select id="newStatus" name="newStatus" class="form-select" required>
                        <option value="">-- Chọn trạng thái --</option>
                        @if (ViewBag.AvailableStatuses != null)
                        {
                            @foreach (var status in ViewBag.AvailableStatuses)
                            {
                                var displayText = status switch
                                {
                                    "Pending" => "⏳ Chờ xử lý",
                                    "Confirmed" => "✅ Đã xác nhận",
                                    "Shipped" => "📦 Đang giao",
                                    "Delivered" => "✔️ Đã giao hàng",
                                    "Cancelled" => "❌ Đã hủy",
                                    _ => status
                                };
                                var isSelected = (string)status == Model.Status;
                                if (isSelected)
                                {
                                    <option value="@status" selected>@displayText</option>
                                }
                                else
                                {
                                    <option value="@status">@displayText</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" onclick="return confirm('Bạn chắc chắn muốn cập nhật trạng thái?')">
                        💾 Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        ❌ Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .card-header {
        border-bottom: 2px solid #e9ecef;
    }

    .form-select {
        border: 1px solid #ddd;
        border-radius: 0.25rem;
        padding: 0.5rem;
    }

    .badge {
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

    .btn-sm {
        padding: 0.4rem 0.75rem;
        font-size: 0.85rem;
    }
</style>
