@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<style>
    .user-box {
        position: relative;
        cursor: pointer;
        color: white;
        padding: 6px 10px 6px 6px;
        border-radius: 16px;
        background: rgba(255,255,255,0.14);
        backdrop-filter: blur(10px);
        transition: all 0.25s ease;
    }

    .user-box:hover {
        background: rgba(255,255,255,0.22);
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        background: white;
        color: #ee4d2d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    /* ===== DROPDOWN MƯỢT ===== */
    .user-dropdown {
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.35s ease;
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        background: white;
        color: black;
        min-width: 220px;
        border-radius: 16px;
        box-shadow: 0 18px 35px rgba(15, 23, 42, 0.16);
        overflow: hidden;
        z-index: 9999;
        border: 1px solid rgba(15,23,42,0.08);
    }

    /* hover thì hiện */
    .user-box:hover .user-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .user-box::after {
        content: "";
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 100%;
        height: 10px;
        pointer-events: none;
    }

    /* item */
    .user-dropdown a,
    .user-dropdown button {
        display: block;
        width: 100%;
        padding: 12px 14px;
        text-align: left;
        border: none;
        background: none;
        color: #1f2937;
        text-decoration: none;
        transition: all 0.2s;
        font-weight: 600;
    }

        /* hover item */
        .user-dropdown a:hover,
        .user-dropdown button:hover {
            background: #fff4f1;
            padding-left: 18px;
        }

    .auth-btn {
        padding: 11px 16px;
        border-radius: 14px;
        font-weight: 700;
        border: none;
        transition: all 0.25s ease;
        text-decoration: none;
    }

    .auth-btn-login {
        background: white;
        color: #d63d1f;
    }

    .auth-btn-login:hover {
        color: #c13517;
        transform: translateY(-1px);
    }

    .auth-btn-register {
        background: rgba(255,255,255,0.15);
        color: white;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18);
    }

    .auth-btn-register:hover {
        background: rgba(255,255,255,0.25);
        color: white;
        transform: translateY(-1px);
    }
</style>

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var username = UserManager.GetUserName(User);
        var firstChar = username.Substring(0, 1).ToUpper();

        <li class="nav-item">
            <div class="user-box d-flex align-items-center gap-2">

                <!-- Avatar -->
                <div class="user-avatar">
                    @firstChar
                </div>

                <!-- Username -->
                <span>@username ▼</span>

                <!-- Dropdown -->
                <div class="user-dropdown">

                    <a asp-area="Identity" asp-page="/Account/Manage/Index">
                        👤 Tài khoản
                    </a>

                    <a href="#">
                        📦 Đơn hàng
                    </a>

                    <!-- LOGOUT FIX -->
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post"
                          asp-route-returnUrl="/">

                        <button type="submit">
                            🚪 Đăng xuất
                        </button>
                    </form>

                </div>
            </div>
        </li>
    }
    else
    {
        <li class="nav-item d-flex gap-2">

            <a class="auth-btn auth-btn-login"
               asp-area="Identity"
               asp-page="/Account/Login">
                Đăng nhập
            </a>

            <a class="auth-btn auth-btn-register"
               asp-area="Identity"
               asp-page="/Account/Register">
                Đăng ký
            </a>

        </li>
    }
</ul>