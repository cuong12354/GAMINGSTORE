﻿@using GAMINGSTORE.Models
@using GAMINGSTORE.Extensions

@{
    var cart = Context.Session.GetShoppingCart(Context.User);
    var totalQuantity = cart.GetTotalQuantity();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GAMINGSTORE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #ee4d2d;
            --primary-dark: #d63d1f;
            --surface: #ffffff;
            --surface-soft: #fff7f3;
            --text: #1f2937;
            --text-light: #6b7280;
            --border: rgba(15, 23, 42, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            background:
                radial-gradient(circle at top left, rgba(238, 77, 45, 0.08), transparent 24%),
                linear-gradient(180deg, #f6f7fb 0%, #eef1f6 100%);
            display: flex;
            flex-direction: column;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            color: var(--text);
        }

        /* HEADER/TOPBAR */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: linear-gradient(135deg, #ee4d2d 0%, #f05d3d 55%, #ff7a59 100%);
            color: white;
            padding: 14px 0;
            box-shadow: 0 14px 30px rgba(238, 77, 45, 0.18);
            flex-shrink: 0;
        }

        .topbar::after {
            content: "";
            position: absolute;
            inset: auto 0 0 0;
            height: 1px;
            background: rgba(255,255,255,0.18);
        }

        .topbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: 0.8px;
        }

        .logo a {
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-wrap {
            flex: 1;
            max-width: 470px;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px;
            border-radius: 18px;
            background: rgba(255,255,255,0.18);
            backdrop-filter: blur(10px);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
        }

        .search-box {
            width: 100%;
            border-radius: 14px;
            border: none;
            padding: 12px 16px;
            font-size: 14px;
            background: white;
            color: var(--text);
        }

        .search-box::placeholder {
            color: #999;
        }

        .search-box:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(255,255,255,0.2);
        }

        .search-btn {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            cursor: pointer;
            font-size: 18px;
            transition: 0.25s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .search-btn:hover {
            background: rgba(255,255,255,0.28);
            transform: translateY(-1px);
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .cart-btn {
            width: 48px;
            height: 48px;
            font-size: 22px;
            color: white;
            text-decoration: none;
            position: relative;
            transition: 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: rgba(255,255,255,0.16);
            backdrop-filter: blur(10px);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
        }

        .cart-btn:hover {
            transform: translateY(-1px);
            color: white;
            background: rgba(255,255,255,0.24);
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -12px;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            border: 2px solid #ee4d2d;
        }

        /* CONTENT */
        .main-content {
            flex: 1;
        }

        .container {
            max-width: 1220px;
            margin: 0 auto;
            padding: 0 18px;
        }

        /* FOOTER */
        footer {
            background:
                radial-gradient(circle at top right, rgba(238, 77, 45, 0.14), transparent 22%),
                linear-gradient(180deg, #202338 0%, #171a2a 100%);
            color: white;
            margin-top: auto;
            padding: 54px 0 24px;
            border-top: none;
            flex-shrink: 0;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 30px;
        }

        .footer-section h5 {
            color: #fff;
            font-weight: 800;
            margin-bottom: 16px;
            font-size: 16px;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section ul li {
            margin-bottom: 8px;
        }

        .footer-section a {
            color: rgba(255,255,255,0.72);
            text-decoration: none;
            transition: 0.3s;
        }

        .footer-section a:hover {
            color: #fff;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 22px;
            text-align: center;
            color: rgba(255,255,255,0.56);
            font-size: 13px;
        }

        /* RESPONSIVE */
        @@media (max-width: 768px) {
            .topbar-inner {
                flex-wrap: wrap;
            }

            .logo {
                font-size: 20px;
            }

            .search-wrap {
                order: 3;
                max-width: none;
                width: 100%;
            }

            .topbar-actions {
                gap: 10px;
            }
        }

        .sales-chatbot {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 1050;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 14px;
        }

        .sales-chatbot-panel {
            width: min(390px, calc(100vw - 28px));
            height: 560px;
            max-height: calc(100vh - 110px);
            border-radius: 26px;
            overflow: hidden;
            background: rgba(255,255,255,0.98);
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
            display: none;
            flex-direction: column;
        }

        .sales-chatbot.is-open .sales-chatbot-panel {
            display: flex;
        }

        .sales-chatbot-header {
            padding: 18px 18px 16px;
            color: white;
            background: linear-gradient(135deg, #ee4d2d, #d63d1f 72%, #ff7a59);
        }

        .sales-chatbot-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .sales-chatbot-title-icon {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.18);
            font-size: 18px;
        }

        .sales-chatbot-subtitle {
            font-size: 13px;
            line-height: 1.6;
            color: rgba(255,255,255,0.86);
            margin: 0;
        }

        .sales-chatbot-body {
            flex: 1;
            padding: 16px;
            background: linear-gradient(180deg, #fff9f6 0%, #f8fafc 100%);
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sales-chat-message {
            max-width: 88%;
            padding: 12px 14px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.7;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
        }

        .sales-chat-message.bot {
            align-self: flex-start;
            background: white;
            color: var(--text);
            border-top-left-radius: 8px;
        }

        .sales-chat-message.user {
            align-self: flex-end;
            background: linear-gradient(135deg, #ee4d2d, #d63d1f);
            color: white;
            border-top-right-radius: 8px;
        }

        .sales-chat-product-list {
            display: grid;
            gap: 10px;
        }

        .sales-chat-product {
            display: grid;
            grid-template-columns: 70px minmax(0, 1fr);
            gap: 12px;
            padding: 12px;
            border-radius: 18px;
            background: white;
            text-decoration: none;
            color: inherit;
            border: 1px solid rgba(15, 23, 42, 0.06);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
        }

        .sales-chat-product img {
            width: 70px;
            height: 70px;
            object-fit: contain;
            border-radius: 14px;
            background: linear-gradient(180deg, #fff8f5, #f8fafc);
            padding: 8px;
        }

        .sales-chat-product-name {
            font-size: 14px;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 6px;
            line-height: 1.45;
        }

        .sales-chat-product-meta {
            font-size: 12px;
            color: var(--text-light);
            margin-bottom: 8px;
        }

        .sales-chat-product-price {
            font-size: 16px;
            font-weight: 800;
            color: var(--primary);
        }

        .sales-chat-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 2px;
        }

        .sales-chat-suggestion {
            min-height: 34px;
            padding: 0 12px;
            border-radius: 999px;
            border: 1px solid rgba(238, 77, 45, 0.16);
            background: white;
            color: var(--primary-dark);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .sales-chat-input-wrap {
            padding: 14px;
            border-top: 1px solid rgba(15, 23, 42, 0.06);
            background: white;
        }

        .sales-chat-form {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 52px;
            gap: 10px;
        }

        .sales-chat-input {
            min-height: 52px;
            border-radius: 16px;
            border: 1px solid rgba(15, 23, 42, 0.08);
            padding: 0 16px;
            font-size: 14px;
            color: var(--text);
            background: #fbfcfd;
        }

        .sales-chat-input:focus {
            outline: none;
            border-color: rgba(238, 77, 45, 0.5);
            box-shadow: 0 0 0 4px rgba(238, 77, 45, 0.12);
        }

        .sales-chat-send,
        .sales-chat-toggle {
            border: none;
            color: white;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #ee4d2d, #d63d1f);
        }

        .sales-chat-send {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            box-shadow: 0 14px 28px rgba(238, 77, 45, 0.18);
        }

        .sales-chat-toggle {
            width: 62px;
            height: 62px;
            border-radius: 22px;
            font-size: 24px;
            box-shadow: 0 18px 34px rgba(238, 77, 45, 0.25);
        }

        .sales-chatbot.is-open .sales-chat-toggle {
            background: linear-gradient(135deg, #212245, #2f325f);
        }

        .sales-chat-typing {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .sales-chat-typing span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(31, 41, 55, 0.4);
            animation: sales-chat-pulse 1.1s infinite ease-in-out;
        }

        .sales-chat-typing span:nth-child(2) {
            animation-delay: 0.12s;
        }

        .sales-chat-typing span:nth-child(3) {
            animation-delay: 0.24s;
        }

        @@keyframes sales-chat-pulse {
            0%, 80%, 100% { transform: scale(0.7); opacity: 0.45; }
            40% { transform: scale(1); opacity: 1; }
        }

        @@media (max-width: 768px) {
            .sales-chatbot {
                right: 14px;
                bottom: 14px;
            }

            .sales-chatbot-panel {
                width: min(100vw - 18px, 390px);
                height: min(76vh, 560px);
            }
        }
    </style>
</head>



<body>
    <!-- HEADER -->
    <div class="topbar">
        <div class="container topbar-inner">
            <!-- LOGO -->
            <div class="logo">
                <a asp-area="" asp-controller="Home" asp-action="Index">🎮 GAMINGSTORE</a>
            </div>

            <!-- SEARCH -->
            <div class="search-wrap">
                <form asp-area="" asp-controller="Home" asp-action="Index" method="get" class="search-form">
                    <input class="search-box"
                           type="text"
                           name="searchString"
                           placeholder="Tìm sản phẩm..." 
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="search-btn">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <!-- CART + LOGIN -->
            <div class="topbar-actions">
                <a asp-area="" asp-controller="ShoppingCart" asp-action="Index" class="cart-btn">
                    <i class="bi bi-cart-fill"></i>
                    @if (totalQuantity > 0)
                    {
                        <span class="cart-badge">@totalQuantity</span>
                    }
                </a>

                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h5>🎮 GAMINGSTORE</h5>
                    <p style="color: rgba(255,255,255,0.72); line-height: 1.8;">Nền tảng mua sắm thiết bị gaming với trải nghiệm hiện đại, lọc sản phẩm nhanh và quy trình đặt hàng gọn gàng.</p>
                </div>

                <div class="footer-section">
                    <h5>📚 Hỗ Trợ</h5>
                    <ul>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>📞 Liên Hệ</h5>
                    <ul>
                        <li><strong>📧 Email:</strong> support@gamingstore.com</li>
                        <li><strong>📱 Hotline:</strong> 1900.xxx.xxx</li>
                        <li><strong>📍 Địa chỉ:</strong> 123 Đường ABC, TP.HCM</li>
                        <li><strong>⏰ Giờ làm:</strong> 8:00 - 22:00 (T2-CN)</li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>🤝 Theo Dõi</h5>
                    <div style="display: flex; gap: 12px;">
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">f</a>
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">📷</a>
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">▶</a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 <strong>GAMINGSTORE</strong> - Tất cả các quyền được bảo lưu | Thiết kế và phát triển bởi <strong>Dev Team</strong></p>
            </div>
        </div>
    </footer>

    <div class="sales-chatbot" id="salesChatbot" data-sales-chat-url="@Url.Action("Ask", "SalesChat")">
        <div class="sales-chatbot-panel">
            <div class="sales-chatbot-header">
                <div class="sales-chatbot-title">
                    <span class="sales-chatbot-title-icon"><i class="bi bi-headset"></i></span>
                    <span>Trợ lý bán hàng</span>
                </div>
                <p class="sales-chatbot-subtitle">Hỏi theo nhu cầu, danh mục hoặc giá. Ví dụ: laptop gaming dưới 20 triệu, chuột RGB, màn hình 27 inch.</p>
            </div>

            <div class="sales-chatbot-body" id="salesChatMessages"></div>

            <div class="sales-chat-input-wrap">
                <form class="sales-chat-form" id="salesChatForm">
                    <input id="salesChatInput" class="sales-chat-input" type="text" placeholder="Nhập nhu cầu mua sắm của bạn..." autocomplete="off" />
                    <button class="sales-chat-send" type="submit" aria-label="Gửi tin nhắn">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>
        </div>

        <button class="sales-chat-toggle" id="salesChatToggle" type="button" aria-label="Mở chatbot bán hàng">
            <i class="bi bi-chat-dots-fill"></i>
        </button>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>