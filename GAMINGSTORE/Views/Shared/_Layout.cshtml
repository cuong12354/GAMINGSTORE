﻿@using GAMINGSTORE.Models
@using GAMINGSTORE.Extensions

@{
    var cart = Context.Session.GetShoppingCart(Context.User);
    var totalQuantity = cart.GetTotalQuantity();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GAMINGSTORE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            background: #f5f5f5;
            display: flex;
            flex-direction: column;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        /* HEADER/TOPBAR */
        .topbar {
            background: linear-gradient(135deg, #ee4d2d 0%, #f05d3d 100%);
            color: white;
            padding: 12px 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            flex-shrink: 0;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .logo a {
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-box {
            width: 100%;
            border-radius: 6px;
            border: none;
            padding: 12px 15px;
            font-size: 14px;
            background: white;
        }

        .search-box::placeholder {
            color: #999;
        }

        .search-box:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(255,255,255,0.2);
        }

        .search-btn {
            background: transparent;
            border: none;
            color: white;
            padding: 0 15px;
            cursor: pointer;
            font-size: 18px;
            transition: 0.3s;
        }

        .search-btn:hover {
            transform: scale(1.1);
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .cart-btn {
            font-size: 22px;
            color: white;
            text-decoration: none;
            position: relative;
            transition: 0.3s;
            display: flex;
            align-items: center;
        }

        .cart-btn:hover {
            transform: scale(1.1);
            color: white;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -12px;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            border: 2px solid #ee4d2d;
        }

        /* CONTENT */
        .main-content {
            flex: 1;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

        /* FOOTER */
        footer {
            background: #333;
            color: white;
            margin-top: auto;
            padding: 40px 0 20px;
            border-top: none;
            flex-shrink: 0;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 30px;
        }

        .footer-section h5 {
            color: #ee4d2d;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section ul li {
            margin-bottom: 8px;
        }

        .footer-section a {
            color: #ccc;
            text-decoration: none;
            transition: 0.3s;
        }

        .footer-section a:hover {
            color: #ee4d2d;
        }

        .footer-bottom {
            border-top: 1px solid #555;
            padding-top: 20px;
            text-align: center;
            color: #999;
            font-size: 13px;
        }

        /* RESPONSIVE */
        @@media (max-width: 768px) {
            .logo {
                font-size: 20px;
            }

            .topbar-actions {
                gap: 10px;
            }
        }
    </style>
</head>



<body>
    <!-- HEADER -->
    <div class="topbar">
        <div class="container d-flex align-items-center justify-content-between" style="gap: 20px;">
            <!-- LOGO -->
            <div class="logo">
                <a asp-controller="Home" asp-action="Index">🎮 GAMINGSTORE</a>
            </div>

            <!-- SEARCH -->
            <div style="flex: 1; max-width: 400px;">
                <form asp-controller="Home" asp-action="Index" method="get" class="d-flex" style="gap: 0;">
                    <input class="search-box"
                           type="text"
                           name="searchString"
                           placeholder="Tìm sản phẩm..." 
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="search-btn">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <!-- CART + LOGIN -->
            <div class="topbar-actions">
                <a asp-controller="ShoppingCart" asp-action="Index" class="cart-btn">
                    <i class="bi bi-cart-fill"></i>
                    @if (totalQuantity > 0)
                    {
                        <span class="cart-badge">@totalQuantity</span>
                    }
                </a>

                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h5>🎮 GAMINGSTORE</h5>
                    <p>Cửa hàng bán thiết bị gaming, laptop, PC và linh kiện máy tính chất lượng cao.</p>
                </div>

                <div class="footer-section">
                    <h5>📚 Hỗ Trợ</h5>
                    <ul>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>📞 Liên Hệ</h5>
                    <ul>
                        <li><strong>📧 Email:</strong> support@gamingstore.com</li>
                        <li><strong>📱 Hotline:</strong> 1900.xxx.xxx</li>
                        <li><strong>📍 Địa chỉ:</strong> 123 Đường ABC, TP.HCM</li>
                        <li><strong>⏰ Giờ làm:</strong> 8:00 - 22:00 (T2-CN)</li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>🤝 Theo Dõi</h5>
                    <div style="display: flex; gap: 15px;">
                        <a href="#" style="font-size: 24px;">f</a>
                        <a href="#" style="font-size: 24px;">📷</a>
                        <a href="#" style="font-size: 24px;">▶</a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 <strong>GAMINGSTORE</strong> - Tất cả các quyền được bảo lưu | Thiết kế và phát triển bởi <strong>Dev Team</strong></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>