﻿@using GAMINGSTORE.Models
@using GAMINGSTORE.Extensions

@{
    var cart = Context.Session.GetShoppingCart(Context.User);
    var totalQuantity = cart.GetTotalQuantity();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GAMINGSTORE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #ee4d2d;
            --primary-dark: #d63d1f;
            --surface: #ffffff;
            --surface-soft: #fff7f3;
            --text: #1f2937;
            --text-light: #6b7280;
            --border: rgba(15, 23, 42, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            background:
                radial-gradient(circle at top left, rgba(238, 77, 45, 0.08), transparent 24%),
                linear-gradient(180deg, #f6f7fb 0%, #eef1f6 100%);
            display: flex;
            flex-direction: column;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            color: var(--text);
        }

        /* HEADER/TOPBAR */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: linear-gradient(135deg, #ee4d2d 0%, #f05d3d 55%, #ff7a59 100%);
            color: white;
            padding: 14px 0;
            box-shadow: 0 14px 30px rgba(238, 77, 45, 0.18);
            flex-shrink: 0;
        }

        .topbar::after {
            content: "";
            position: absolute;
            inset: auto 0 0 0;
            height: 1px;
            background: rgba(255,255,255,0.18);
        }

        .topbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: 0.8px;
        }

        .logo a {
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-wrap {
            flex: 1;
            max-width: 470px;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px;
            border-radius: 18px;
            background: rgba(255,255,255,0.18);
            backdrop-filter: blur(10px);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
        }

        .search-box {
            width: 100%;
            border-radius: 14px;
            border: none;
            padding: 12px 16px;
            font-size: 14px;
            background: white;
            color: var(--text);
        }

        .search-box::placeholder {
            color: #999;
        }

        .search-box:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(255,255,255,0.2);
        }

        .search-btn {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            cursor: pointer;
            font-size: 18px;
            transition: 0.25s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .search-btn:hover {
            background: rgba(255,255,255,0.28);
            transform: translateY(-1px);
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .cart-btn {
            width: 48px;
            height: 48px;
            font-size: 22px;
            color: white;
            text-decoration: none;
            position: relative;
            transition: 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: rgba(255,255,255,0.16);
            backdrop-filter: blur(10px);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
        }

        .cart-btn:hover {
            transform: translateY(-1px);
            color: white;
            background: rgba(255,255,255,0.24);
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -12px;
            background: #ff4444;
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            border: 2px solid #ee4d2d;
        }

        /* CONTENT */
        .main-content {
            flex: 1;
        }

        .container {
            max-width: 1220px;
            margin: 0 auto;
            padding: 0 18px;
        }

        /* FOOTER */
        footer {
            background:
                radial-gradient(circle at top right, rgba(238, 77, 45, 0.14), transparent 22%),
                linear-gradient(180deg, #202338 0%, #171a2a 100%);
            color: white;
            margin-top: auto;
            padding: 54px 0 24px;
            border-top: none;
            flex-shrink: 0;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 30px;
        }

        .footer-section h5 {
            color: #fff;
            font-weight: 800;
            margin-bottom: 16px;
            font-size: 16px;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section ul li {
            margin-bottom: 8px;
        }

        .footer-section a {
            color: rgba(255,255,255,0.72);
            text-decoration: none;
            transition: 0.3s;
        }

        .footer-section a:hover {
            color: #fff;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 22px;
            text-align: center;
            color: rgba(255,255,255,0.56);
            font-size: 13px;
        }

        /* RESPONSIVE */
        @@media (max-width: 768px) {
            .topbar-inner {
                flex-wrap: wrap;
            }

            .logo {
                font-size: 20px;
            }

            .search-wrap {
                order: 3;
                max-width: none;
                width: 100%;
            }

            .topbar-actions {
                gap: 10px;
            }
        }
    </style>
</head>



<body>
    <!-- HEADER -->
    <div class="topbar">
        <div class="container topbar-inner">
            <!-- LOGO -->
            <div class="logo">
                <a asp-area="" asp-controller="Home" asp-action="Index">🎮 GAMINGSTORE</a>
            </div>

            <!-- SEARCH -->
            <div class="search-wrap">
                <form asp-area="" asp-controller="Home" asp-action="Index" method="get" class="search-form">
                    <input class="search-box"
                           type="text"
                           name="searchString"
                           placeholder="Tìm sản phẩm..." 
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="search-btn">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <!-- CART + LOGIN -->
            <div class="topbar-actions">
                <a asp-area="" asp-controller="ShoppingCart" asp-action="Index" class="cart-btn">
                    <i class="bi bi-cart-fill"></i>
                    @if (totalQuantity > 0)
                    {
                        <span class="cart-badge">@totalQuantity</span>
                    }
                </a>

                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h5>🎮 GAMINGSTORE</h5>
                    <p style="color: rgba(255,255,255,0.72); line-height: 1.8;">Nền tảng mua sắm thiết bị gaming với trải nghiệm hiện đại, lọc sản phẩm nhanh và quy trình đặt hàng gọn gàng.</p>
                </div>

                <div class="footer-section">
                    <h5>📚 Hỗ Trợ</h5>
                    <ul>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>📞 Liên Hệ</h5>
                    <ul>
                        <li><strong>📧 Email:</strong> support@gamingstore.com</li>
                        <li><strong>📱 Hotline:</strong> 1900.xxx.xxx</li>
                        <li><strong>📍 Địa chỉ:</strong> 123 Đường ABC, TP.HCM</li>
                        <li><strong>⏰ Giờ làm:</strong> 8:00 - 22:00 (T2-CN)</li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h5>🤝 Theo Dõi</h5>
                    <div style="display: flex; gap: 12px;">
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">f</a>
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">📷</a>
                        <a href="#" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: rgba(255,255,255,0.08); font-size: 18px;">▶</a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 <strong>GAMINGSTORE</strong> - Tất cả các quyền được bảo lưu | Thiết kế và phát triển bởi <strong>Dev Team</strong></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>