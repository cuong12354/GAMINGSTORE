﻿@using GAMINGSTORE.Models
@using GAMINGSTORE.Extensions

@{
    var cart = Context.Session.GetObjectFromJson<ShoppingCart>("Cart") ?? new ShoppingCart();
    var totalQuantity = cart.GetTotalQuantity();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GAMINGSTORE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f5f5;
        }

        /* HEADER */
        .topbar {
            background: linear-gradient(180deg,#f53d2d,#f63);
            color: white;
            padding: 10px 0;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .search-box {
            width: 100%;
            border-radius: 4px;
            border: none;
            padding: 10px;
        }

        .search-btn {
            background: #fb5533;
            border: none;
            color: white;
            padding: 10px 15px;
        }

        .cart-btn {
            font-size: 20px;
            color: white;
        }

        /* MENU */
        .menu-bar {
            background: white;
            border-bottom: 1px solid #eee;
        }

        .menu-item {
            padding: 12px 16px;
            cursor: pointer;
            position: relative;
        }

            .menu-item:hover {
                color: #ee4d2d;
            }

        /* DROPDOWN */
        .dropdown-custom {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: white;
            border: 1px solid #eee;
            padding: 10px;
            min-width: 150px;
            z-index: 1000;
        }

        .menu-item:hover .dropdown-custom {
            display: block;
        }

        .dropdown-custom div {
            padding: 5px 0;
            cursor: pointer;
        }

            .dropdown-custom div:hover {
                color: #ee4d2d;
            }

        .dropdown-custom a {
            display: block;
            padding: 8px 10px;
            text-decoration: none;
            color: black;
        }

            .dropdown-custom a:hover {
                background: #f5f5f5;
                color: #ee4d2d;
            }
    </style>
</head>



<body>

    <!-- HEADER -->
    <div class="topbar">
        <div class="container d-flex align-items-center justify-content-between">

            <!-- LOGO -->
            <div class="logo">
                <a asp-controller="Home" asp-action="Index" style="color:white; text-decoration:none;">
                    GAMINGSTORE
                </a>
            </div>

            <!-- SEARCH -->
            <div class="d-flex" style="width:50%">
                <form asp-controller="Home" asp-action="Index" method="get" class="d-flex w-100">
                    <input class="search-box"
                           type="text"
                           name="searchString"
                           placeholder="Tìm sản phẩm..." />

                    <button type="submit" class="search-btn">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <!-- CART + LOGIN -->
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="ShoppingCart" asp-action="Index" class="cart-btn position-relative">
                    <i class="bi bi-cart"></i>

                    @if (totalQuantity > 0)
                    {
                        <span style="
                    position:absolute;
                    top:-5px;
                    right:-10px;
                    background:red;
                    color:white;
                    border-radius:50%;
                    padding:2px 6px;
                    font-size:12px;">
                            @totalQuantity
                        </span>
                    }
                </a>

                <partial name="_LoginPartial" />
            </div>

        </div>
    </div>

    <!-- MENU -->
    <div class="menu-bar">
        <div class="container d-flex">

            <!-- Laptop -->
            <div class="menu-item">
                Laptop
                <div class="dropdown-custom">
                    <a asp-controller="Home" asp-action="Index" asp-route-category="Laptop-ASUS">ASUS</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-category="Laptop-Dell">Dell</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-category="Laptop-HP">HP</a>
                </div>
            </div>

            <!-- PC -->
            <div class="menu-item">
                PC
                <div class="dropdown-custom">
                    <a asp-controller="Home" asp-action="Index" asp-route-category="PC-Gaming">Gaming</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-category="PC-Office">Văn phòng</a>
                </div>
            </div>

            <!-- Màn hình -->
            <div class="menu-item">
                Màn hình
                <div class="dropdown-custom">
                    <a asp-controller="Home" asp-action="Index" asp-route-category="Monitor-LG">LG</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-category="Monitor-Samsung">Samsung</a>
                </div>
            </div>

            <!-- Linh kiện -->
            <div class="menu-item">
                Linh kiện
                <div class="dropdown-custom">
                    <a asp-controller="Home" asp-action="Index" asp-route-category="RAM">RAM</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-category="SSD">SSD</a>
                </div>
            </div>

            <!-- Build PC -->
            <div class="menu-item">
                <a asp-controller="Home" asp-action="BuildPC">Tự chọn cấu hình</a>
            </div>

        </div>
    </div>

    <!-- CONTENT -->
    <div class="container mt-3">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="border-top mt-5 p-3 text-center">
        © 2026 - GAMINGSTORE
    </footer>



    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>