@model GAMINGSTORE.Models.Product

@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4">Add Product</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="form-group mb-3">
            <label asp-for="Name" class="fw-bold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Price" class="fw-bold"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="fw-bold">Category (Có thể chọn nhiều)</label>
            <select name="categoryIds" asp-items="ViewBag.CategoryList" class="form-control" multiple style="height: 120px;">
            </select>
            <small class="text-muted text-danger">Mẹo: Giữ phím Ctrl (hoặc Cmd trên Mac) và click chuột để chọn nhiều danh mục cùng lúc.</small>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Description" class="fw-bold"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label class="fw-bold">Chọn ảnh sản phẩm (Có thể chọn nhiều ảnh)</label>
            <input type="file" name="imageFiles" class="form-control" multiple accept="image/*" />
            <small class="text-muted">Giữ phím Ctrl (hoặc Cmd) để chọn nhiều file cùng lúc.</small>
        </div>

        <button type="submit" class="btn btn-primary px-4 fw-bold">Add</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}