@model GAMINGSTORE.Models.Product

@{
    ViewData["Title"] = Model.Name; // Gán tên sản phẩm vào tiêu đề trang
}

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Cửa hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm p-3">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm" style="max-height: 500px; object-fit: contain;" />
                }
                else
                {
                    <img src="/images/no-image.png" alt="No Image" class="img-fluid rounded" />
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="ps-md-4">
                <h1 class="display-6 fw-bold mb-3">@Model.Name</h1>

                <h3 class="text-danger fw-bold mb-4">
                    @Model.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                </h3>

                <div class="mb-4">
                    <h5 class="fw-semibold">Mô tả sản phẩm:</h5>
                    <p class="text-muted" style="line-height: 1.8; text-align: justify;">
                        @Model.Description
                    </p>
                </div>

                <div class="d-flex align-items-center gap-3 mt-5">
                    <div class="input-group" style="width: 130px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="decreaseQty()">-</button>
                        <input type="number" id="quantity" class="form-control text-center" value="1" min="1">
                        <button class="btn btn-outline-secondary" type="button" onclick="increaseQty()">+</button>
                    </div>

                    <button class="btn btn-primary btn-lg px-4 flex-grow-1 shadow-sm">
                        <i class="bi bi-cart-plus-fill me-2"></i> Thêm vào giỏ hàng
                    </button>
                </div>

                <div class="mt-4 border-top pt-3">
                    <a asp-action="Index" class="btn btn-outline-dark">
                        <i class="bi bi-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script đơn giản để tăng giảm số lượng
        function increaseQty() {
            let input = document.getElementById('quantity');
            input.value = parseInt(input.value) + 1;
        }
        function decreaseQty() {
            let input = document.getElementById('quantity');
            if(input.value > 1) input.value = parseInt(input.value) - 1;
        }
    </script>
}