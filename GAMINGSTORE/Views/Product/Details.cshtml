@model GAMINGSTORE.Models.Product

@{
    ViewData["Title"] = Model.Name;

    // Tách chuỗi ảnh (ngăn cách bởi dấu ;) thành một mảng
    var imageUrls = string.IsNullOrEmpty(Model.ImageUrl)
        ? new string[] { "/images/no-image.png" }
        : Model.ImageUrl.Split(';', StringSplitOptions.RemoveEmptyEntries);
}

<style>
    /* CSS cho khu vực Slider ảnh */
    .product-gallery {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        padding: 15px;
    }

    .main-image-container {
        height: 420px;
        background-color: #fff;
        border-radius: 8px;
    }

        .main-image-container .carousel-item {
            height: 100%;
            text-align: center;
        }

        .main-image-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
            margin: 0 auto;
        }

    /* CSS 2 nút trượt ảnh */
    .gallery-control-icon {
        background-color: rgba(0,0,0,0.2);
        border-radius: 50%;
        padding: 20px;
    }

    .carousel-control-prev:hover .gallery-control-icon,
    .carousel-control-next:hover .gallery-control-icon {
        background-color: rgba(0,0,0,0.5);
    }

    /* CSS cho dãy ảnh nhỏ (Thumbnails) */
    .thumbnail-container {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 15px;
        overflow-x: auto;
    }

    .thumbnail-btn {
        border: 2px solid transparent;
        background: #fff;
        border-radius: 8px;
        padding: 5px;
        width: 75px;
        height: 75px;
        cursor: pointer;
        transition: 0.3s;
    }

        .thumbnail-btn img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .thumbnail-btn.active, .thumbnail-btn:hover {
            border-color: #ee4d2d; /* Đổi viền thành màu đỏ của shop */
        }
</style>

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-danger fw-bold">Cửa hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">

        <div class="col-md-5 mb-4 mb-md-0">
            <div class="product-gallery">

                <div id="productCarousel" class="carousel slide" data-bs-ride="false">
                    <div class="carousel-inner main-image-container">
                        @for (int i = 0; i < imageUrls.Length; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "") h-100">
                                <img src="@imageUrls[i]" class="d-block w-100 h-100" alt="Ảnh sản phẩm @i">
                            </div>
                        }
                    </div>

                    @if (imageUrls.Length > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon gallery-control-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon gallery-control-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    }
                </div>

                @if (imageUrls.Length > 1)
                {
                    <div class="thumbnail-container pb-2">
                        @for (int i = 0; i < imageUrls.Length; i++)
                        {
                            <button type="button" data-bs-target="#productCarousel" data-bs-slide-to="@i" class="thumbnail-btn @(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")">
                                <img src="@imageUrls[i]" alt="Thumbnail @i" />
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-md-7">
            <div class="ps-md-4 d-flex flex-column h-100">
                <h2 class="fw-bold mb-3">@Model.Name</h2>

                <div class="bg-light p-3 rounded mb-4">
                    <h3 class="text-danger fw-bold mb-0">
                        @Model.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                    </h3>
                </div>

                <div class="mb-4 flex-grow-1">
                    <h5 class="fw-bold text-uppercase border-bottom pb-2 mb-3">Thông tin chi tiết</h5>
                    <p class="text-muted" style="line-height: 1.8; text-align: justify; white-space: pre-wrap;">
                        @(string.IsNullOrEmpty(Model.Description) ? "Đang cập nhật mô tả..." : Model.Description)
                    </p>
                </div>

                <div class="mt-auto border-top pt-4">
                    <form asp-controller="ShoppingCart" asp-action="AddToCart" method="get" class="d-flex align-items-center gap-3">
                        <input type="hidden" name="productId" value="@Model.Id" />

                        <div class="input-group shadow-sm" style="width: 140px;">
                            <button class="btn btn-outline-secondary fw-bold" type="button" onclick="decreaseQty()">-</button>
                            <input type="number" id="quantity" name="quantity" class="form-control text-center fw-bold bg-white" value="1" min="1" readonly>
                            <button class="btn btn-outline-secondary fw-bold" type="button" onclick="increaseQty()">+</button>
                        </div>

                        <button type="submit" class="btn btn-danger btn-lg px-4 flex-grow-1 shadow-sm fw-bold">
                            <i class="bi bi-cart-plus-fill me-2"></i> Thêm vào giỏ hàng
                        </button>
                    </form>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Script tăng giảm số lượng an toàn
        function increaseQty() {
            let input = document.getElementById('quantity');
            let currentVal = parseInt(input.value);
            if(currentVal < 50) { // Giới hạn mua tối đa 50 cái
                input.value = currentVal + 1;
            }
        }
        function decreaseQty() {
            let input = document.getElementById('quantity');
            let currentVal = parseInt(input.value);
            if(currentVal > 1) { // Không cho phép âm hoặc = 0
                input.value = currentVal - 1;
            }
        }
    </script>
}