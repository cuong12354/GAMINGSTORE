@model IEnumerable<GAMINGSTORE.Models.Product>

@{
    ViewData["Title"] = "Danh mục: " + ViewBag.CurrentKeyword;
    int numOfQuantity = 1;
}

<style>
    .product-card {
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid #f0f0f0;
        border-radius: 10px;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

    .product-img {
        height: 220px;
        object-fit: cover;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .product-title {
        font-size: 1.05rem;
        font-weight: 600;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 48px;
    }
</style>

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="text-uppercase mb-0">
            KẾT QUẢ CHO: <span class="text-danger fw-bold">@ViewBag.CurrentKeyword</span>
        </h3>
        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary">Quay lại trang chủ</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded shadow-sm border">
            <i class="bi-box-seam text-muted" style="font-size: 4rem;"></i>
            <h4 class="text-muted mt-3">Hiện chưa có sản phẩm nào thuộc danh mục này!</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-3 px-4">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 product-card">

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl.Split(';')[0])" class="card-img-top product-img" alt="@item.Name">
                        </a>

                        <div class="card-body d-flex flex-column">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark mb-2">
                                <h5 class="card-title product-title">@item.Name</h5>
                            </a>

                            <div class="mt-auto">
                                <p class="text-danger fw-bold fs-5 mb-3">@item.Price.ToString("#,##0") VNĐ</p>
                                <a asp-controller="ShoppingCart"
                                   asp-action="AddToCart"
                                   asp-route-productId="@item.Id"
                                   asp-route-quantity="@numOfQuantity"
                                   class="btn btn-danger w-100 fw-bold">
                                    Thêm vào giỏ
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>