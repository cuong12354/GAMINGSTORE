@model ShoppingCart

<h2 class="mb-4">🛒 Giỏ Hàng</h2>

<table class="table table-bordered text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Total</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>

                <!--NÚT TĂNG GIẢM -->
                <td>
                    <a asp-action="Decrease" asp-route-productId="@item.ProductId"
                       class="btn btn-sm btn-outline-danger">-</a>

                    <span class="mx-2 fw-bold">@item.Quantity</span>

                    <a asp-action="Increase" asp-route-productId="@item.ProductId"
                       class="btn btn-sm btn-outline-success">+</a>
                </td>

                <td>@item.Price.ToString("#,##0") Vnđ</td>

                <td>@(item.Price* item.Quantity) Vnđ</td>

                <td>
                    <a asp-action="RemoveFromCart"
                       asp-route-productId="@item.ProductId"
                       class="btn btn-sm btn-danger">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!--TỔNG TIỀN -->
<div class="text-end fw-bold fs-5">
    Tổng tiền:
    @Model.Items.Sum(x => x.Price * x.Quantity).ToString("#,##0") Vnđ
</div>

<!--NÚT -->
<div class="mt-3">
    <a asp-action="ClearCart" class="btn btn-warning">Xóa hết</a>

    <a asp-action="Checkout" class="btn btn-success">
        Thanh toán
    </a>
</div>