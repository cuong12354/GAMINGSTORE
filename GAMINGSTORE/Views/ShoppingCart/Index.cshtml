@model ShoppingCart

@{
    ViewData["Title"] = "Giỏ Hàng";
}

<style>
    :root {
        --primary: #ee4d2d;
        --primary-dark: #d63d1f;
        --surface: #ffffff;
        --surface-soft: #fff7f3;
        --text: #1f2937;
        --text-light: #6b7280;
        --border: rgba(15, 23, 42, 0.08);
        --danger: #d73a49;
    }

    .cart-page {
        padding: 36px 0 56px;
    }

    .cart-hero {
        background:
            radial-gradient(circle at top right, rgba(238, 77, 45, 0.16), transparent 30%),
            linear-gradient(135deg, #ffffff, #fff6f2);
        border: 1px solid rgba(238, 77, 45, 0.08);
        border-radius: 24px;
        box-shadow: 0 18px 44px rgba(15, 23, 42, 0.07);
        padding: 26px 28px;
        margin-bottom: 24px;
    }

    .cart-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(238, 77, 45, 0.1);
        color: var(--primary-dark);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 14px;
    }

    .cart-title {
        font-size: 34px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 8px;
    }

    .cart-subtitle {
        color: var(--text-light);
        font-size: 15px;
        line-height: 1.7;
        max-width: 700px;
        margin: 0;
    }

    .cart-card,
    .cart-summary {
        background: var(--surface);
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
        border: 1px solid var(--border);
    }

    .cart-card {
        overflow: hidden;
    }

    .cart-table {
        margin: 0;
        border: none;
    }

    .cart-table thead {
        background: linear-gradient(180deg, #fff8f5 0%, #fff 100%);
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    }

    .cart-table th {
        color: var(--text-light);
        font-weight: 800;
        padding: 18px 20px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        border: none;
    }

    .cart-table td {
        padding: 18px 20px;
        vertical-align: middle;
        border-color: rgba(15, 23, 42, 0.06);
    }

    .product-cell {
        max-width: 360px;
    }

    .product-name {
        font-weight: 800;
        color: var(--text);
        font-size: 15px;
        margin-bottom: 4px;
    }

    .product-meta {
        color: var(--text-light);
        font-size: 13px;
    }

    .qty-control {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 16px;
        background: #f8fafc;
    }

    .qty-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        text-decoration: none;
        color: var(--text);
        background: white;
        font-weight: 800;
        transition: all 0.2s ease;
    }

    .qty-btn:hover {
        color: var(--primary);
        background: #fff5f2;
    }

    .qty-value {
        min-width: 34px;
        text-align: center;
        font-weight: 800;
        color: var(--text);
    }

    .price-column {
        font-weight: 800;
        color: var(--primary);
        white-space: nowrap;
    }

    .remove-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        text-decoration: none;
        background: rgba(215, 58, 73, 0.12);
        color: var(--danger);
        font-size: 18px;
        transition: all 0.2s ease;
    }

    .remove-btn:hover {
        background: var(--danger);
        color: white;
    }

    .cart-summary {
        padding: 24px;
        position: sticky;
        top: 96px;
    }

    .summary-title {
        font-size: 22px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 6px;
    }

    .summary-subtitle {
        color: var(--text-light);
        font-size: 14px;
        margin-bottom: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        color: var(--text-light);
        font-size: 14px;
    }

    .summary-row strong,
    .summary-row span:last-child {
        color: var(--text);
        font-weight: 700;
    }

    .summary-row.total-row {
        margin-top: 8px;
        padding-top: 18px;
        border-top: 1px solid rgba(15, 23, 42, 0.08);
        border-bottom: none;
    }

    .summary-row.total-row strong,
    .summary-row.total-row .total-price {
        color: var(--primary);
        font-size: 24px;
        font-weight: 800;
    }

    .cart-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 20px;
    }

    .btn-action {
        min-height: 48px;
        border-radius: 16px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.25s ease;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
    }

    .btn-continue {
        background: #edf1f5;
        color: var(--text);
    }

    .btn-clear {
        background: #fff4e5;
        color: #9a6700;
    }

    .btn-checkout {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        width: 100%;
        margin-top: 12px;
        min-height: 54px;
        box-shadow: 0 16px 28px rgba(238, 77, 45, 0.18);
    }

    .btn-action:hover,
    .btn-checkout:hover {
        transform: translateY(-1px);
    }

    .cart-empty {
        text-align: center;
        padding: 72px 24px;
        border-radius: 24px;
        background: white;
        border: 1px solid var(--border);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }

    .cart-empty-icon {
        width: 92px;
        height: 92px;
        border-radius: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #fff4f1;
        font-size: 42px;
        margin-bottom: 22px;
    }

    .empty-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        text-decoration: none;
        font-weight: 800;
        margin-top: 8px;
    }

    @@media (max-width: 991px) {
        .cart-summary {
            position: static;
            margin-top: 20px;
        }
    }

    @@media (max-width: 768px) {
        .cart-page {
            padding-top: 24px;
        }

        .cart-title {
            font-size: 28px;
        }

        .cart-actions {
            grid-template-columns: 1fr;
        }

        .cart-table th,
        .cart-table td {
            padding: 14px 12px;
            font-size: 13px;
        }
    }
</style>

<div class="container cart-page">
    <div class="cart-hero">
        <div class="cart-kicker"><i class="bi bi-bag-check"></i> Shopping cart</div>
        <div class="cart-title">Giỏ hàng của bạn</div>
        <p class="cart-subtitle">Rà soát lại sản phẩm, số lượng và tổng tiền trước khi chuyển sang bước thanh toán.</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="cart-empty">
            <div class="cart-empty-icon">🛒</div>
            <h3>Giỏ hàng của bạn trống</h3>
            <p class="text-muted mb-4">Hãy thêm sản phẩm để tiếp tục mua sắm</p>
            <a asp-controller="Home" asp-action="Index" class="empty-btn">
                <span>🏪</span>
                <span>Quay lại cửa hàng</span>
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="cart-card">
                    <table class="table cart-table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 45%;">Sản phẩm</th>
                                <th style="width: 15%;">Đơn giá</th>
                                <th style="width: 20%;">Số lượng</th>
                                <th style="width: 15%;">Thành tiền</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="product-cell">
                                        <div class="product-name">@item.Name</div>
                                        <div class="product-meta">Mã sản phẩm: #@item.ProductId</div>
                                    </td>
                                    <td class="price-column">
                                        @(item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫
                                    </td>
                                    <td>
                                        <div class="qty-control">
                                            <a asp-action="Decrease" asp-route-productId="@item.ProductId" class="qty-btn">−</a>
                                            <span class="qty-value">@item.Quantity</span>
                                            <a asp-action="Increase" asp-route-productId="@item.ProductId" class="qty-btn">+</a>
                                        </div>
                                    </td>
                                    <td class="price-column">
                                        @((item.Price * item.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫
                                    </td>
                                    <td>
                                        <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId" class="remove-btn text-decoration-none">
                                            ✕
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary">
                    <div class="summary-title">Tóm tắt đơn hàng</div>
                    <div class="summary-subtitle">@Model.Items.Count sản phẩm đang chờ thanh toán</div>

                    <div class="summary-row">
                        <span>Tổng tiền hàng:</span>
                        <span>@(Model.Items.Sum(x => x.Price * x.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫</span>
                    </div>

                    <div class="summary-row">
                        <span>Phí vận chuyển:</span>
                        <span>Miễn phí</span>
                    </div>

                    <div class="summary-row">
                        <span>Giảm giá:</span>
                        <span>0 ₫</span>
                    </div>

                    <div class="summary-row total-row">
                        <strong>Tổng cộng:</strong>
                        <span class="total-price">@(Model.Items.Sum(x => x.Price * x.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫</span>
                    </div>

                    <div class="cart-actions">
                        <a asp-controller="Home" asp-action="Index" class="btn-action btn-continue">Tiếp tục mua</a>
                        <a asp-action="ClearCart" class="btn-action btn-clear" onclick="return confirm('Bạn có chắc chắn muốn xóa hết giỏ hàng?');">Xóa hết</a>
                    </div>

                    <form asp-action="Checkout" method="get">
                        <button type="submit" class="btn-checkout">
                            ✓ Thanh Toán (@Model.Items.Count sản phẩm)
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>