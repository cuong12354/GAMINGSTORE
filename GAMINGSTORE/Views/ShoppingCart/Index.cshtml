@model ShoppingCart

@{
    ViewData["Title"] = "Giỏ Hàng";
}

<style>
    .cart-container {
        background: white;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        padding: 20px;
    }

    .cart-empty {
        text-align: center;
        padding: 60px 20px;
    }

    .cart-empty-icon {
        font-size: 80px;
        margin-bottom: 20px;
    }

    .cart-table {
        border: none;
    }

    .cart-table thead {
        background-color: #f8f9fa;
        border-bottom: 2px solid #ddd;
    }

    .cart-table th {
        color: #333;
        font-weight: 600;
        padding: 15px;
    }

    .cart-table td {
        padding: 15px;
        vertical-align: middle;
    }

    .product-cell {
        text-align: left;
        max-width: 350px;
    }

    .qty-control {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
    }

    .qty-control button {
        background: white;
        border: none;
        padding: 8px 10px;
        cursor: pointer;
        font-weight: bold;
        color: #333;
    }

    .qty-control button:hover {
        background-color: #f0f0f0;
    }

    .qty-control span {
        padding: 8px 15px;
        min-width: 40px;
        text-align: center;
        font-weight: bold;
    }

    .price-column {
        font-weight: 600;
        color: #ee4d2d;
    }

    .remove-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        transition: 0.3s;
    }

    .remove-btn:hover {
        background-color: #c82333;
        text-decoration: none;
        color: white;
    }

    .cart-summary {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        margin-top: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #ddd;
    }

    .summary-row:last-child {
        border-bottom: none;
        padding-top: 15px;
        font-size: 18px;
        font-weight: bold;
    }

    .total-price {
        color: #ee4d2d;
        font-size: 24px;
    }

    .cart-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .btn-action {
        flex: 1;
        min-width: 150px;
        padding: 12px 20px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        font-size: 16px;
    }

    .btn-continue {
        background-color: #f0f0f0;
        color: #333;
    }

    .btn-continue:hover {
        background-color: #e0e0e0;
    }

    .btn-clear {
        background-color: #ffc107;
        color: #333;
    }

    .btn-clear:hover {
        background-color: #e0a800;
    }

    .btn-checkout {
        background-color: #ee4d2d;
        color: white;
        flex: 2;
    }

    .btn-checkout:hover {
        background-color: #d63d1f;
    }
</style>

<div class="container my-5">
    <h2 class="mb-4" style="color: #333; font-weight: bold;">
        <i class="bi bi-cart-fill"></i> Giỏ Hàng (@Model.Items.Count sản phẩm)
    </h2>

    @if (Model.Items.Count == 0)
    {
        <div class="cart-empty">
            <div class="cart-empty-icon">🛒</div>
            <h3>Giỏ hàng của bạn trống</h3>
            <p class="text-muted mb-4">Hãy thêm sản phẩm để tiếp tục mua sắm</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-lg">
                🏪 Quay lại Cửa hàng
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="cart-container">
                    <table class="table cart-table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 45%;">Sản phẩm</th>
                                <th style="width: 15%;">Đơn giá</th>
                                <th style="width: 20%;">Số lượng</th>
                                <th style="width: 15%;">Thành tiền</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="product-cell">
                                        <strong>@item.Name</strong>
                                    </td>
                                    <td class="price-column">
                                        @(item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫
                                    </td>
                                    <td>
                                        <div class="qty-control">
                                            <a asp-action="Decrease" asp-route-productId="@item.ProductId" class="btn btn-sm" style="padding: 0 8px; text-decoration: none;">−</a>
                                            <span>@item.Quantity</span>
                                            <a asp-action="Increase" asp-route-productId="@item.ProductId" class="btn btn-sm" style="padding: 0 8px; text-decoration: none;">+</a>
                                        </div>
                                    </td>
                                    <td class="price-column">
                                        @((item.Price * item.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫
                                    </td>
                                    <td>
                                        <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId" class="remove-btn text-decoration-none">
                                            ✕
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary">
                    <h5 class="fw-bold mb-3">📋 Đơn hàng</h5>

                    <div class="summary-row">
                        <span>Tổng tiền hàng:</span>
                        <span>@(Model.Items.Sum(x => x.Price * x.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫</span>
                    </div>

                    <div class="summary-row">
                        <span>Phí vận chuyển:</span>
                        <span>Miễn phí</span>
                    </div>

                    <div class="summary-row">
                        <span>Giảm giá:</span>
                        <span>0 ₫</span>
                    </div>

                    <div class="summary-row">
                        <span>Tổng cộng:</span>
                        <span class="total-price">@(Model.Items.Sum(x => x.Price * x.Quantity).ToString("N0", new System.Globalization.CultureInfo("vi-VN"))) ₫</span>
                    </div>

                    <div class="cart-actions">
                        <a asp-controller="Home" asp-action="Index" class="btn-action btn-continue">Tiếp tục mua</a>
                        <a asp-action="ClearCart" class="btn-action btn-clear" onclick="return confirm('Bạn có chắc chắn muốn xóa hết giỏ hàng?');">Xóa hết</a>
                    </div>

                    <form asp-action="Checkout" method="get">
                        <button type="submit" class="btn-action btn-checkout w-100" style="margin-top: 10px;">
                            ✓ Thanh Toán (@Model.Items.Count sản phẩm)
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>