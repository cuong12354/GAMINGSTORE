@model ShoppingCart

@if (Model == null || !Model.Items.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
        <p class="mt-3 text-muted">Giỏ hàng của bạn đang trống</p>
        <a href="/Product/Index" class="btn btn-outline-danger mt-2 rounded-pill">Tiếp tục mua sắm</a>
    </div>
}
else
{
    <div class="cart-items">
        @foreach (var item in Model.Items)
        {
            <div class="cart-item d-flex align-items-center mb-3 pb-3 border-bottom">
                <div class="cart-item-img me-3">
                    <div class="bg-light d-flex align-items-center justify-content-center rounded" style="width: 60px; height: 60px;">
                        <i class="bi bi-box fs-3 text-muted"></i>
                    </div>
                </div>
                <div class="cart-item-info flex-grow-1">
                    <h6 class="mb-1 text-truncate" style="max-width: 200px; font-weight: 700;">@item.Name</h6>
                    <div class="text-danger fw-bold">@item.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</div>
                    <div class="d-flex align-items-center mt-2">
                        <div class="input-group input-group-sm" style="width: 90px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="updateCartItem(@item.ProductId, 'decrease')">-</button>
                            <input type="text" class="form-control text-center" value="@item.Quantity" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="updateCartItem(@item.ProductId, 'increase')">+</button>
                        </div>
                        <button class="btn btn-link text-danger ms-auto p-0" onclick="removeCartItem(@item.ProductId)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="cart-summary mt-4">
        <div class="d-flex justify-content-between mb-3">
            <span class="fw-bold">Tổng cộng:</span>
            <span class="fw-bold text-danger fs-5">@Model.GetTotalPrice().ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</span>
        </div>
        <a href="/ShoppingCart/Index" class="btn btn-light w-100 mb-2 rounded-pill fw-bold">Xem chi tiết giỏ hàng</a>
        <a href="/ShoppingCart/Checkout" class="btn btn-danger w-100 rounded-pill fw-bold" style="background: linear-gradient(135deg, #d92e2e, #b82222);">Thanh toán ngay</a>
    </div>
}
