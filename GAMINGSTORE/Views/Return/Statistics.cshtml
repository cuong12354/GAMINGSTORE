@model Dictionary<string, int>

@{
    ViewData["Title"] = "Thống Kê Trả Hàng";
}

<style>
    .stats-container {
        padding: 20px;
    }

    .stats-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        border-radius: 10px;
        margin-bottom: 30px;
    }

    .stats-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: bold;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 8px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    }

    .stat-icon {
        font-size: 40px;
        margin-bottom: 15px;
    }

    .stat-number {
        font-size: 36px;
        font-weight: bold;
        color: #667eea;
        margin: 10px 0;
    }

    .stat-label {
        font-size: 14px;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .chart-section {
        background: white;
        border-radius: 8px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .chart-title {
        font-size: 20px;
        font-weight: bold;
        color: #333;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 2px solid #667eea;
    }

    .chart-bar {
        margin-bottom: 25px;
    }

    .chart-bar-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .bar-name {
        font-weight: bold;
        color: #333;
    }

    .bar-count {
        color: #667eea;
        font-weight: bold;
    }

    .bar-container {
        background: #f0f0f0;
        border-radius: 4px;
        height: 30px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 10px;
        color: white;
        font-weight: bold;
        font-size: 12px;
        transition: width 0.3s ease;
    }

    .info-section {
        background: #f5f5f5;
        border-left: 4px solid #667eea;
        padding: 20px;
        margin-top: 30px;
        border-radius: 4px;
    }

    .info-title {
        font-weight: bold;
        color: #333;
        margin-bottom: 10px;
    }

    .info-content {
        color: #666;
        font-size: 14px;
        line-height: 1.6;
    }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 20px;
        background: #667eea;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .back-link:hover {
        background: #764ba2;
        text-decoration: none;
    }
</style>

<div class="stats-container">
    <div class="stats-header">
        <h1>📊 Thống Kê Yêu Cầu Trả Hàng</h1>
        <p style="margin: 10px 0 0 0; opacity: 0.9;">Tổng quan về các yêu cầu trả hàng của hệ thống</p>
    </div>

    <div class="stats-grid">
        <!-- Total Returns -->
        <div class="stat-card">
            <div class="stat-icon">📋</div>
            <div class="stat-label">Tổng Số YC</div>
            <div class="stat-number">@(Model.ContainsKey("Total") ? Model["Total"] : 0)</div>
        </div>

        <!-- Pending -->
        <div class="stat-card">
            <div class="stat-icon">⏳</div>
            <div class="stat-label">Đang Chờ</div>
            <div class="stat-number" style="color: #ffc107;">@(Model.ContainsKey("Pending") ? Model["Pending"] : 0)</div>
        </div>

        <!-- Approved -->
        <div class="stat-card">
            <div class="stat-icon">✅</div>
            <div class="stat-label">Phê Duyệt</div>
            <div class="stat-number" style="color: #4caf50;">@(Model.ContainsKey("Approved") ? Model["Approved"] : 0)</div>
        </div>

        <!-- Rejected -->
        <div class="stat-card">
            <div class="stat-icon">❌</div>
            <div class="stat-label">Từ Chối</div>
            <div class="stat-number" style="color: #f44336;">@(Model.ContainsKey("Rejected") ? Model["Rejected"] : 0)</div>
        </div>

        <!-- Completed -->
        <div class="stat-card">
            <div class="stat-icon">✔️</div>
            <div class="stat-label">Hoàn Tất</div>
            <div class="stat-number" style="color: #2196f3;">@(Model.ContainsKey("Completed") ? Model["Completed"] : 0)</div>
        </div>
    </div>

    <div class="chart-section">
        <div class="chart-title">📈 Biểu Đồ Trạng Thái</div>

        @{
            var total = Model.ContainsKey("Total") ? Math.Max(Model["Total"], 1) : 1;
            var pending = Model.ContainsKey("Pending") ? Model["Pending"] : 0;
            var approved = Model.ContainsKey("Approved") ? Model["Approved"] : 0;
            var rejected = Model.ContainsKey("Rejected") ? Model["Rejected"] : 0;
            var completed = Model.ContainsKey("Completed") ? Model["Completed"] : 0;

            var pendingPercent = (pending * 100) / total;
            var approvedPercent = (approved * 100) / total;
            var rejectedPercent = (rejected * 100) / total;
            var completedPercent = (completed * 100) / total;
        }

        <div class="chart-bar">
            <div class="chart-bar-label">
                <span class="bar-name">⏳ Đang Chờ Xem Xét</span>
                <span class="bar-count">@pending/@total</span>
            </div>
            <div class="bar-container">
                <div class="bar-fill" style="width: @(Math.Max(5, pendingPercent))%; background: linear-gradient(90deg, #ffc107 0%, #ff9800 100%);">
                    @pendingPercent%
                </div>
            </div>
        </div>

        <div class="chart-bar">
            <div class="chart-bar-label">
                <span class="bar-name">✅ Phê Duyệt</span>
                <span class="bar-count">@approved/@total</span>
            </div>
            <div class="bar-container">
                <div class="bar-fill" style="width: @(Math.Max(5, approvedPercent))%; background: linear-gradient(90deg, #4caf50 0%, #45a049 100%);">
                    @approvedPercent%
                </div>
            </div>
        </div>

        <div class="chart-bar">
            <div class="chart-bar-label">
                <span class="bar-name">❌ Từ Chối</span>
                <span class="bar-count">@rejected/@total</span>
            </div>
            <div class="bar-container">
                <div class="bar-fill" style="width: @(Math.Max(5, rejectedPercent))%; background: linear-gradient(90deg, #f44336 0%, #da190b 100%);">
                    @rejectedPercent%
                </div>
            </div>
        </div>

        <div class="chart-bar">
            <div class="chart-bar-label">
                <span class="bar-name">✔️ Hoàn Tất</span>
                <span class="bar-count">@completed/@total</span>
            </div>
            <div class="bar-container">
                <div class="bar-fill" style="width: @(Math.Max(5, completedPercent))%; background: linear-gradient(90deg, #2196f3 0%, #1565c0 100%);">
                    @completedPercent%
                </div>
            </div>
        </div>
    </div>

    <div class="info-section">
        <div class="info-title">💡 Hướng Dẫn</div>
        <div class="info-content">
            <ul style="margin: 0; padding-left: 20px;">
                <li>Kiểm tra những yêu cầu đang chờ xem xét thường xuyên</li>
                <li>Phê duyệt hoặc từ chối dựa trên chính sách trả hàng</li>
                <li>Cập nhật trạng thái giúp khách hàng theo dõi yêu cầu</li>
                <li>Thời gian xử lý tiêu chuẩn: 3-5 ngày làm việc</li>
            </ul>
        </div>
    </div>

    <a href="@Url.Action("Pending")" class="back-link">← Quay Lại Danh Sách Yêu Cầu</a>
</div>
