@model List<ReturnRequest>

@{
    ViewData["Title"] = "Quản Lý Yêu Cầu Trả Hàng";
}

<style>
    .admin-return-container {
        padding: 20px;
    }

    .admin-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        border-radius: 10px;
        margin-bottom: 30px;
    }

    .admin-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: bold;
    }

    .table-container {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

    .admin-table thead {
        background: #f5f5f5;
        border-bottom: 2px solid #e0e0e0;
    }

    .admin-table th {
        padding: 15px;
        text-align: left;
        font-weight: bold;
        color: #333;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .admin-table td {
        padding: 15px;
        border-bottom: 1px solid #e0e0e0;
        color: #555;
    }

    .admin-table tbody tr:hover {
        background: #f9f9f9;
    }

    .return-id {
        font-weight: bold;
        color: #667eea;
    }

    .user-info {
        font-size: 13px;
    }

    .user-name {
        font-weight: bold;
        color: #333;
    }

    .user-email {
        color: #999;
        font-size: 12px;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .status-completed {
        background: #d1ecf1;
        color: #0c5460;
    }

    .amount-value {
        font-weight: bold;
        color: #d92e2e;
        font-size: 16px;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-sm {
        padding: 6px 12px;
        border: none;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-view {
        background: #667eea;
        color: white;
    }

    .btn-view:hover {
        background: #764ba2;
        text-decoration: none;
    }

    .btn-approve {
        background: #4caf50;
        color: white;
    }

    .btn-approve:hover {
        background: #45a049;
    }

    .btn-reject {
        background: #f44336;
        color: white;
    }

    .btn-reject:hover {
        background: #da190b;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }

    .filter-section {
        margin-bottom: 20px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 8px 16px;
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .filter-btn.active {
        background: #667eea;
        color: white;
        border-color: #667eea;
    }

    .filter-btn:hover {
        border-color: #667eea;
    }
</style>

<div class="admin-return-container">
    <div class="admin-header">
        <h1>📋 Quản Lý Yêu Cầu Trả Hàng</h1>
        <p style="margin: 10px 0 0 0; opacity: 0.9;">Xem xét và xử lý các yêu cầu trả hàng từ khách hàng</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="table-container">
            <div class="empty-state">
                <div class="empty-state-icon">✨</div>
                <p>Không có yêu cầu trả hàng nào đang chờ xem xét</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã YC</th>
                        <th>Khách Hàng</th>
                        <th>Đơn Hàng</th>
                        <th>Lý Do</th>
                        <th>Số Tiền</th>
                        <th>Ngày Gửi</th>
                        <th>Trạng Thái</th>
                        <th style="text-align: center;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var returnReq in Model)
                    {
                        <tr>
                            <td><span class="return-id">#@returnReq.Id</span></td>
                            <td>
                                <div class="user-info">
                                    <div class="user-name">@returnReq.User?.FullName</div>
                                    <div class="user-email">@returnReq.User?.Email</div>
                                </div>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", "OrderHistory", new { id = returnReq.OrderId })" style="color: #667eea; font-weight: bold;">
                                    #@returnReq.OrderId
                                </a>
                            </td>
                            <td style="font-size: 13px; max-width: 200px; word-wrap: break-word;">
                                @(returnReq.Reason?.Substring(0, Math.Min(50, returnReq.Reason.Length)) ?? "N/A")...
                            </td>
                            <td><span class="amount-value">₫@returnReq.ReturnAmount.ToString("N0")</span></td>
                            <td style="font-size: 12px; color: #999;">@returnReq.RequestDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="status-badge status-pending">@returnReq.Status</span>
                            </td>
                            <td style="text-align: center;">
                                <div class="action-buttons" style="justify-content: center;">
                                    <a href="@Url.Action("Details", new { id = returnReq.Id })" class="btn-sm btn-view">
                                        Xem
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
