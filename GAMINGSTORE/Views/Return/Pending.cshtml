@model List<ReturnRequest>

@{
    ViewData["Title"] = "Quản Lý Yêu Cầu Trả Hàng";
    var totalRequests = Model?.Count ?? 0;
    var totalAmount = Model?.Sum(x => x.ReturnAmount) ?? 0;
    var todayRequests = Model?.Count(x => x.RequestDate.Date == DateTime.Today) ?? 0;
}

<style>
    :root {
        --admin-primary: #d92e2e;
        --admin-primary-dark: #b82222;
        --admin-bg: #f5f7fb;
        --admin-card: #ffffff;
        --admin-text: #111827;
        --admin-muted: #6b7280;
        --admin-border: rgba(15, 23, 42, 0.08);
        --admin-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        --admin-warning: #f59e0b;
        --admin-success: #10b981;
        --admin-danger: #ef4444;
        --admin-info: #3b82f6;
    }

    body {
        background: var(--admin-bg);
    }

    .return-admin-page {
        padding: 28px;
        color: var(--admin-text);
    }

    .return-hero {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        padding: 28px;
        margin-bottom: 22px;
        background:
            radial-gradient(circle at top right, rgba(255,255,255,0.34), transparent 32%),
            linear-gradient(135deg, #d92e2e 0%, #8f1d1d 100%);
        color: #fff;
        box-shadow: 0 22px 45px rgba(217, 46, 46, 0.24);
    }

    .return-hero::after {
        content: "";
        position: absolute;
        right: -80px;
        bottom: -100px;
        width: 250px;
        height: 250px;
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
    }

    .hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
    }

    .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 34px;
        padding: 0 13px;
        border-radius: 999px;
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.22);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        margin-bottom: 12px;
    }

    .hero-title {
        font-size: 32px;
        font-weight: 950;
        line-height: 1.15;
        margin: 0 0 8px;
    }

    .hero-subtitle {
        margin: 0;
        max-width: 680px;
        color: rgba(255,255,255,0.84);
        line-height: 1.7;
        font-size: 14px;
    }

    .hero-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .hero-btn {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #fff;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.25);
        text-decoration: none;
        font-weight: 850;
        transition: 0.22s ease;
    }

    .hero-btn:hover {
        color: #fff;
        background: rgba(255,255,255,0.22);
        transform: translateY(-2px);
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .metric-card {
        background: var(--admin-card);
        border: 1px solid var(--admin-border);
        border-radius: 22px;
        padding: 18px;
        box-shadow: var(--admin-shadow);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .metric-icon {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .metric-icon.warning { background: #fff7ed; color: var(--admin-warning); }
    .metric-icon.success { background: #ecfdf5; color: var(--admin-success); }
    .metric-icon.info { background: #eff6ff; color: var(--admin-info); }

    .metric-label {
        color: var(--admin-muted);
        font-size: 12px;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 4px;
    }

    .metric-value {
        font-size: 24px;
        line-height: 1;
        font-weight: 950;
        color: var(--admin-text);
    }

    .toolbar-card {
        background: var(--admin-card);
        border: 1px solid var(--admin-border);
        border-radius: 22px;
        padding: 16px;
        box-shadow: var(--admin-shadow);
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .search-box {
        flex: 1;
        min-width: 260px;
        position: relative;
    }

    .search-box input {
        width: 100%;
        min-height: 44px;
        padding: 0 14px 0 42px;
        border-radius: 14px;
        border: 1px solid var(--admin-border);
        background: #f9fafb;
        color: var(--admin-text);
        font-size: 14px;
        outline: none;
        transition: 0.2s ease;
    }

    .search-box input:focus {
        border-color: rgba(217, 46, 46, 0.35);
        box-shadow: 0 0 0 4px rgba(217, 46, 46, 0.08);
        background: #fff;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--admin-muted);
    }

    .toolbar-pills {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .toolbar-pill {
        min-height: 40px;
        padding: 0 13px;
        border-radius: 999px;
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 850;
    }

    .table-card {
        background: var(--admin-card);
        border: 1px solid var(--admin-border);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--admin-shadow);
    }

    .table-headline {
        padding: 18px 20px;
        border-bottom: 1px solid var(--admin-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .table-title {
        font-size: 18px;
        font-weight: 950;
        margin: 0;
    }

    .table-subtitle {
        color: var(--admin-muted);
        font-size: 13px;
        margin-top: 4px;
    }

    .return-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .return-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 980px;
    }

    .return-table thead {
        background: #f9fafb;
    }

    .return-table th {
        padding: 14px 18px;
        color: #6b7280;
        font-size: 11px;
        font-weight: 950;
        letter-spacing: 0.7px;
        text-transform: uppercase;
        text-align: left;
        border-bottom: 1px solid var(--admin-border);
        white-space: nowrap;
    }

    .return-table td {
        padding: 16px 18px;
        border-bottom: 1px solid rgba(15, 23, 42, 0.06);
        vertical-align: middle;
        color: #374151;
        font-size: 14px;
    }

    .return-table tbody tr {
        transition: 0.18s ease;
    }

    .return-table tbody tr:hover {
        background: #fff8f8;
    }

    .return-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .return-id {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 0 10px;
        border-radius: 999px;
        background: #fff1f2;
        color: var(--admin-primary);
        font-weight: 950;
        border: 1px solid rgba(217, 46, 46, 0.12);
    }

    .customer-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 220px;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        background: linear-gradient(135deg, #d92e2e, #ff8a65);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 950;
        flex-shrink: 0;
        box-shadow: 0 8px 16px rgba(217, 46, 46, 0.18);
    }

    .user-name {
        font-weight: 900;
        color: #111827;
        line-height: 1.35;
    }

    .user-email {
        color: var(--admin-muted);
        font-size: 12px;
        max-width: 190px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .order-link {
        color: var(--admin-info);
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 999px;
        padding: 7px 10px;
        text-decoration: none;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .order-link:hover {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .reason-text {
        max-width: 260px;
        color: #4b5563;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .amount-value {
        color: var(--admin-primary);
        font-size: 15px;
        font-weight: 950;
        white-space: nowrap;
    }

    .date-cell {
        color: var(--admin-muted);
        white-space: nowrap;
        font-size: 13px;
    }

    .status-badge {
        min-height: 30px;
        padding: 0 11px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 950;
        white-space: nowrap;
    }

    .status-pending { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
    .status-approved { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .status-rejected { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
    .status-completed { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 8px;
        white-space: nowrap;
    }

    .btn-view {
        min-height: 36px;
        padding: 0 13px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        background: linear-gradient(135deg, #d92e2e, #b82222);
        color: #fff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 950;
        box-shadow: 0 10px 18px rgba(217, 46, 46, 0.18);
        transition: 0.2s ease;
    }

    .btn-view:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 16px 24px rgba(217, 46, 46, 0.24);
    }

    .empty-state {
        padding: 68px 20px;
        text-align: center;
    }

    .empty-illustration {
        width: 90px;
        height: 90px;
        border-radius: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        background: #ecfdf5;
        color: var(--admin-success);
        margin-bottom: 18px;
    }

    .empty-title {
        font-size: 20px;
        font-weight: 950;
        color: #111827;
        margin-bottom: 8px;
    }

    .empty-desc {
        color: var(--admin-muted);
        margin: 0 auto 18px;
        max-width: 480px;
        line-height: 1.7;
    }

    .empty-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 14px;
        color: #fff;
        background: linear-gradient(135deg, #d92e2e, #b82222);
        text-decoration: none;
        font-weight: 900;
    }

    .empty-link:hover {
        color: #fff;
    }

    @@media (max-width: 991px) {
        .return-admin-page { padding: 18px; }
        .metric-grid { grid-template-columns: 1fr; }
        .hero-title { font-size: 25px; }
        .return-hero { padding: 22px; border-radius: 20px; }
    }

    @@media (max-width: 576px) {
        .return-admin-page { padding: 12px; }
        .toolbar-card { border-radius: 18px; }
        .search-box { min-width: 100%; }
        .hero-actions { width: 100%; }
        .hero-btn { width: 100%; }
    }
</style>

<div class="return-admin-page">
    <div class="return-hero">
        <div class="hero-content">
            <div>
                <div class="hero-kicker">↩️ Return Center</div>
                <h1 class="hero-title">Quản Lý Yêu Cầu Trả Hàng</h1>
                <p class="hero-subtitle">Theo dõi, kiểm tra và xử lý các yêu cầu trả hàng đang chờ duyệt từ khách hàng.</p>
            </div>
            <div class="hero-actions">
                <a href="@Url.Action("Statistics", "Return")" class="hero-btn">📊 Thống kê</a>
                <a href="@Url.Action("Index", "Return")" class="hero-btn">📁 Tất cả yêu cầu</a>
            </div>
        </div>
    </div>

    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-icon warning">⏳</div>
            <div>
                <div class="metric-label">Đang chờ duyệt</div>
                <div class="metric-value">@totalRequests</div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon success">💸</div>
            <div>
                <div class="metric-label">Tổng tiền hoàn dự kiến</div>
                <div class="metric-value">@totalAmount.ToString("N0") ₫</div>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-icon info">📅</div>
            <div>
                <div class="metric-label">Yêu cầu hôm nay</div>
                <div class="metric-value">@todayRequests</div>
            </div>
        </div>
    </div>

    <div class="toolbar-card">
        <div class="search-box">
            <span class="search-icon">🔎</span>
            <input type="text" id="returnSearch" placeholder="Tìm theo mã yêu cầu, khách hàng, email, đơn hàng, lý do..." onkeyup="filterReturns()" />
        </div>
        <div class="toolbar-pills">
            <span class="toolbar-pill">⚡ Cần xử lý nhanh</span>
            <span class="toolbar-pill">📌 Chỉ hiển thị Pending</span>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="table-card">
            <div class="empty-state">
                <div class="empty-illustration">✨</div>
                <div class="empty-title">Không có yêu cầu trả hàng đang chờ</div>
                <p class="empty-desc">Hiện tại không có yêu cầu nào cần xử lý. Bạn có thể xem toàn bộ lịch sử yêu cầu trả hàng hoặc quay lại dashboard.</p>
                <a href="@Url.Action("Index", "Return")" class="empty-link">Xem tất cả yêu cầu</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-headline">
                <div>
                    <h2 class="table-title">Danh sách yêu cầu đang chờ</h2>
                    <div class="table-subtitle">Có @totalRequests yêu cầu cần admin xem xét.</div>
                </div>
                <div class="toolbar-pill">Tổng: @totalAmount.ToString("N0") ₫</div>
            </div>

            <div class="return-table-wrap">
                <table class="return-table" id="returnTable">
                    <thead>
                        <tr>
                            <th>Mã YC</th>
                            <th>Khách hàng</th>
                            <th>Đơn hàng</th>
                            <th>Lý do</th>
                            <th>Số tiền</th>
                            <th>Ngày gửi</th>
                            <th>Trạng thái</th>
                            <th style="text-align: center;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var returnReq in Model)
                        {
                            var customerName = returnReq.User?.FullName ?? "Khách hàng";
                            var firstChar = !string.IsNullOrWhiteSpace(customerName) ? customerName.Trim()[0].ToString().ToUpper() : "K";
                            var reason = string.IsNullOrWhiteSpace(returnReq.Reason) ? "N/A" : returnReq.Reason;
                            var shortReason = reason.Length > 90 ? reason.Substring(0, 90) + "..." : reason;
                            var statusClass = (returnReq.Status ?? "Pending").ToLower() switch
                            {
                                "approved" => "status-approved",
                                "rejected" => "status-rejected",
                                "completed" => "status-completed",
                                _ => "status-pending"
                            };

                            <tr class="return-row">
                                <td data-search="#@returnReq.Id">
                                    <span class="return-id">#@returnReq.Id</span>
                                </td>
                                <td data-search="@customerName @returnReq.User?.Email">
                                    <div class="customer-cell">
                                        <div class="avatar">@firstChar</div>
                                        <div>
                                            <div class="user-name">@customerName</div>
                                            <div class="user-email">@(returnReq.User?.Email ?? "Chưa có email")</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-search="#@returnReq.OrderId">
                                    <a href="@Url.Action("Details", "OrderHistory", new { id = returnReq.OrderId })" class="order-link">
                                        🧾 #@returnReq.OrderId
                                    </a>
                                </td>
                                <td data-search="@reason">
                                    <div class="reason-text" title="@reason">@shortReason</div>
                                </td>
                                <td data-search="@returnReq.ReturnAmount">
                                    <span class="amount-value">@returnReq.ReturnAmount.ToString("N0") ₫</span>
                                </td>
                                <td data-search="@returnReq.RequestDate.ToString("dd/MM/yyyy")">
                                    <div class="date-cell">@returnReq.RequestDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td data-search="@returnReq.Status">
                                    <span class="status-badge @statusClass">⏳ @(returnReq.Status ?? "Pending")</span>
                                </td>
                                <td style="text-align: center;">
                                    <div class="action-buttons">
                                        <a href="@Url.Action("Details", new { id = returnReq.Id })" class="btn-view">
                                            👁️ Xem xử lý
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script>
    function filterReturns() {
        const input = document.getElementById('returnSearch');
        const filter = (input.value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#returnTable tbody tr.return-row');

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(filter) ? '' : 'none';
        });
    }
</script>
