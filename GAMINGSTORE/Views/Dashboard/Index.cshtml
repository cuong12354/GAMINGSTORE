@{
    ViewData["Title"] = "📊 Admin Dashboard";
    var stats = ViewBag.Stats;
    var recentOrders = ViewBag.RecentOrders;
    var pendingReturns = ViewBag.PendingReturns;
}

<style>
    .dashboard-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 24px;
        border-radius: 16px;
        margin-bottom: 28px;
        color: white;
    }

    .dashboard-header h1 {
        font-size: 32px;
        font-weight: 700;
        margin: 0;
    }

    .dashboard-header p {
        font-size: 14px;
        opacity: 0.9;
        margin: 8px 0 0 0;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        border-left: 4px solid #d92e2e;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.12);
    }

    .stat-icon {
        font-size: 28px;
        margin-bottom: 8px;
    }

    .stat-label {
        font-size: 12px;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #1f2937;
    }

    .stat-change {
        font-size: 12px;
        color: #059669;
        margin-top: 8px;
    }

    /* Quick Actions */
    .quick-actions {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 28px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .quick-actions h3 {
        margin-top: 0;
        color: #1f2937;
        font-weight: 600;
    }

    .action-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
    }

    .action-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 14px 16px;
        border-radius: 10px;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 600;
        transition: all 0.2s;
        font-size: 13px;
    }

    .action-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        color: white;
        text-decoration: none;
    }

    /* Tables */
    .card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .card h3 {
        margin-top: 0;
        color: #1f2937;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        background: #f3f4f6;
        padding: 12px;
        text-align: left;
        font-weight: 600;
        font-size: 13px;
        color: #4b5563;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e5e7eb;
    }

    .data-table td {
        padding: 14px 12px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 13px;
    }

    .data-table tbody tr:hover {
        background: #f9fafb;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-confirmed {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-shipped {
        background: #c7d2fe;
        color: #3730a3;
    }

    .status-delivered {
        background: #d1fae5;
        color: #065f46;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #7f1d1d;
    }

    .empty-state {
        text-align: center;
        padding: 32px 20px;
        color: #9ca3af;
    }

    .empty-state i {
        font-size: 40px;
        opacity: 0.3;
        margin-bottom: 12px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 20px;
    }
</style>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1>📊 Admin Dashboard</h1>
            <p>Quản lý toàn bộ hoạt động của trang web</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📦</div>
            <div class="stat-label">Tổng Đơn Hàng</div>
            <div class="stat-value">@stats.TotalOrders</div>
            <div class="stat-change">
                @if (stats.PendingOrders > 0)
                {
                    <span>⏳ @stats.PendingOrders đang xử lý</span>
                }
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-label">Doanh Thu</div>
            <div class="stat-value">@stats.TotalRevenue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</div>
            <div class="stat-change">
                📈 Tháng: @stats.RevenueThisMonth.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🎁</div>
            <div class="stat-label">Sản Phẩm</div>
            <div class="stat-value">@stats.TotalProducts</div>
            <div class="stat-change">
                ✅ Hoạt động
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-label">Người Dùng</div>
            <div class="stat-value">@stats.TotalUsers</div>
            <div class="stat-change">
                📊 Thành viên
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🔄</div>
            <div class="stat-label">Yêu Cầu Trả Hàng</div>
            <div class="stat-value">@stats.PendingReturns</div>
            <div class="stat-change">
                ⚠️ Đang chờ
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">💵</div>
            <div class="stat-label">Giá Trung Bình</div>
            <div class="stat-value">@stats.AverageOrderValue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</div>
            <div class="stat-change">
                📋 / đơn
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <h3>⚡ Tính Năng Quản Lý</h3>
        <div class="action-buttons">
            <a href="/Product/Index" class="action-btn">
                <span>⚙️</span> Sản Phẩm
            </a>
            <a href="/OrderManagement/Index" class="action-btn">
                <span>📦</span> Đơn Hàng
            </a>
            <a href="/Return/Pending" class="action-btn">
                <span>🔄</span> Trả Hàng
            </a>
            <a href="/Audit/Index" class="action-btn">
                <span>📋</span> Audit Trail
            </a>
            <a href="/Areas/Admin/Controllers" class="action-btn">
                <span>🎟️</span> Coupon
            </a>
            <a href="/Product/Create" class="action-btn">
                <span>➕</span> Thêm Sản Phẩm
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid-2">
        <!-- Recent Orders -->
        <div class="card">
            <h3>📊 Đơn Hàng Gần Đây</h3>
            <div class="table-responsive">
                @if (recentOrders.Count > 0)
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Mã Đơn</th>
                                <th>Khách Hàng</th>
                                <th>Ngày</th>
                                <th>Giá Trị</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in recentOrders)
                            {
                                var statusClass = order.Status switch
                                {
                                    "Pending" => "status-pending",
                                    "Confirmed" => "status-confirmed",
                                    "Shipped" => "status-shipped",
                                    "Delivered" => "status-delivered",
                                    "Cancelled" => "status-cancelled",
                                    _ => "status-pending"
                                };

                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td>@order.TotalPrice.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
                                    <td>
                                        <span class="status-badge @statusClass">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Chưa có đơn hàng</p>
                    </div>
                }
            </div>
            <div style="margin-top: 12px; text-align: center;">
                <a href="/OrderManagement/Index" class="btn btn-sm btn-primary">Xem tất cả →</a>
            </div>
        </div>

        <!-- Pending Returns -->
        <div class="card">
            <h3>🔄 Yêu Cầu Trả Hàng Đang Chờ</h3>
            <div class="table-responsive">
                @if (pendingReturns.Count > 0)
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Khách Hàng</th>
                                <th>Lý Do</th>
                                <th>Ngày</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var returnReq in pendingReturns)
                            {
                                <tr>
                                    <td><strong>#@returnReq.Id</strong></td>
                                    <td>@returnReq.CustomerName</td>
                                    <td>@(string.IsNullOrEmpty(returnReq.Reason) ? "N/A" : returnReq.Reason.Substring(0, Math.Min(20, returnReq.Reason.Length)) + "...")</td>
                                    <td>@returnReq.RequestDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a href="/Return/Details/@returnReq.Id" class="btn btn-xs btn-info" style="padding: 4px 8px; font-size: 11px;">Xem</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-check-circle"></i>
                        <p>Không có yêu cầu chờ xử lý</p>
                    </div>
                }
            </div>
            <div style="margin-top: 12px; text-align: center;">
                <a href="/Return/Pending" class="btn btn-sm btn-primary">Xem tất cả →</a>
            </div>
        </div>
    </div>

    <!-- Quick Stats Info -->
    <div class="card" style="margin-top: 20px;">
        <h3>📈 Thông Tin Nhanh</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
            <div>
                <h5 style="color: #667eea; margin-bottom: 8px;">📊 Hiệu Suất</h5>
                <p style="margin: 4px 0; font-size: 13px; color: #6b7280;">
                    <strong>Tỉ lệ hoàn thành:</strong> @(stats.TotalOrders > 0 ? Math.Round((decimal)(stats.TotalOrders - stats.PendingOrders) / stats.TotalOrders * 100, 1) : 0)%
                </p>
                <p style="margin: 4px 0; font-size: 13px; color: #6b7280;">
                    <strong>Doanh thu trung bình/tháng:</strong> @(stats.RevenueThisMonth.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")))
                </p>
            </div>
            <div>
                <h5 style="color: #667eea; margin-bottom: 8px;">⚠️ Cần Chú Ý</h5>
                <p style="margin: 4px 0; font-size: 13px; color: #dc2626;">
                    <strong>@stats.PendingOrders</strong> đơn hàng đang chờ
                </p>
                <p style="margin: 4px 0; font-size: 13px; color: #dc2626;">
                    <strong>@stats.PendingReturns</strong> yêu cầu trả hàng chờ duyệt
                </p>
            </div>
            <div>
                <h5 style="color: #667eea; margin-bottom: 8px;">🎯 Mục Tiêu</h5>
                <p style="margin: 4px 0; font-size: 13px; color: #6b7280;">
                    <strong>Tổng sản phẩm:</strong> @stats.TotalProducts
                </p>
                <p style="margin: 4px 0; font-size: 13px; color: #6b7280;">
                    <strong>Tổng người dùng:</strong> @stats.TotalUsers
                </p>
            </div>
        </div>
    </div>
</div>
