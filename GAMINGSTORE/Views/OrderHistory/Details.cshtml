@model Order
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id}";
}

<style>
    .order-details-container {
        padding: 40px 0;
    }

    .breadcrumb-nav {
        background: transparent;
        padding: 0 0 20px 0;
        margin-bottom: 30px;
    }

    .breadcrumb-nav a {
        color: #5a7ba8;
        text-decoration: none;
        font-weight: 600;
    }

    .breadcrumb-nav a:hover {
        text-decoration: underline;
    }

    .details-header {
        background: linear-gradient(135deg, #6b8fb8 0%, #5a7ba8 100%);
        color: white;
        border-radius: 8px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 2px 8px rgba(91, 122, 168, 0.1);
    }

    .details-header h1 {
        font-weight: 600;
    }

    .order-status-progress {
        margin-bottom: 30px;
    }

    .status-timeline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        background: white;
        padding: 30px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        box-shadow: 0 1px 3px var(--shadow-color);
    }

    .status-item {
        flex: 1;
        text-align: center;
        position: relative;
    }

    .status-item::before {
        content: '';
        position: absolute;
        top: 20px;
        right: -50%;
        width: 100%;
        height: 2px;
        background-color: var(--border-color);
        z-index: 1;
    }

    .status-item:last-child::before {
        display: none;
    }

    .status-item.active::before {
        background-color: #8fa3c0;
    }

    .status-circle {
        width: 40px;
        height: 40px;
        background-color: var(--gray-100);
        border: 2px solid var(--border-color);
        border-radius: 50%;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        position: relative;
        z-index: 2;
        font-size: 18px;
    }

    .status-item.active .status-circle {
        background-color: #8fa3c0;
        border-color: #8fa3c0;
        color: white;
    }

    .status-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-box {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 1px 3px var(--shadow-color);
    }

    .detail-label {
        color: #5a7ba8;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .detail-value {
        color: var(--text-primary);
        font-size: 16px;
        font-weight: 600;
    }

    .detail-value.highlight {
        color: #5a7ba8;
        font-weight: 700;
        font-size: 20px;
    }

    .items-section {
        background: #f8fafb;
        border: 1px solid #e0e3e8;
        border-radius: 8px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 1px 2px rgba(91, 122, 168, 0.05);
    }

    .items-title {
        color: #5a7ba8;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .order-items-table {
        width: 100%;
        border-collapse: collapse;
    }

    .order-items-table thead th {
        background-color: var(--gray-50);
        color: var(--text-primary);
        padding: 16px;
        text-align: left;
        font-weight: 600;
        border-bottom: 2px solid var(--border-color);
        font-size: 14px;
    }

    .order-items-table tbody td {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-secondary);
    }

    .order-items-table tbody tr:last-child td {
        border-bottom: none;
    }

    .order-items-table tbody tr:hover {
        background-color: var(--gray-50);
    }

    .item-image {
        width: 50px;
        height: 50px;
        border-radius: 6px;
        object-fit: cover;
        border: 1px solid var(--border-color);
    }

    .item-name {
        color: var(--text-primary);
        font-weight: 600;
    }

    .item-price {
        color: #5a7ba8;
        font-weight: 600;
    }

    .totals-section {
        background: #f8fafb;
        border: 1px solid #e0e3e8;
        border-radius: 8px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow: 0 1px 2px rgba(91, 122, 168, 0.05);
    }

    .totals-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
        font-size: 16px;
    }

    .totals-row.total {
        border: none;
        padding-top: 20px;
        font-size: 20px;
        font-weight: 700;
    }

    .totals-row.total .label {
        color: #5a7ba8;
    }

    .totals-row.total .value {
        color: #5a7ba8;
    }

    .totals-row .label {
        color: var(--text-secondary);
    }

    .totals-row .value {
        color: var(--text-primary);
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .btn-back {
        background: white;
        border: 2px solid var(--primary-blue);
        color: var(--primary-blue);
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-back:hover {
        background-color: var(--primary-blue-light);
        color: var(--primary-blue-dark);
    }

    .btn-print {
        background-color: var(--primary-blue);
        border: none;
        color: white;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-print:hover {
        background-color: var(--primary-blue-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 102, 204, 0.2);
    }

    .btn-return {
        background-color: #28a745;
        border: none;
        color: white;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-return:hover {
        background-color: #218838;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.2);
    }

    .btn-return-disabled {
        background-color: #ccc;
        border: none;
        color: #666;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: not-allowed;
        opacity: 0.6;
    }

    .btn-view-return {
        background-color: #17a2b8;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-view-return:hover {
        background-color: #138496;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(23, 162, 184, 0.2);
    }

    @@media print {
        .action-buttons,
        .breadcrumb-nav {
            display: none;
        }
    }
</style>

<div class="order-details-container">
    <div class="container">
        <!-- Breadcrumb -->
        <div class="breadcrumb-nav">
            <a href="/OrderHistory"><i class="bi bi-arrow-left"></i> Quay lại lịch sử</a>
        </div>

        <!-- Header -->
        <div class="details-header">
            <h1 class="glow-red"><i class="bi bi-receipt"></i> Chi tiết đơn hàng #@Model.Id</h1>
            <p class="text-muted mt-2">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
        </div>

        <!-- Status Progress -->
        <div class="order-status-progress">
            <div class="status-timeline">
                @{
                    var statuses = new[] { "Pending", "Confirmed", "Shipped", "Delivered" };
                    var currentStatusIndex = System.Array.IndexOf(statuses, Model.Status);
                    
                    foreach (var (status, index) in statuses.Select((s, i) => (s, i)))
                    {
                        var isActive = index <= currentStatusIndex;
                        var statusDisplay = status switch
                        {
                            "Pending" => "Chờ xử lý",
                            "Confirmed" => "Xác nhận",
                            "Shipped" => "Đang giao",
                            "Delivered" => "Đã giao",
                            _ => status
                        };
                        var statusIcon = status switch
                        {
                            "Pending" => "⏳",
                            "Confirmed" => "✓",
                            "Shipped" => "📦",
                            "Delivered" => "✓",
                            _ => "?"
                        };

                        <div class="status-item @(isActive ? "active" : "")">
                            <div class="status-circle">@statusIcon</div>
                            <div class="status-label">@statusDisplay</div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Order Info Grid -->
        <div class="details-grid">
            <div class="detail-box">
                <div class="detail-label">Tên khách hàng</div>
                <div class="detail-value">@Model.CustomerName</div>
            </div>

            <div class="detail-box">
                <div class="detail-label">Trạng thái</div>
                <div class="detail-value">
                    @{
                        var statusClass = Model.Status switch
                        {
                            "Pending" => "status-pending",
                            "Confirmed" => "status-confirmed",
                            "Shipped" => "status-shipped",
                            "Delivered" => "status-delivered",
                            "Cancelled" => "status-cancelled",
                            _ => ""
                        };
                        var statusText = Model.Status switch
                        {
                            "Pending" => "Chờ xử lý",
                            "Confirmed" => "Đã xác nhận",
                            "Shipped" => "Đang giao",
                            "Delivered" => "Đã giao",
                            "Cancelled" => "Đã hủy",
                            _ => Model.Status
                        };
                    }
                    <span class="badge @statusClass">@statusText</span>
                </div>
            </div>

            <div class="detail-box">
                <div class="detail-label">Phương thức thanh toán</div>
                <div class="detail-value">@(Model.PaymentMethod ?? "Chưa chọn")</div>
            </div>

            <div class="detail-box">
                <div class="detail-label">Tổng tiền</div>
                <div class="detail-value highlight">@(Model.TotalPrice.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")))₫</div>
            </div>
        </div>

        <!-- Shipping Address -->
        <div class="detail-box mb-4">
            <div class="detail-label">Địa chỉ giao hàng</div>
            <div class="detail-value">
                <i class="bi bi-geo-alt"></i> @Model.ShippingAddress
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="detail-value mt-3">
                    <strong>Ghi chú:</strong> @Model.Notes
                </div>
            }
        </div>

        <!-- Order Items -->
        <div class="items-section">
            <div class="items-title">
                <i class="bi bi-box-seam"></i> Chi tiết sản phẩm
            </div>
            <table class="order-items-table">
                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails ?? new List<OrderDetail>())
                    {
                        var imageUrl = item.Product?.ImageUrl?.Split(';').FirstOrDefault() ?? "/images/no-image.png";
                        
                        <tr>
                            <td>
                                <img src="@imageUrl" alt="@(item.ProductName ?? item.Product?.Name)" class="item-image" />
                            </td>
                            <td class="item-name">@(item.ProductName ?? item.Product?.Name ?? "(Unknown Product)")</td>
                            <td>@item.Quantity</td>
                            <td class="item-price">@(item.Price.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")))₫</td>
                            <td class="item-price">@((item.Quantity * item.Price).ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")))₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="totals-section">
            <div class="totals-row">
                <span class="label">Tổng sản phẩm:</span>
                <span class="value">@(Model.OrderDetails?.Sum(x => x.Quantity) ?? 0)</span>
            </div>
            <div class="totals-row">
                <span class="label">Thanh toán:</span>
                <span class="value">@Model.PaymentMethod ?? "Chưa thanh toán"</span>
            </div>
            <div class="totals-row total">
                <span class="label">Tổng cộng:</span>
                <span class="value">@(Model.TotalPrice.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")))₫</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="action-buttons">
            <a href="/OrderHistory" class="btn-back">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <button class="btn-print" onclick="window.print()">
                <i class="bi bi-printer"></i> In đơn hàng
            </button>
            
            @{
                var daysSinceOrder = (DateTime.Now - Model.OrderDate).Days;
                var canReturn = Model.Status == "Delivered" && daysSinceOrder <= 30;
                var returnRequest = Model.ReturnRequests?.FirstOrDefault();
            }

            @if (!User.HasPermission(PermissionConstants.ReturnManage))
            {
                @if (canReturn)
                {
                    <a href="/Return/Create?orderId=@Model.Id" class="btn-return">
                        <i class="bi bi-arrow-counterclockwise"></i> Trả hàng
                    </a>
                }
                else if (Model.Status != "Delivered")
                {
                    <button class="btn-return-disabled" disabled title="Đơn hàng phải đã giao mới có thể trả">
                        <i class="bi bi-arrow-counterclockwise"></i> Trả hàng
                    </button>
                }
                else if (daysSinceOrder > 30)
                {
                    <button class="btn-return-disabled" disabled title="Quá 30 ngày, không thể trả hàng">
                        <i class="bi bi-arrow-counterclockwise"></i> Trả hàng (Hết hạn)
                    </button>
                }
            }
            else
            {
                @if (returnRequest != null)
                {
                    <a href="/Return/Details/@returnRequest.Id" class="btn-view-return">
                        <i class="bi bi-arrow-counterclockwise"></i> Xem yêu cầu trả hàng
                    </a>
                }
            }
        </div>
    </div>
</div>
