@using GAMINGSTORE.Models
@model Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<style>
    .details-container {
        max-width: 1000px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .details-header {
        margin-bottom: 30px;
    }

    .back-link {
        color: #5a7ba8;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 15px;
        display: inline-block;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .order-title {
        font-size: 28px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 10px;
    }

    .order-meta {
        display: flex;
        gap: 30px;
        color: #6b7280;
        font-size: 14px;
    }

    .items-section, .shipping-section, .payment-section {
        background: #fff;
        border: 1px solid #e0e3e8;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #eff2f7;
    }

    .items-table {
        width: 100%;
        border-collapse: collapse;
    }

    .items-table th {
        background: #f3f4f6;
        padding: 12px;
        text-align: left;
        font-weight: 700;
        color: #374151;
        font-size: 13px;
        text-transform: uppercase;
    }

    .items-table td {
        padding: 15px 12px;
        border-bottom: 1px solid #eff2f7;
        color: #4b5563;
    }

    .items-table tr:last-child td {
        border-bottom: none;
    }

    .item-name {
        font-weight: 600;
        color: #111827;
    }

    .item-price {
        text-align: right;
        font-weight: 600;
        color: #5a7ba8;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        color: #6b7280;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .info-value {
        color: #111827;
        font-size: 15px;
        font-weight: 600;
    }

    .summary-section {
        background: #f9fafb;
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 15px;
        color: #6b7280;
    }

    .summary-row.total {
        border-top: 2px solid #e0e3e8;
        padding-top: 15px;
        font-size: 18px;
        font-weight: 800;
        color: #5a7ba8;
    }

    .summary-row.total .label {
        color: #111827;
    }

    .status-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-pending { background: #fef08a; color: #854d0e; }
    .status-confirmed { background: #dbeafe; color: #1e3a8a; }
    .status-shipped { background: #e0e7ff; color: #3730a3; }
    .status-delivered { background: #dcfce7; color: #166534; }
    .status-cancelled { background: #fee2e2; color: #991b1b; }
</style>

<div class="details-container">
    <a href="@Url.Action("Index", "OrderHistory")" class="back-link">← Quay lại lịch sử đơn hàng</a>

    <div class="details-header">
        <h1 class="order-title">Đơn hàng #@Model.Id</h1>
        <div class="order-meta">
            <span>📅 @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
            <span class="status-badge status-@Model.Status?.ToLower()">
                @GetStatusDisplay(Model.Status)
            </span>
        </div>
    </div>

    <!-- Sản phẩm -->
    <div class="items-section">
        <h2 class="section-title">Sản phẩm đặt hàng</h2>
        <table class="items-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th style="text-align: center;">Số lượng</th>
                    <th style="text-align: right;">Giá</th>
                    <th style="text-align: right;">Tổng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails ?? new List<OrderDetail>())
                {
                    <tr>
                        <td class="item-name">@detail.ProductName</td>
                        <td style="text-align: center;">@detail.Quantity</td>
                        <td class="item-price">
                            @detail.Price.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN"))₫
                        </td>
                        <td class="item-price">
                            @((detail.Price * detail.Quantity).ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")))₫
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="summary-section">
            <div class="summary-row">
                <span>Tạm tính:</span>
                <span>@(Model.OrderDetails?.Sum(d => d.Price * d.Quantity).ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")) ?? "0")₫</span>
            </div>
            <div class="summary-row">
                <span>Phí vận chuyển:</span>
                <span>0₫</span>
            </div>
            <div class="summary-row total">
                <span class="label">Tổng cộng:</span>
                <span>@Model.TotalPrice.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN"))₫</span>
            </div>
        </div>
    </div>

    <!-- Thông tin giao hàng -->
    <div class="shipping-section">
        <h2 class="section-title">Thông tin giao hàng</h2>
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Người nhận</span>
                <span class="info-value">@Model.CustomerName</span>
            </div>
            <div class="info-item">
                <span class="info-label">Số điện thoại</span>
                <span class="info-value">@Model.PhoneNumber</span>
            </div>
            <div class="info-item">
                <span class="info-label">Địa chỉ giao hàng</span>
                <span class="info-value">@Model.ShippingAddress</span>
            </div>
            <div class="info-item">
                <span class="info-label">Ghi chú</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</span>
            </div>
        </div>
    </div>

    <!-- Thông tin thanh toán -->
    <div class="payment-section">
        <h2 class="section-title">Thông tin thanh toán</h2>
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Phương thức thanh toán</span>
                <span class="info-value">@Model.PaymentMethod</span>
            </div>
            <div class="info-item">
                <span class="info-label">Trạng thái thanh toán</span>
                <span class="info-value">@(Model.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")</span>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusDisplay(string status)
    {
        return status switch
        {
            "Pending" => "Chờ xác nhận",
            "Confirmed" => "Đã xác nhận",
            "Shipped" => "Đang giao",
            "Delivered" => "Đã giao",
            "Cancelled" => "Đã hủy",
            _ => status
        };
    }
}
