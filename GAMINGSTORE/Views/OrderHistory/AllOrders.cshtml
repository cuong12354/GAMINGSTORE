@model List<GAMINGSTORE.Models.Order>

@{
    ViewData["Title"] = "Lịch Sử Mua Hàng Tất Cả Khách Hàng";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="admin-header mb-4">
        <h1 class="page-title">📊 Lịch Sử Mua Hàng Tất Cả Khách Hàng</h1>
        <p class="text-muted">Quản lý tất cả đơn hàng từ khách hàng</p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>Chưa có đơn hàng nào</h3>
            <p>Hiện tại chưa có khách hàng nào thực hiện đơn hàng</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> Quay Lại Trang Chủ
            </a>
        </div>
    }
    else
    {
        <!-- Filter & Sort -->
        <div class="filter-section mb-4">
            <div class="row">
                <div class="col-md-4">
                    <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm theo tên khách hàng, email...">
                </div>
                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Pending">Chờ xử lý</option>
                        <option value="Confirmed">Đã xác nhận</option>
                        <option value="Shipped">Đang giao</option>
                        <option value="Delivered">Đã giao</option>
                        <option value="Cancelled">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="sortBy" class="form-select">
                        <option value="latest">Mới nhất</option>
                        <option value="oldest">Cũ nhất</option>
                        <option value="price_high">Giá cao nhất</option>
                        <option value="price_low">Giá thấp nhất</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="orders-table-container">
            <table class="table table-hover">
                <thead>
                    <tr class="header-row">
                        <th>ID Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Email</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th>P. Thanh Toán</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody id="ordersTableBody">
                    @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                    {
                        <tr class="order-row" data-status="@order.Status" data-customer="@order.CustomerName" data-price="@order.TotalPrice">
                            <td>
                                <span class="order-id">#@order.Id.ToString("D6")</span>
                            </td>
                            <td>
                                <strong>@(order.CustomerName ?? "N/A")</strong>
                            </td>
                            <td>
                                <small class="text-muted">@(order.ApplicationUser?.Email ?? "N/A")</small>
                            </td>
                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="price-badge">
                                    @(order.TotalPrice.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")))₫
                                </span>
                            </td>
                            <td>
                                <span class="status-badge status-@order.Status?.ToLower()">
                                    @GetStatusDisplay(order.Status ?? "Pending")
                                </span>
                            </td>
                            <td>
                                <small>@(order.PaymentMethod ?? "N/A")</small>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", "OrderHistory", new { id = order.Id })" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Xem Chi Tiết
                                </a>
                                <button class="btn btn-sm btn-secondary" onclick="updateStatusModal(@order.Id)">
                                    <i class="fas fa-edit"></i> Cập Nhật
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Stats -->
        <div class="stats-section mt-5">
            <div class="row">
                <div class="col-md-3">
                    <div class="stat-card">
                        <h3>@Model.Count</h3>
                        <p>Tổng Đơn Hàng</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <h3>@Model.Where(o => o.Status == "Pending").Count()</h3>
                        <p>Chờ Xử Lý</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <h3>@Model.Where(o => o.Status == "Delivered").Count()</h3>
                        <p>Đã Giao</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <h3>@Model.Sum(o => o.TotalPrice).ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN"))₫</h3>
                        <p>Doanh Thu</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập Nhật Trạng Thái Đơn Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Trạng Thái Mới</label>
                    <select id="newStatus" class="form-select">
                        <option value="Pending">Chờ xử lý</option>
                        <option value="Confirmed">Đã xác nhận</option>
                        <option value="Shipped">Đang giao</option>
                        <option value="Delivered">Đã giao</option>
                        <option value="Cancelled">Đã hủy</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="confirmUpdateStatus()">Cập Nhật</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-header {
        border-bottom: 2px solid #8fa3c0;
        padding-bottom: 20px;
    }

    .page-title {
        color: #5a7ba8;
        font-weight: 600;
        font-size: 2rem;
    }

    .filter-section {
        background: #f8fafb;
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid #8fa3c0;
        box-shadow: 0 1px 2px rgba(91, 122, 168, 0.05);
    }

    .orders-table-container {
        background: #f8fafb;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(91, 122, 168, 0.05);
    }

    .table {
        margin-bottom: 0;
    }

    .header-row {
        background-color: #eff2f7;
        color: var(--text-primary);
        font-weight: 600;
        border-bottom: 1px solid #e0e3e8;
    }

    .header-row th {
        padding: 16px;
        font-size: 14px;
    }

    .order-row {
        border-bottom: 1px solid #e0e3e8;
        transition: all 0.2s ease;
    }

    .order-row:hover {
        background-color: #f1f3f7;
    }

    .order-id {
        color: #5a7ba8;
        font-weight: 600;
        font-family: 'Monaco', 'Courier New', monospace;
    }

    .price-badge {
        background-color: #6b8fb8;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-block;
        min-width: 100px;
        text-align: center;
    }

    .status-pending {
        background-color: #fef3c7;
        color: #92400e;
    }

    .status-confirmed {
        background-color: #dbeafe;
        color: #0c4a6e;
    }

    .status-shipped {
        background-color: #e9d5ff;
        color: #581c87;
    }

    .status-delivered {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-cancelled {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .stat-card {
        background: linear-gradient(135deg, #6b8fb8 0%, #5a7ba8 100%);
        color: white;
        padding: 25px;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(91, 122, 168, 0.1);
    }

    .stat-card h3 {
        font-size: 2rem;
        margin-bottom: 10px;
        font-weight: 700;
    }

    .stat-card p {
        margin: 0;
        font-size: 0.95rem;
        opacity: 0.95;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: #f1f3f7;
        border-radius: 8px;
        color: var(--text-secondary);
    }

    .empty-state i {
        font-size: 3rem;
        color: #8fa3c0;
        margin-bottom: 20px;
        opacity: 0.4;
    }

    .btn-info {
        background-color: #6b8fb8;
        border: none;
        color: white;
    }

    .btn-info:hover {
        background-color: #5a7ba8;
        color: white;
    }

    .form-select, .form-control {
        background-color: white;
        color: var(--text-primary);
        border: 1px solid #e0e3e8;
    }

    .form-select:focus, .form-control:focus {
        border-color: #8fa3c0;
        box-shadow: 0 0 0 3px rgba(107, 143, 184, 0.05);
    }

    .form-select option {
        background-color: white;
        color: var(--text-primary);
    }

    .form-control::placeholder {
        color: var(--text-muted);
    }
</style>

<script>
    let currentOrderId = null;

    function updateStatusModal(orderId) {
        currentOrderId = orderId;
        const modal = new bootstrap.Modal(document.getElementById('updateStatusModal'));
        modal.show();
    }

    async function confirmUpdateStatus() {
        const newStatus = document.getElementById('newStatus').value;

        if (!currentOrderId || !newStatus) {
            alert('Vui lòng chọn trạng thái');
            return;
        }

        try {
            const response = await fetch(`/OrderHistory/UpdateStatus?id=${currentOrderId}&status=${newStatus}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            const data = await response.json();

            if (response.ok) {
                alert('✅ Cập nhật trạng thái thành công!');
                location.reload();
            } else {
                alert('❌ ' + (data.message || 'Lỗi cập nhật'));
            }
        } catch (error) {
            alert('❌ Lỗi: ' + error.message);
        }
    }

    // Search & Filter
    document.getElementById('searchInput')?.addEventListener('keyup', function () {
        const searchTerm = this.value.toLowerCase();
        const statusFilter = document.getElementById('statusFilter').value;

        document.querySelectorAll('.order-row').forEach(row => {
            const customerName = row.dataset.customer.toLowerCase();
            const status = row.dataset.status;
            const isVisible = customerName.includes(searchTerm) && (!statusFilter || status === statusFilter);
            row.style.display = isVisible ? '' : 'none';
        });
    });

    document.getElementById('statusFilter')?.addEventListener('change', function () {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const statusFilter = this.value;

        document.querySelectorAll('.order-row').forEach(row => {
            const customerName = row.dataset.customer.toLowerCase();
            const status = row.dataset.status;
            const isVisible = customerName.includes(searchTerm) && (!statusFilter || status === statusFilter);
            row.style.display = isVisible ? '' : 'none';
        });
    });
</script>

@functions {
    private string GetStatusDisplay(string status)
    {
        return status switch
        {
            "Pending" => "Chờ xử lý",
            "Confirmed" => "Đã xác nhận",
            "Shipped" => "Đang giao",
            "Delivered" => "Đã giao",
            "Cancelled" => "Đã hủy",
            _ => "Không xác định"
        };
    }
}
