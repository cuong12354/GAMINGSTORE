@model List<Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<style>
    .order-history-container {
        padding: 40px 0;
    }

    .order-header {
        background: linear-gradient(135deg, #6b8fb8 0%, #5a7ba8 100%);
        color: white;
        padding: 40px 30px;
        border-radius: 12px;
        margin-bottom: 40px;
        box-shadow: 0 2px 8px rgba(91, 122, 168, 0.1);
    }

    .order-header h1 {
        font-size: 32px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .order-header p {
        font-size: 16px;
        margin: 0;
        opacity: 0.95;
    }

    .orders-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    .order-card {
        background: #f8fafb;
        border: 1px solid #e0e3e8;
        border-radius: 8px;
        padding: 24px;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(91, 122, 168, 0.05);
    }

    .order-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: #8fa3c0;
    }

    .order-card:hover {
        border-color: #8fa3c0;
        box-shadow: 0 4px 12px rgba(91, 122, 168, 0.08);
        transform: translateY(-2px);
    }

    .order-number {
        color: #5a7ba8;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .order-id {
        color: var(--text-primary);
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .order-date {
        color: var(--text-secondary);
        font-size: 14px;
        margin-bottom: 16px;
    }

    .order-status {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .status-pending { background-color: #fef3c7; color: #92400e; }
    .status-confirmed { background-color: #dbeafe; color: #0c4a6e; }
    .status-shipped { background-color: #e9d5ff; color: #581c87; }
    .status-delivered { background-color: #dcfce7; color: #166534; }
    .status-cancelled { background-color: #fee2e2; color: #991b1b; }

    .order-price {
        color: #5a7ba8;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .order-items-count {
        color: var(--text-secondary);
        font-size: 14px;
        margin-bottom: 16px;
    }

    .order-action {
        display: flex;
        gap: 10px;
    }

    .btn-view {
        flex: 1;
        background-color: #6b8fb8;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 14px;
    }

    .btn-view:hover {
        background-color: #5a7ba8;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(91, 122, 168, 0.12);
    }

    .empty-state {
        text-align: center;
        padding: 80px 30px;
        background: var(--gray-50);
        border: 2px dashed var(--border-color);
        border-radius: 12px;
    }

    .empty-state i {
        font-size: 64px;
        color: #8fa3c0;
        margin-bottom: 20px;
        display: block;
        opacity: 0.4;
    }

    .empty-state h3 {
        color: var(--text-primary);
        font-size: 24px;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: var(--text-secondary);
        margin-bottom: 30px;
    }

    .empty-state a {
        background-color: #6b8fb8;
        color: white;
        padding: 12px 32px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        transition: all 0.2s ease;
    }

    .empty-state a:hover {
        background-color: #5a7ba8;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(91, 122, 168, 0.12);
    }

    .progress-bar-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
    }

    .progress-step {
        flex: 1;
        height: 3px;
        background-color: var(--border-color);
        border-radius: 2px;
        position: relative;
    }

    .progress-step.active {
        background-color: var(--primary-blue);
    }

    .return-status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: bold;
        text-transform: uppercase;
        margin-left: 8px;
    }

    .return-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .return-approved {
        background-color: #d4edda;
        color: #155724;
    }

    .return-rejected {
        background-color: #f8d7da;
        color: #721c24;
    }

    .return-completed {
        background-color: #d1ecf1;
        color: #0c5460;
    }
</style>

<div class="order-history-container">
    <div class="container">
        <!-- Header -->
        <div class="order-header">
            <h1><i class="bi bi-bag-check"></i> Lịch sử đơn hàng</h1>
            <p style="color: black;">Xem chi tiết và theo dõi tiến độ của các đơn hàng của bạn</p>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <p class="text-muted mb-4">Tổng cộng: <strong>@Model.Count</strong> đơn hàng</p>

            <div class="orders-grid">
                @foreach (var order in Model)
                {
                    var statusClass = $"status-{order.Status?.ToLower() ?? "pending"}";
                    var statusDisplay = order.Status switch
                    {
                        "Pending" => "Chờ xử lý",
                        "Confirmed" => "Đã xác nhận",
                        "Shipped" => "Đang giao",
                        "Delivered" => "Đã giao",
                        "Cancelled" => "Đã hủy",
                        _ => order.Status
                    };

                    <div class="order-card" onclick="window.location='/OrderHistory/Details/@order.Id'">
                        <div class="order-number">
                            <i class="bi bi-hash"></i> Đơn hàng
                        </div>
                        <div class="order-id">#@order.Id</div>
                        <div class="order-date">
                            <i class="bi bi-calendar3"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        <div>
                            <div class="order-status @statusClass">@statusDisplay</div>
                            @{
                                var returnRequest = order.ReturnRequests?.FirstOrDefault();
                                if (returnRequest != null)
                                {
                                    var returnStatusClass = $"return-{returnRequest.Status?.ToLower() ?? "pending"}";
                                    var returnStatusDisplay = returnRequest.Status switch
                                    {
                                        "Pending" => "⏳ Đang xem xét",
                                        "Approved" => "✅ Đã phê duyệt",
                                        "Rejected" => "❌ Từ chối",
                                        "Completed" => "✔️ Hoàn tất",
                                        _ => returnRequest.Status
                                    };
                                    <span class="return-status-badge @returnStatusClass">@returnStatusDisplay</span>
                                }
                            }
                        </div>

                        <div class="order-price">@(order.TotalPrice.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN")))₫</div>
                        <div class="order-items-count">
                            <i class="bi bi-box-seam"></i> @(order.OrderDetails?.Count ?? 0) sản phẩm
                        </div>

                        <div class="progress-bar-container">
                            <div class="progress-step @(new[] { "Pending" }.Contains(order.Status) ? "active" : "")"></div>
                            <div class="progress-step @(new[] { "Pending", "Confirmed" }.Contains(order.Status) ? "active" : "")"></div>
                            <div class="progress-step @(new[] { "Pending", "Confirmed", "Shipped" }.Contains(order.Status) ? "active" : "")"></div>
                            <div class="progress-step @(order.Status == "Delivered" ? "active" : "")"></div>
                        </div>

                        <div class="order-action mt-3">
                            <button class="btn-view" onclick="event.stopPropagation(); window.location='/OrderHistory/Details/@order.Id'">
                                <i class="bi bi-arrow-right"></i> Xem chi tiết
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h3>Chưa có đơn hàng nào</h3>
                <p>Bạn chưa đặt bất kỳ đơn hàng nào. Hãy bắt đầu mua sắm ngay!</p>
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-shop"></i> Tiếp tục mua sắm
                </a>
            </div>
        }
    </div>
</div>
