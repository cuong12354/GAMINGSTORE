@using GAMINGSTORE.Models
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<style>
    .order-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .order-header {
        margin-bottom: 30px;
    }

    .order-header h1 {
        color: #111827;
        font-weight: 800;
        font-size: 32px;
        margin-bottom: 10px;
    }

    .order-header p {
        color: #6b7280;
        font-size: 16px;
    }

    .filter-section {
        margin-bottom: 25px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 10px 20px;
        border: 2px solid #e0e3e8;
        background: #fff;
        border-radius: 8px;
        color: #6b7280;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
    }

    .filter-btn:hover, .filter-btn.active {
        border-color: #5a7ba8;
        background: #5a7ba8;
        color: #fff;
    }

    .order-card {
        background: #fff;
        border: 1px solid #e0e3e8;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.3s;
    }

    .order-card:hover {
        box-shadow: 0 8px 16px rgba(90, 123, 168, 0.1);
        border-color: #5a7ba8;
    }

    .order-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eff2f7;
    }

    .order-id {
        font-weight: 700;
        color: #111827;
        font-size: 16px;
    }

    .order-date {
        color: #9ca3af;
        font-size: 14px;
    }

    .order-status {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-pending { background: #fef08a; color: #854d0e; }
    .status-confirmed { background: #dbeafe; color: #1e3a8a; }
    .status-shipped { background: #e0e7ff; color: #3730a3; }
    .status-delivered { background: #dcfce7; color: #166534; }
    .status-cancelled { background: #fee2e2; color: #991b1b; }

    .order-card-body {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        margin-bottom: 15px;
    }

    .order-info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        color: #9ca3af;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .info-value {
        color: #111827;
        font-size: 16px;
        font-weight: 600;
    }

    .order-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 15px;
        border-top: 1px solid #eff2f7;
    }

    .order-total {
        font-size: 18px;
        font-weight: 800;
        color: #5a7ba8;
    }

    .view-details-btn {
        padding: 10px 20px;
        background: #5a7ba8;
        color: #fff;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }

    .view-details-btn:hover {
        background: #4a6a98;
        transform: translateY(-2px);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state-icon {
        font-size: 60px;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .empty-state-text {
        color: #6b7280;
        font-size: 16px;
        margin-bottom: 20px;
    }
</style>

<div class="order-container">
    <div class="order-header">
        <h1>Đơn hàng của bạn</h1>
        <p>Quản lý và theo dõi trạng thái các đơn hàng của bạn</p>
    </div>

    <div class="filter-section">
        <a href="@Url.Action("Index", "OrderHistory")" class="filter-btn @(ViewData["CurrentStatus"] == null ? "active" : "")">
            Tất cả
        </a>
        @foreach (var st in (string[])ViewData["StatusFilter"])
        {
            var isActive = ViewData["CurrentStatus"]?.ToString() == st;
            <a href="@Url.Action("Index", "OrderHistory", new { status = st })" 
               class="filter-btn @(isActive ? "active" : "")">
                @GetStatusDisplay(st)
            </a>
        }
    </div>

    @if (Model.Any())
    {
        @foreach (var order in Model)
        {
            <div class="order-card">
                <div class="order-card-header">
                    <div>
                        <div class="order-id">Đơn hàng #@order.Id</div>
                        <div class="order-date">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <span class="order-status status-@order.Status?.ToLower()">
                        @GetStatusDisplay(order.Status)
                    </span>
                </div>

                <div class="order-card-body">
                    <div class="order-info-item">
                        <span class="info-label">Địa chỉ giao hàng</span>
                        <span class="info-value">@order.ShippingAddress</span>
                    </div>
                    <div class="order-info-item">
                        <span class="info-label">Số điện thoại</span>
                        <span class="info-value">@order.PhoneNumber</span>
                    </div>
                    <div class="order-info-item">
                        <span class="info-label">Số lượng sản phẩm</span>
                        <span class="info-value">@order.OrderDetails?.Count() item</span>
                    </div>
                    <div class="order-info-item">
                        <span class="info-label">Phương thức thanh toán</span>
                        <span class="info-value">@order.PaymentMethod</span>
                    </div>
                </div>

                <div class="order-card-footer">
                    <div class="order-total">
                        @order.TotalPrice.ToString("N0", System.Globalization.CultureInfo.CreateSpecificCulture("vi-VN"))₫
                    </div>
                    <a asp-action="Details" asp-route-id="@order.Id" class="view-details-btn">
                        Xem chi tiết
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">📦</div>
            <div class="empty-state-text">Bạn chưa có đơn hàng nào</div>
            <a asp-controller="Product" asp-action="Index" class="view-details-btn" style="display: inline-block;">
                Tiếp tục mua sắm
            </a>
        </div>
    }
</div>

@functions {
    private string GetStatusDisplay(string status)
    {
        return status switch
        {
            "Pending" => "Chờ xác nhận",
            "Confirmed" => "Đã xác nhận",
            "Shipped" => "Đang giao",
            "Delivered" => "Đã giao",
            "Cancelled" => "Đã hủy",
            _ => status
        };
    }
}
